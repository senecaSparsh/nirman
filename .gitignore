onboarding-queue.txt

# Sentry build artifacts
.sentry/
.env.prod-secrets

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
.codebase-memory/

# Serena semantic-index cache (regenerated per machine)
.serena/
.ua/
.understand-anything/

# Stryker mutation testing artifacts (package-level only; app dirs named reports/ are source)
.stryker-tmp/
packages/*/reports/
**/probe/*.jsonl
