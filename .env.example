# ──────────────────────────────────────────────────────────────────────
# Nirman Inventory OS — Environment Variables
# ──────────────────────────────────────────────────────────────────────
# Copy this file to .env for local dev. For Coolify/VPS production, set
# these in Coolify → your service → Environment Variables (see
# docs/COOLIFY_DEPLOY.md — NEXT_PUBLIC_APP_URL also goes in Build Args).
#
# REQUIRED (app won't start without these):
#   DATABASE_URL, NEXT_PUBLIC_APP_URL, BETTER_AUTH_URL, BETTER_AUTH_SECRET
#
# REQUIRED IN PRODUCTION (compose/cron wiring depends on them):
#   POSTGRES_PASSWORD, CRON_SECRET, SCHEDULER_SECRET
# ──────────────────────────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Local:   postgresql://user@localhost:5432/nirman_inventory?schema=public
# Coolify: auto-wired by docker-compose.prod.yml (points at the db service).
# Render:  automatically set from the database service.
DATABASE_URL="postgresql://user@localhost:5432/nirman_inventory?schema=public"

# Non-pooled connection for Prisma migrations (prisma migrate deploy).
# Coolify: auto-wired (same DB, no pooler). Local dev can leave unset —
# migrate-deploy.mjs falls back to DATABASE_URL.
# DIRECT_URL="postgresql://user@localhost:5432/nirman_inventory"

# Public URL of the deployed app (no trailing slash).
# In production this must be a build arg too — it gets inlined into the
# client bundle at build time.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-side URL for Better-Auth (cookie domain, callbacks).
# MUST match NEXT_PUBLIC_APP_URL.
BETTER_AUTH_URL="http://localhost:3000"

# Secret key for signing auth sessions (Better-Auth).
# Generate one: openssl rand -base64 32
BETTER_AUTH_SECRET="dev-secret-change-me-9f3a7c2e1b8d4a6f0c5e3b2a1d9f7c8e"

# ── REQUIRED IN PRODUCTION (Coolify) ─────────────────────────────────

# Postgres container credentials — used by docker-compose.prod.yml to
# build DATABASE_URL and initialize the db service.
# POSTGRES_PASSWORD has a weak default (changeme_please) — SET A REAL ONE.
# NOTE: POSTGRES_PASSWORD only applies on FIRST db init. Changing it on an
# existing volume does NOT rotate the database password.
POSTGRES_DB="nirman_inventory"
POSTGRES_USER="nirman"
# POSTGRES_PASSWORD="generate-a-strong-password"

# Secret for /api/cron/* endpoints (backup, reminders, hsn-seed).
# The scheduler sidecar calls these every 15min/daily/weekly — without
# this, reminders and backups silently 401.
# Generate: openssl rand -base64 32
# CRON_SECRET="generate-a-random-string"

# Secret for /api/workflow-scheduler (due scheduled workflows, every 5 min).
# SCHEDULER_SECRET="generate-a-random-string"

# Passphrase used to derive the AES-256-GCM key that encrypts integration
# secrets at rest (Tally, WhatsApp, SMTP, portal credentials). REQUIRED in
# production if any integration is used — saving an integration fails without
# it. Generate: openssl rand -hex 32
# ⚠️ BACK THIS UP: losing/rotating it makes all stored integration secrets
# undecryptable — every integration credential must then be re-entered.
# INTEGRATION_ENCRYPTION_KEY="generate-64-hex-chars"

# ── OPTIONAL ──────────────────────────────────────────────────────────

# Password for demo users created by the seed (local dev only — the demo
# seed is hard-blocked in production). Defaults to "nirman123".
SEED_PASSWORD="nirman123"

# NEVER set this in production — the demo seed wipes transactional data.
# The docker entrypoint ignores it in prod and logs a warning.
# SEED_DEMO_DATA="false"

# Sentry error tracking (optional — leave unset to disable, zero overhead).
# Server-side and client-side DSNs; the client one also needs to be a
# Coolify build arg to be inlined.
# SENTRY_DSN="https://...@sentry.io/..."
# NEXT_PUBLIC_SENTRY_DSN="https://...@sentry.io/..."

# Web push notifications (optional — push disabled without these).
# Generate a pair: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY="..."
# VAPID_PRIVATE_KEY="..."
# VAPID_SUBJECT="mailto:admin@yourcompany.com"

# Twilio SMS/call integration (optional — telephony disabled without it).
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."

# Tally ERP integration (optional — app works without it).
# The URL where Tally's HTTP API is running (usually localhost:9000).
# TALLY_BASE_URL="http://localhost:9000"

# WhatsApp Business Cloud API (optional — in-app notifications always work;
# WhatsApp delivery activates when both are set).
# WHATSAPP_ACCESS_TOKEN="EAAG..."
# WHATSAPP_PHONE_NUMBER_ID="1234567890"

# Customer portal session signing. Falls back to NEXTAUTH_SECRET →
# BETTER_AUTH_SECRET — set this explicitly if portal and staff sessions
# must have independent revocation.
# PORTAL_COOKIE_SECRET="generate-a-random-string"
# NEXTAUTH_SECRET="generate-a-random-string"   # legacy alias, kept for compat

# Real-estate portal syndication providers (optional — listings stay local
# without keys). One pair per provider: API key + base URL.
# PORTAL_99ACRES_API_KEY="..." / PORTAL_99ACRES_BASE_URL="https://..."
# PORTAL_HOUSING_API_KEY="..." / PORTAL_HOUSING_BASE_URL="https://..."
# PORTAL_MAGICBRICKS_API_KEY="..." / PORTAL_MAGICBRICKS_BASE_URL="https://..."

# Upload storage dir — default ./storage/uploads inside the app. Docker
# compose sets this to the mounted volume path; do NOT change it there.
# UPLOAD_DIR="/app/storage/uploads"

# gstaccelerator.in API key for HSN/GST master auto-sync.
# Optional — if set, the system auto-fetches HSN rates from the API for codes
# not in the bundled database, and enriches the weekly auto-sync.
# Get a free key at https://gstaccelerator.in/dashboard
# GSTA_API_KEY="gsta_live_..."

# Heap size override — normally leave UNSET. The start wrapper auto-detects
# available RAM (cgroup limits) and sets --max-old-space-size.
# NODE_OPTIONS=""

# ── DEV ONLY ──────────────────────────────────────────────────────────

# Skip Better-Auth and use a synthetic dev user (DEV ONLY).
# Automatically disabled in production (NODE_ENV=production) — env
# validation also warns if this is set in prod.
# AUTH_BYPASS="true"
