# ──────────────────────────────────────────────────────────────────────
# Nirman Inventory OS — Environment Variables
# ──────────────────────────────────────────────────────────────────────
# Copy this file to .env for local dev, or set these in your hosting
# provider's dashboard (Render, Railway, Vercel, etc.) for production.
#
# REQUIRED (app won't start without these):
#   DATABASE_URL
#   NEXT_PUBLIC_APP_URL
#   BETTER_AUTH_SECRET
#
# OPTIONAL (features that need extra config):
#   SEED_PASSWORD
#   TALLY_BASE_URL
#   SCHEDULER_SECRET
# ──────────────────────────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Local:  postgresql://user@localhost:5432/nirman_inventory?schema=public
# Render: automatically set from the database service
DATABASE_URL="postgresql://user@localhost:5432/nirman_inventory?schema=public"

# Public URL of the deployed app (no trailing slash).
# Used by Better-Auth client for API calls and by the auth server for cookies.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-side URL for Better-Auth (cookie domain, callbacks).
# Usually the same as NEXT_PUBLIC_APP_URL.
BETTER_AUTH_URL="http://localhost:3000"

# Secret key for signing auth sessions (Better-Auth).
# Generate one: openssl rand -hex 32
BETTER_AUTH_SECRET="dev-secret-change-me-9f3a7c2e1b8d4a6f0c5e3b2a1d9f7c8e"

# ── OPTIONAL ──────────────────────────────────────────────────────────

# Password for demo users created by the seed.
# If not set, defaults to "nirman123".
# For production, set this to a strong password.
SEED_PASSWORD="nirman123"

# Tally ERP integration (optional — app works without it).
# The URL where Tally's HTTP API is running (usually localhost:9000).
# TALLY_BASE_URL="http://localhost:9000"

# Secret for the cron scheduler endpoint (optional).
# Protects /api/cron/* endpoints from unauthenticated access.
# SCHEDULER_SECRET="some-random-string"

# ── DEV ONLY ──────────────────────────────────────────────────────────

# Skip Better-Auth and use a synthetic dev user (DEV ONLY).
# Automatically disabled in production (NODE_ENV=production).
# AUTH_BYPASS="true"
