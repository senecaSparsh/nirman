{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^generate", "^build"],
      "env": [
        "NEXT_PUBLIC_APP_URL",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_SECRET",
        "AUTH_BYPASS",
        "NEXT_PUBLIC_AUTH_BYPASS",
        "DATABASE_URL"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^generate"]
    },
    "typecheck": {
      "dependsOn": ["^generate"]
    },
    "test": {
      "dependsOn": ["^generate"]
    },
    "generate": {
      "cache": true,
      "inputs": ["prisma/schema.prisma", "prisma/**/*.prisma"],
      "outputs": ["src/generated/**"]
    }
  }
}
