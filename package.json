{
  "name": "nirman-inventory",
  "private": true,
  "version": "0.1.0",
  "description": "Construction + Real Estate inventory management OS",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:clean": "pnpm --filter web dev:clean",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @nirman/db generate",
    "db:push": "pnpm --filter @nirman/db push",
    "db:push:force": "pnpm --filter @nirman/db push:force",
    "db:migrate": "pnpm --filter @nirman/db migrate",
    "db:studio": "pnpm --filter @nirman/db studio",
    "postinstall": "pnpm --filter @nirman/db generate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "npx eslint --fix --max-warnings=0"
    ],
    "*.{json,md,css}": [
      "npx prettier --write"
    ]
  }
}
