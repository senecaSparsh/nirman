# Database (matches docker-compose.yml).
# connection_limit caps the Prisma pool (default = num_cpus*2+1).
# pool_timeout is the seconds to wait for a connection before erroring.
# On Render free Postgres (20 conns) use connection_limit=5.
# DIRECT_URL is a non-pooled connection used only by `prisma migrate deploy`.
DATABASE_URL="postgresql://nirman:nirman@localhost:5433/nirman_inventory?schema=public&connection_limit=5&pool_timeout=10"
DIRECT_URL="postgresql://nirman:nirman@localhost:5433/nirman_inventory?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_SECRET="change-me-in-production-use-a-long-random-string"

# Dev-only auth bypass (headless local dev without Better-Auth sign-in).
# AUTH_BYPASS is read server-side (getSession() returns a synthetic dev user);
# NEXT_PUBLIC_AUTH_BYPASS is read client-side by the mobile shells' auth guard
# so /m/* routes don't redirect to /sign-in in dev-bypass mode.
# Never set either in production.
# AUTH_BYPASS=true
# NEXT_PUBLIC_AUTH_BYPASS=true
