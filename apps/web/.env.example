# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://nirman:nirman@localhost:5433/nirman_inventory?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_SECRET="change-me-in-production-use-a-long-random-string"

# Dev-only auth bypass (headless local dev without Better-Auth sign-in).
# AUTH_BYPASS is read server-side (getSession() returns a synthetic dev user);
# NEXT_PUBLIC_AUTH_BYPASS is read client-side by the mobile shells' auth guard
# so /m/* routes don't redirect to /sign-in in dev-bypass mode.
# Never set either in production.
# AUTH_BYPASS=true
# NEXT_PUBLIC_AUTH_BYPASS=true
