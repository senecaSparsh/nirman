// Nirman Inventory OS — Prisma schema
// Construction + Real Estate inventory management.
// Two inventory universes: Materials (inputs) + Assets (outputs: land + built units).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────────────────
//  CORE: Company, Users, Auth, Projects
// ───────────────────────────────────────────────────────────

model Company {
  id        String   @id @default(cuid())
  name      String
  gstin     String?
  pan       String?
  address   String?
  // Contact details — shown on printed bills, invoices, and receipts.
  phone     String?
  email     String?
  currency  String   @default("INR")
  // Free-text business line, e.g. "Rice Milling & Export", "Real Estate" —
  // purely descriptive, shown in the company switcher to disambiguate.
  businessType String?
  // Self-relation so a user's companies can be organized into a group
  // hierarchy (e.g. "ABP Group" as parent, "Testify Overseas" +
  // "ABP Realty" as children) — matches the Admin -> Sub-admin whiteboard
  // structure at the company/entity level rather than the user-role level.
  parentCompanyId String?
  parent          Company?  @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id])
  children        Company[] @relation("CompanyHierarchy")
  // Logistics Complexity Index (LCI) — procurement routing config. See procurement-routing.ts.
  lciThresholdDefault Decimal? @db.Decimal(5, 2) // default LCI threshold for projects without an explicit override
  lciWeights          Json?    // { w1, w2, w3, w4 } normalized weighting coefficients
  // Value-based PO approval routing thresholds (in INR). POs below the manager
  // threshold can be approved by a MANAGER; below the admin threshold require
  // an ADMIN; at or above the admin threshold require the OWNER.
  poApprovalThresholdManager Decimal? @db.Decimal(14, 2) // default 50,000
  poApprovalThresholdAdmin   Decimal? @db.Decimal(14, 2) // default 500,000
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  projects      Project[]
  stockLocations StockLocation[]
  purchaseOrders PurchaseOrder[]
  landPurchases  LandPurchase[]
  landSellers    LandSeller[]
  assetSales     AssetSale[]
  materialSales  MaterialSale[]
  changeOrders   ChangeOrder[]
  ncrs           NonConformanceReport[]
  capas          Capa[]
  safetyIncidents SafetyIncident[]
  safetyHazards   SafetyHazard[]
  safetyInspections SafetyInspection[]
  renovations    RenovationProject[]
  expenses       Expense[]
  equipment      Equipment[]
  supplierReturns SupplierReturn[]
  employees      Employee[]
  departments    Department[]
  crews          Crew[]
  payrollPeriods PayrollPeriod[]
  dailyProgressReports DailyProgressReport[]
  attendances    WorkerAttendance[]
  userMemberships UserCompany[]
  users          User[]
  leaveRequests  LeaveRequest[]
  tenancies      Tenancy[]
  dailyReports   DailyReport[]
  directPurchases DirectPurchase[]
  scrapGenerations ScrapGeneration[]
  standardConsumptions StandardConsumption[]
  tallySyncLogs        TallySyncLog[]
  notificationTemplates NotificationTemplate[]
  notificationLogs      NotificationLog[]
  notificationPreferences NotificationPreference[]
  inAppNotifications   InAppNotification[]
  portalListings        PortalListing[]
  subcontractorWorkOrders SubcontractorWorkOrder[]
  raBills                RaBill[]
  rateContracts          RateContract[]
  supplierPayments       SupplierPayment[]
  supplierInvoices       SupplierInvoice[]
  materialLots           MaterialLot[]
  auditLogs              AuditLog[]
  suppliers              Supplier[]
  subcontractors         Subcontractor[]
  customers              Customer[]
  leads                  Lead[]
  integrationConfigs     IntegrationConfig[]
  quotationRequests      QuotationRequest[]
  vehicles               Vehicle[]
  vehicleTrips           VehicleTrip[]
  gatePasses             GatePass[]
  legalDocuments         LegalDocument[]
  brokers                Broker[]

  @@index([parentCompanyId])
}

// ───────────────────────────────────────────────────────────
//  MULTI-COMPANY MEMBERSHIP — a user can belong to one or more
//  companies, with a role scoped per membership. The User.role
//  column remains the default role (used when only one company
//  exists or as a fallback); UserCompany.role takes precedence
//  when the user is operating within that company's scope.
// ───────────────────────────────────────────────────────────
model UserCompany {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      String   @default("MANAGER") // OWNER | ADMIN | MANAGER | SUPERVISOR | SALES | ACCOUNTANT
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Hierarchical RBAC (Admin → Sub-Admin → Sub-Sub-Admin) ──
  // The architecture's multi-tier delegation hierarchy. The reporting line
  // is per-membership: a Sub-Sub-Admin (SUPERVISOR) in company X reports to a
  // Sub-Admin (MANAGER) in the same company, who may themselves report up to
  // an Admin (OWNER/ADMIN). Null = top of the chain for this company.
  reportsToUserCompanyId String?

  // Scope type bounds what this membership can see within the company:
  //   COMPANY    = unscoped (sees everything in the company) — OWNER/ADMIN
  //   DEPARTMENT = scoped to the departments listed in UserScope — Sub-Admin
  //   PROJECT    = scoped to the projects listed in UserScope — Sub-Sub-Admin
  // When null, defaults by role: OWNER/ADMIN → COMPANY, MANAGER → COMPANY
  // (regional heads set DEPARTMENT explicitly), SUPERVISOR → PROJECT.
  scopeType String? // COMPANY | DEPARTMENT | PROJECT

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reportsTo   UserCompany? @relation("UserCompanyReportsTo", fields: [reportsToUserCompanyId], references: [id], onDelete: SetNull)
  directReports UserCompany[] @relation("UserCompanyReportsTo")
  scopes      UserScope[]

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([reportsToUserCompanyId])
}

// One or more scope entries per UserCompany membership. A Sub-Admin
// (scopeType=DEPARTMENT) managing departments A and B has two rows; a
// Sub-Sub-Admin (scopeType=PROJECT) on sites P1 and P2 has two rows.
// scopeType=COMPANY memberships have no rows (unscoped = everything).
model UserScope {
  id              String   @id @default(cuid())
  userCompanyId   String
  // The kind of entity this scope row bounds. Must match the parent
  // membership's scopeType (enforced in the service layer).
  scopeKind       String   // DEPARTMENT | PROJECT
  departmentId    String?
  projectId       String?
  createdAt       DateTime @default(now())

  userCompany UserCompany @relation(fields: [userCompanyId], references: [id], onDelete: Cascade)
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userCompanyId])
  @@index([departmentId])
  @@index([projectId])
}

// Fine-grained permission overrides per role (additive to the
// default role matrix in roles.ts). A row grants a permission
// to a role even if the matrix doesn't include it. Used for
// customizing roles without code changes.
model RolePermission {
  id          String @id @default(cuid())
  role        String // OWNER | ADMIN | MANAGER | SUPERVISOR | SALES | ACCOUNTANT
  permission  String // e.g. "po.approve", "inventory.view"
  createdAt   DateTime @default(now())

  @@unique([role, permission])
  @@index([role])
}

// ───────────────────────────────────────────────────────────
//  Employees / workers — site labour and subcontracted crews.
//  Separate from the auth User model: tracks site labour with
//  their trade, wage structure, crew, and active project. Powers
//  the HR module (attendance, payroll, DPR labor lines).
// ───────────────────────────────────────────────────────────
enum WageType {
  DAILY    // paid per day worked (dailyRate × daysWorked)
  MONTHLY  // fixed monthly salary (monthlySalary)
  FIXED    // piece-rate / fixed contract amount (monthlySalary as the agreed amount)
}

model Employee {
  id        String   @id @default(cuid())
  name      String
  trade     String?  // e.g. "Masonry", "Electrical", "Plumbing", "Supervisor"
  phone     String?
  email     String?
  dailyRate Decimal  @db.Decimal(14,2) @default(0)
  // Wage structure — drives payroll computation (see hr.ts).
  wageType       WageType @default(DAILY)
  monthlySalary  Decimal? @db.Decimal(14,2) // set when wageType = MONTHLY/FIXED
  designation    String?  // e.g. "Site Engineer", "Lead Mason", "Helper"
  joinDate       DateTime?
  crewId         String?  // crew membership (a worker belongs to one crew)
  activeProjectId String? // current project assignment (for attendance + DPR scoping)
  active    Boolean  @default(true)
  companyId String
  userId    String?  // link to auth User — lets site workers log in (self-service attendance, DPR, tasks)
  company   Company  @relation(fields: [companyId], references: [id])
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Optimistic locking — see Material.version comment
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  crew            Crew?              @relation("CrewMembers", fields: [crewId], references: [id], onDelete: SetNull)
  activeProject   Project?           @relation("EmployeeActiveProject", fields: [activeProjectId], references: [id], onDelete: SetNull)
  supervisedCrews Crew[]             @relation("CrewSupervisor")
  attendances     WorkerAttendance[]
  payrollLines    PayrollLine[]
  dprLaborLines   DPRLaborLine[]
  leaveRequests   LeaveRequest[]

  @@index([companyId])
  @@index([deletedAt])
  @@index([userId])
  @@index([crewId])
  @@index([activeProjectId])
}

// User is shared with Better-Auth (prisma adapter). Required auth fields:
// id, email, name, emailVerified, image, createdAt, updatedAt.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  emailVerified Boolean   @default(false)
  image         String?
  phone         String?   // phone number for WhatsApp notifications
  role          String    @default("PROJECT_MANAGER") // See roles.ts for full list
  active        Boolean   @default(true)
  // Enterprise employee fields
  employeeCode  String?   // EMP-001 — company-assigned employee ID
  designation   String?   // "Site Engineer", "Store Keeper", etc.
  department    String?   // "Construction", "Procurement", "Finance", "HR"
  joiningDate   DateTime? // official joining date
  // Default company scope (nullable so a user can exist before being
  // assigned to a company; resolved into a UserCompany membership on
  // first login or via the settings UI). UserCompany.role takes
  // precedence over this default when operating within a company.
  companyId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company           Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  memberships       UserCompany[]
  sessions          Session[]
  accounts          Account[]
  stockMovements    StockMovement[]
  goodsReceipts     GoodsReceipt[]
  supervisedGoodsReceipts GoodsReceipt[] @relation("GrnSupervisor")
  rejectedGoodsReceipts   GoodsReceipt[] @relation("GrnRejecter")
  unloadedGoodsReceipts   GoodsReceipt[] @relation("GrnUnloadedBy")
  materialIssues    MaterialIssue[]
  scrapGenerations  ScrapGeneration[]
  auditLogs         AuditLog[]
  assignedTasks     Task[] @relation("TaskAssignee")
  assignedByTasks   Task[] @relation("TaskAssigner")
  completedSubTasks SubTask[]
  taskComments      TaskComment[]
  taskActivities    TaskActivity[]
  taskTimeLogs      TaskTimeLog[]
  createdWorkflows  Workflow[]
  // Approval / creator attribution for transactional records
  approvedPurchaseOrders PurchaseOrder[] @relation("POApprover")
  createdPurchaseOrders  PurchaseOrder[] @relation("POCreator")
  rejectedPurchaseOrders PurchaseOrder[] @relation("PORejecter")
  requestedRequisitions  MaterialRequisition[] @relation("ReqRequester")
  approvedRequisitions   MaterialRequisition[] @relation("ReqApprover")
  rejectedRequisitions   MaterialRequisition[] @relation("ReqRejecter")
  createdExpenses        Expense[]
  createdProjectCosts    ProjectCost[]
  createdAssetSales      AssetSale[]
  createdMaterialSales   MaterialSale[]
  createdRenovations     RenovationProject[]
  createdRenovationCosts RenovationCost[]
  createdStockTransfers  StockTransfer[]
  dispatchedStockTransfers StockTransfer[] @relation("TransferDispatcher")
  receivedStockTransfers   StockTransfer[] @relation("TransferReceiver")
  supervisedStockTransfers StockTransfer[] @relation("TransferSupervisor")
  createdSupplierReturns SupplierReturn[]
  createdLandPurchases   LandPurchase[]
  // Cancellation reversals
  cancelledMaterialIssues  MaterialIssue[]  @relation("MaterialIssueCancelledBy")
  cancelledDirectPurchases DirectPurchase[] @relation("DirectPurchaseCancelledBy")
  cancelledScrapGenerations ScrapGeneration[] @relation("ScrapCancelledBy")
  // HR — DPR submission, attendance recording, payroll processing
  submittedDPRs        DailyProgressReport[]
  subAdminApprovedDPRs DailyProgressReport[] @relation("DprSubAdminApprover")
  adminApprovedDPRs    DailyProgressReport[] @relation("DprAdminApprover")
  recordedAttendances  WorkerAttendance[]
  processedPayrolls    PayrollPeriod[]
  employees            Employee[]
  approvedLeaves       LeaveRequest[]    @relation("LeaveApprover")
  submittedDailyReports DailyReport[]
  createdTenancies     Tenancy[]
  projectAssignments   ProjectAssignment[]
  assignedProjectAssignments ProjectAssignment[] @relation("ProjectAssignmentAssigner")
  createdDirectPurchases DirectPurchase[]
  // Comparative Quote Engine — quote upload + selection + waiver
  quoteWaivedRequisitions MaterialRequisition[] @relation("ReqQuoteWaiver")
  submittedVendorQuotes   VendorQuote[]         @relation("QuoteSubmitter")
  selectedVendorQuotes    VendorQuote[]         @relation("QuoteSelector")
  // Measurement Book — site measurement entry + verification + approval
  mbMeasuredEntries   MeasurementBookEntry[] @relation("MbMeasuredBy")
  mbVerifiedEntries   MeasurementBookEntry[] @relation("MbVerifiedBy")
  mbApprovedEntries   MeasurementBookEntry[] @relation("MbApprovedBy")
  approvedRaBills     RaBill[]                @relation("RaBillApprover")
  submittedChangeOrders  ChangeOrder[]        @relation("ChangeOrderSubmitter")
  approvedChangeOrders   ChangeOrder[]        @relation("ChangeOrderApprover")
  implementedChangeOrders ChangeOrder[]       @relation("ChangeOrderImplementer")
  // Quality Control — NCR raised/reviewed/closed by + CAPA actions
  ncrsRaisedBy        NonConformanceReport[]  @relation("NcrRaisedBy")
  ncrsReviewedBy      NonConformanceReport[]  @relation("NcrReviewedBy")
  ncrsClosedBy        NonConformanceReport[]  @relation("NcrClosedBy")
  capasCorrectiveDoneBy Capa[]                @relation("CapaCorrectiveDoneBy")
  capasPreventiveDoneBy Capa[]                @relation("CapaPreventiveDoneBy")
  capasVerifiedBy     Capa[]                  @relation("CapaVerifiedBy")
  capasClosedBy       Capa[]                  @relation("CapaClosedBy")
  // Safety Management — incident/hazard/inspection user relations
  incidentsReportedBy    SafetyIncident[]      @relation("IncidentReportedBy")
  incidentsInvestigatedBy SafetyIncident[]     @relation("IncidentInvestigatedBy")
  incidentsClosedBy      SafetyIncident[]      @relation("IncidentClosedBy")
  hazardsIdentifiedBy    SafetyHazard[]        @relation("HazardIdentifiedBy")
  hazardsMitigatedBy     SafetyHazard[]        @relation("HazardMitigatedBy")
  hazardsResolvedBy      SafetyHazard[]        @relation("HazardResolvedBy")
  inspectionsConductedBy SafetyInspection[]    @relation("InspectionConductedBy")
  createdRateContracts RateContract[]          @relation("RateContractCreator")
  createdBrokers       Broker[]                @relation("BrokerCreator")
  supplierPayments     SupplierPayment[]       @relation("SupplierPaymentCreator")
  salePayments         MaterialSalePayment[]   @relation("SalePaymentCreator")
  receivedSupplierInvoices  SupplierInvoice[]  @relation("SupplierInvoiceReceiver")
  approvedSupplierInvoices  SupplierInvoice[]  @relation("SupplierInvoiceApprover")
  // Notification system — preferences + in-app notifications
  notificationPreferences NotificationPreference[]
  inAppNotifications      InAppNotification[]
  // Standalone Quotation Requests — submission + approval
  submittedQuotationRequests  QuotationRequest[] @relation("QuotationRequestSubmitter")
  approvedQuotationRequests   QuotationRequest[] @relation("QuotationRequestApprover")
  // Gate Pass — creator, submitter, approver, rejecter, exit confirmer
  createdGatePasses     GatePass[]              @relation("GatePassCreatedBy")
  assignedLeads         Lead[]                  @relation("LeadAssignee")
  createdLeadActivities LeadActivity[]          @relation("LeadActivityCreator")
  submittedGatePasses   GatePass[]              @relation("GatePassSubmittedBy")
  approvedGatePasses    GatePass[]              @relation("GatePassApprovedBy")
  rejectedGatePasses    GatePass[]              @relation("GatePassRejectedBy")
  exitedGatePasses      GatePass[]              @relation("GatePassExitedBy")
  createdLegalDocuments LegalDocument[]         @relation("LegalDocCreatedBy")
}

// ───────────────────────────────────────────────────────────────
//  Project-scoped role assignments — restrict a user's access to
//  specific projects. SUPERVISOR and SALES roles can be scoped to
//  one or more projects; MANAGER+ roles see all projects (unscoped).
//  The `scopedRole` is the role the user acts as within this project
//  (defaults to their global role, but can be elevated per-project).
// ───────────────────────────────────────────────────────────────

model ProjectAssignment {
  id         String   @id @default(cuid())
  userId     String
  projectId  String
  scopedRole String   @default("SUPERVISOR") // role the user acts as within this project
  assignedAt DateTime @default(now())
  assignedById String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("ProjectAssignmentAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String    @id @default(cuid())
  accountId         String
  providerId        String
  userId            String
  accessToken       String?
  refreshToken      String?
  idToken           String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope             String?
  password          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  WAREHOUSE
  MALL
  LAND
  OTHER
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ON_HOLD
}

model Project {
  id          String        @id @default(cuid())
  companyId   String
  name        String
  type        ProjectType   @default(RESIDENTIAL)
  status      ProjectStatus @default(PLANNED)
  address     String?
  startDate   DateTime?
  endDate     DateTime?
  totalBudget Decimal?      @db.Decimal(14, 2)
  description String?
  // Cached computed fields — updated by valuationService
  costPerSqft      Decimal?  @db.Decimal(14, 2) // total project cost / total sellable area
  totalProjectCost Decimal?  @db.Decimal(14, 2) // materials + labour/overhead + allocated land
  totalSellableArea Decimal? @db.Decimal(14, 3) // sum of sellable unit areas
  lciThreshold       Decimal? @db.Decimal(5, 2)  // per-project LCI threshold override (null → company default)
  // ── RERA registration ──
  // Mandatory for projects > 500 sqm or > 8 units (RERA Act 2016).
  // Without a RERA number, the project cannot legally be marketed or sold.
  reraNumber          String?   // RERA registration number (e.g. P1234567890)
  reraRegistrationDate DateTime? // date of RERA registration
  reraValidityDate    DateTime?  // RERA registration validity expiry (typically 5 years or project completion)
  reraWebsiteUrl      String?    // RERA project page URL (for buyer verification)
  // Optimistic locking — see Material.version comment
  version      Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  stockLocations StockLocation[]
  purchaseOrders PurchaseOrder[]
  materialIssues MaterialIssue[]
  materialRequisitions MaterialRequisition[]
  scrapGenerations ScrapGeneration[]
  landPurchases  LandPurchase[]
  landParcels    LandParcel[]
  builtUnits     BuiltUnit[]
  assetSales     AssetSale[]
  materialSales  MaterialSale[]
  projectCosts   ProjectCost[]
  assignments    ProjectAssignment[]
  renovations    RenovationProject[]
  expenses       Expense[]
  phases         ProjectPhase[]
  equipmentAssignments EquipmentAssignment[]
  crews          Crew[]
  attendances    WorkerAttendance[]
  dailyProgressReports DailyProgressReport[]
  dailyReports       DailyReport[]
  tenancies          Tenancy[]
  activeEmployees Employee[] @relation("EmployeeActiveProject")
  userScopes       UserScope[]    // Sub-Sub-Admin scope entries pointing at this project
  boqItems         BoqItem[]
  wbsNodes         WbsNode[]
  mbEntries        MeasurementBookEntry[]
  subcontractorWorkOrders SubcontractorWorkOrder[]
  raBills          RaBill[]
  quotationRequests QuotationRequest[]
  gatePasses       GatePass[]
  leads            Lead[]
  changeOrders     ChangeOrder[]
  ncrs             NonConformanceReport[]
  capas            Capa[]
  safetyIncidents  SafetyIncident[]
  safetyHazards    SafetyHazard[]
  safetyInspections SafetyInspection[]
  legalDocuments   LegalDocument[] @relation("LegalDocsProject")

  @@index([companyId])
  @@index([status])
}

enum PhaseStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ON_HOLD
}

model ProjectPhase {
  id          String       @id @default(cuid())
  projectId   String
  name        String       // e.g. "Tower A", "Phase 1"
  status      PhaseStatus  @default(PLANNED)
  startDate   DateTime?
  endDate     DateTime?
  budget      Decimal?     @db.Decimal(14, 2)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stockLocations StockLocation[]
  builtUnits     BuiltUnit[]
  materialIssues MaterialIssue[]
  materialRequisitions MaterialRequisition[]
  boqItems       BoqItem[]
  wbsNodes       WbsNode[]
  mbEntries      MeasurementBookEntry[]
  subcontractorWorkOrders SubcontractorWorkOrder[]
  changeOrders   ChangeOrder[]

  @@index([projectId])
}

// ───────────────────────────────────────────────────────────
//  MATERIAL INVENTORY: locations, catalog, procurement, ledger
// ───────────────────────────────────────────────────────────

enum StockLocationType {
  COMPANY_WAREHOUSE
  PROJECT_SITE
  DEPARTMENT // operational cost-center stock room (e.g. Workshop, Boiler house)
}

// ───────────────────────────────────────────────────────────
//  VEHICLE MASTER + TRIP LOG
//  Every goods movement (receive, issue, sell, transfer, return, direct
//  purchase) involves a vehicle — truck, tempo, pickup, tractor, bike,
//  cycle, hand cart, or even a porter carrying on shoulder. The Vehicle
//  master auto-builds from usage: first time a vehicle number is entered,
//  a record is created. Subsequent uses update lastUsedAt + tripCount.
//  A photo of the vehicle is stored for identification.
// ───────────────────────────────────────────────────────────
model Vehicle {
  id              String   @id @default(cuid())
  // Vehicle number — "MH-12-AB-1234" for trucks, or descriptive for
  // non-registered: "CYCLE-01", "PORTER-RAMU", "HANDCART-03"
  vehicleNumber   String
  vehicleType     String             // TRUCK | TEMPO | PICKUP | TRACTOR | MINI_TRUCK | AUTO | CAR | BIKE | CYCLE | HAND_CART | PORTER | OTHER
  photoUrl        String?            // photo of the vehicle (for ID)
  // Driver / carrier details — auto-filled from last trip
  driverName      String?
  driverPhone     String?
  transporterName String?            // for third-party transport
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tripCount       Int      @default(0)  // auto-incremented on each trip
  lastUsedAt      DateTime?
  lastLocationId  String?            // where it was last seen
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  trips           VehicleTrip[]

  @@unique([vehicleNumber, companyId])
  @@index([companyId])
}

model VehicleTrip {
  id              String   @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  // What type of movement was this?
  movementType    String   // PURCHASE_RECEIPT | STOCK_TRANSFER | MATERIAL_ISSUE | MATERIAL_SALE | SUPPLIER_RETURN | DIRECT_PURCHASE | SCRAP_SALE
  refType         String   // "GoodsReceipt" | "StockTransfer" | "MaterialIssue" | "MaterialSale" | "SupplierReturn" | "DirectPurchase"
  refId           String   // ID of the referenced record
  // Route
  fromLocationId  String?
  toLocationId    String?
  // Driver info for this specific trip (may differ from vehicle master)
  driverName      String?
  driverPhone     String?
  transporterName String?
  // Photos of the vehicle + goods for this trip
  photos          Json?    // array of { url, fileName }
  timestamp       DateTime @default(now())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([companyId])
  @@index([refType, refId])
}

model StockLocation {
  id        String            @id @default(cuid())
  type      StockLocationType
  companyId String
  projectId String?
  phaseId   String?
  departmentId String?        @unique // set when type = DEPARTMENT (1:1 — a department has at most one stock room)
  name      String
  address   String?
  // Geo-fence center + radius (metres) for validating GPS-tagged receipts.
  // When receiverLat/receiverLng is captured, the system checks the distance
  // against these coordinates. If > geoRadius, the receipt is flagged as off-site.
  lat       Float?
  lng       Float?
  geoRadius Int?              // allowed radius in metres (default 500 if null)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?

  company        Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project        Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase          ProjectPhase?     @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  department     Department?       @relation("DepartmentLocation", fields: [departmentId], references: [id], onDelete: SetNull)
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  stockMovementsFrom StockMovement[] @relation("MovementFrom")
  stockMovementsTo   StockMovement[] @relation("MovementTo")
  materialIssues MaterialIssue[]
  scrapGenerations ScrapGeneration[]
  stockTransfersFrom StockTransfer[] @relation("TransferFrom")
  stockTransfersTo   StockTransfer[] @relation("TransferTo")
  stockCounts    StockCount[]
  stockItems     StockLocationItem[]
  equipmentAssignments EquipmentAssignment[]
  supplierReturns SupplierReturn[]
  materialSaleLines MaterialSaleLine[]
  directPurchases  DirectPurchase[]
  quotationRequestDestinations QuotationRequest[] @relation("QuotationRequestDestination")
  gatePasses       GatePass[]

  @@index([companyId])
  @@index([projectId])
  @@index([phaseId])
  @@index([departmentId])
}

enum MaterialClass {
  RAW_MATERIAL     // cement, steel, brick, timber
  CONSUMABLE       // fasteners, sealants, paint, safety gear
  MRO              // lubricants, repair parts, maintenance supplies
  TEMPORARY        // scaffolding, fencing, formwork, tarps
}

model MaterialCategory {
  id        String        @id @default(cuid())
  name      String        @unique
  unit      String        @default("NOS")
  class     MaterialClass @default(RAW_MATERIAL)
  createdAt DateTime      @default(now())
  deletedAt DateTime?

  materials Material[]
}

model Material {
  id               String   @id @default(cuid())
  code             String   @unique
  barcode          String?  @unique
  qrCode           String?  @unique
  name             String
  // Grade + specification — used for auto-generating the material code and
  // for like-for-like comparison in quotations. Real-world material masters
  // always carry these: "Fe500D" (steel grade), "OPC 53" (cement grade),
  // "12mm" (steel diameter), "IS 1786" (BIS standard).
  grade            String?  // e.g. "Fe500D", "OPC 53", "20mm"
  specification    String?  // e.g. "IS 1786", "IS 269", full spec string
  categoryId       String
  unit             String   @default("NOS")
  hsnCode          String?
  gstRate          Decimal  @default(0) @db.Decimal(5, 2)
  standardCost     Decimal  @default(0) @db.Decimal(14, 2)
  currentCost      Decimal  @default(0) @db.Decimal(14, 2) // global fallback; per-location MAC lives in StockLocationItem
  minStock         Decimal? @db.Decimal(14, 3)
  reorderPoint     Decimal? @db.Decimal(14, 3) // trigger to reorder
  economicOrderQty Decimal? @db.Decimal(14, 3) // EOQ — optimal order quantity
  // LCI inputs — see procurement-routing.ts. Used by the Logistics Decision Engine
  // to auto-route requisitions between Central (COMPANY) and Direct (PROJECT) procurement.
  volumetricDensity  Decimal? @db.Decimal(10, 3) // V/W ratio — higher = bulkier / harder to transport
  bulkDiscountPct    Decimal? @db.Decimal(5, 2)  // enterprise volume discount % via centralised bulk buying
  isCorporateCommodity Boolean @default(false)   // force central procurement routing
  isScrap          Boolean @default(false)        // scrap / internally-generated material (different valuation)
  // ── Batch / Lot Tracking ──
  isLotTracked     Boolean @default(false)        // enables batch/lot compliance management
  // ── UOM Conversion ──
  // baseUnit is the normalized base UOM (e.g. "KG", "M3", "PCS"); secondaryUnit is
  // an optional display/transaction UOM (e.g. "TON", "BAG"). uomConversionFactor
  // is the multiplier: 1 secondary unit = N base units (e.g. 1 BAG = 50 KG → 50).
  baseUnit         String   @default("NOS")       // normalized base UOM
  secondaryUnit    String?                          // optional display/transaction UOM
  uomConversionFactor Decimal? @db.Decimal(12, 6)   // 1 secondary unit = N base units
  description      String?
  // Optimistic locking — incremented on every update. Clients send the
  // version they read; if it doesn't match, the update is rejected as a
  // concurrent edit conflict.
  version          Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  category          MaterialCategory   @relation(fields: [categoryId], references: [id])
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceiptLines  GoodsReceiptLine[]
  stockMovements    StockMovement[]
  materialIssueLines MaterialIssueLine[]
  scrapGenerationsSource ScrapGeneration[] @relation("ScrapSourceMaterial")
  scrapGenerationLines ScrapGenerationLine[]
  stockTransferLines StockTransferLine[]
  stockCountLines   StockCountLine[]
  stockItems        StockLocationItem[]
  requisitionLines  MaterialRequisitionLine[]
  supplierReturnLines SupplierReturnLine[]
  dprMaterialLines  DPRMaterialLine[]
  materialSaleLines  MaterialSaleLine[]
  directPurchaseLines DirectPurchaseLine[]
  vendorQuoteLines  VendorQuoteLine[]
  quotationRequestLines QuotationRequestLine[]
  standardConsumptions StandardConsumption[]
  boqItems         BoqItem[]
  rateContracts    RateContract[]
  lots             MaterialLot[]
  gatePassLines    GatePassLine[]
  rateAnalysisLines RateAnalysisLine[]

  @@index([categoryId])
}

// ───────────────────────────────────────────────────────────
//  BATCH / LOT TRACKING — per-batch quantity + expiry tracking
//  for lot-tracked materials. Each lot records its initial and
//  current balance; StockMovement.lotId links movements to lots.
// ───────────────────────────────────────────────────────────
model MaterialLot {
  id          String   @id @default(uuid())
  materialId  String
  material    Material @relation(fields: [materialId], references: [id])
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  lotNumber   String
  batchCode   String?
  receivedDate DateTime
  expiryDate  DateTime?
  initialQty  Decimal  @db.Decimal(14,3)
  currentQty  Decimal  @db.Decimal(14,3)
  unitCost    Decimal  @db.Decimal(14,2)
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  notes       String?
  createdAt   DateTime @default(now())
  deletedAt   DateTime?

  stockMovements StockMovement[]
  stockItems     StockLocationItem[]

  @@unique([materialId, lotNumber, companyId])
  @@index([materialId, companyId])
}

// ───────────────────────────────────────────────────────────
//  STANDARD CONSUMPTION BENCHMARKS
//  Per-work-type standard material consumption rates, used by the
//  auto-scrap detection logic during DPR submission. E.g.:
//    workType = "Foundation", material = Steel, standardQty = 1.5 t / 100 sqft
//  When a DPR records 2.0 t of steel for a 100 sqft foundation, the
//  0.5 t delta is auto-flagged as generated scrap.
// ───────────────────────────────────────────────────────────
model StandardConsumption {
  id              String   @id @default(cuid())
  companyId       String
  workType        String   // e.g. "Foundation", "Slab Casting", "Brickwork", "Plastering"
  materialId      String
  standardQty     Decimal  @db.Decimal(14, 3) // standard qty per baseQty units of work
  baseQty         Decimal  @db.Decimal(14, 3) @default(1) // the "per N" divisor (e.g. 100 for "per 100 sqft")
  unitOfMeasure   String   // e.g. "per 100 sqft", "per cubic meter", "per unit" — display label
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  material        Material @relation(fields: [materialId], references: [id])

  @@unique([companyId, workType, materialId])
  @@index([companyId, workType])
}

model Supplier {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  gstin       String?
  phone       String?
  email       String?
  address     String?
  balanceOwed Decimal  @default(0) @db.Decimal(14, 2)
  leadTimeDays Int?    // average vendor lead time in days — LCI input (S_lead)
  // Optimistic locking — see Material.version comment
  version     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  purchaseOrders   PurchaseOrder[]
  supplierReturns  SupplierReturn[]
  requisitionLines MaterialRequisitionLine[]
  directPurchases  DirectPurchase[]
  vendorQuotes     VendorQuote[]
  rateContracts    RateContract[]
  supplierPayments SupplierPayment[]
  supplierInvoices SupplierInvoice[]
  materialLots     MaterialLot[]

  @@index([companyId])
  @@index([companyId, deletedAt])
  @@index([name])
}

model Subcontractor {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  gstin       String?
  phone       String?
  email       String?
  address     String?
  trade       String?  // e.g. "Plumbing", "Electrical", "Masonry"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  company         Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  materialIssues  MaterialIssue[]
  projectCosts    ProjectCost[]
  workOrders      SubcontractorWorkOrder[]
  ncrs            NonConformanceReport[]

  @@index([companyId])
  @@index([companyId, deletedAt])
  @@index([name])
}

// ───────────────────────────────────────────────────────────
//  DEPARTMENT / COST CENTER — operational consumption target
//  for raw materials (manufacturing/processing lines, workshop,
//  lab, admin). Distinct from a Project: a department is an
//  ongoing cost center, not a capitalised build. Materials
//  issued to a department hit Operating Expenses (not WIP).
//  Modeled on the Testify Overseas paper trail (Boiler, Dryer,
//  MP-1/2/3, R.O. Plant, Workshop, etc.).
// ───────────────────────────────────────────────────────────
model Department {
  id          String   @id @default(cuid())
  companyId   String
  code        String   // short stable code, e.g. "BOILER", "MP-2"
  name        String   // display name, e.g. "Boiler House"
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stockLocation StockLocation? @relation("DepartmentLocation") // optional own stock room
  materialIssues MaterialIssue[]
  requisitions  MaterialRequisition[] // department-scoped requisitions (rice mill)
  userScopes    UserScope[]    // Sub-Admin scope entries pointing at this department

  @@unique([companyId, code])
  @@index([companyId])
  @@index([deletedAt])
}

// ───────────────────────────────────────────────────────────
//  HR & FIELD WORKFORCE — crews, attendance, payroll, DPR.
//  The third whiteboard module: employees are grouped into crews
//  assigned to a project; daily attendance feeds payroll; daily
//  progress reports (DPR) capture site execution. Payroll posts
//  to the GL (Dr Salaries Expense, Cr Salaries Payable/Cash).
// ───────────────────────────────────────────────────────────

model Crew {
  id        String   @id @default(cuid())
  companyId String
  name      String   // e.g. "Masonry Crew A", "Plumbing Team 2"
  projectId String?  // project the crew is assigned to (nullable = floating/shared)
  supervisorId String? // Employee who leads the crew
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project    Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  supervisor Employee?  @relation("CrewSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  members    Employee[] @relation("CrewMembers")
  dprLaborLines DPRLaborLine[]

  @@index([companyId])
  @@index([projectId])
  @@index([supervisorId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  OVERTIME
  LEAVE
}

model WorkerAttendance {
  id          String           @id @default(cuid())
  companyId   String
  employeeId  String
  date        DateTime         @db.Date // the working day (date-only)
  projectId   String?          // project the worker attended on that day
  checkIn     DateTime?
  checkOut    DateTime?
  hoursWorked Decimal?         @db.Decimal(5, 2) // total hours on site (incl. overtime)
  status      AttendanceStatus @default(PRESENT)
  notes       String?
  recordedById String?
  // GPS-tagged check-in/check-out (from mobile app)
  checkInLat   Float?
  checkInLng   Float?
  checkOutLat  Float?
  checkOutLng  Float?
  checkInLocation  String?  // reverse-geocoded or manual location label
  checkOutLocation String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  recordedBy User?     @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([employeeId, date]) // one attendance record per worker per day
  @@index([companyId, date])
  @@index([projectId, date])
  @@index([employeeId, date])
}

enum PayrollStatus {
  DRAFT      // lines generated from attendance, editable
  PROCESSED  // locked + posted to GL (Dr Salaries Expense, Cr Salaries Payable)
  PAID       // settled (Dr Salaries Payable, Cr Cash)
}

model PayrollPeriod {
  id        String        @id @default(cuid())
  companyId String
  month     Int           // 1-12
  year      Int
  startDate DateTime      @db.Date
  endDate   DateTime      @db.Date
  status    PayrollStatus @default(DRAFT)
  totalGross       Decimal @default(0) @db.Decimal(14, 2)
  totalOvertime    Decimal @default(0) @db.Decimal(14, 2)
  totalDeductions  Decimal @default(0) @db.Decimal(14, 2)
  totalNet         Decimal @default(0) @db.Decimal(14, 2)
  processedById String?
  processedAt  DateTime?
  paidAt       DateTime?
  notes        String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  processedBy User?   @relation(fields: [processedById], references: [id], onDelete: SetNull)
  lines      PayrollLine[]

  @@unique([companyId, year, month])
  @@index([companyId])
  @@index([status])
}

model PayrollLine {
  id              String   @id @default(cuid())
  payrollPeriodId String
  employeeId      String
  daysWorked      Decimal  @db.Decimal(5, 2) // present-days (PRESENT=1, HALF_DAY=0.5, OVERTIME=1)
  basicAmount     Decimal  @default(0) @db.Decimal(14, 2)
  overtimeAmount  Decimal  @default(0) @db.Decimal(14, 2)
  allowance       Decimal  @default(0) @db.Decimal(14, 2) // HRA, travel, food, etc.
  bonus           Decimal  @default(0) @db.Decimal(14, 2) // performance / festival bonus
  pf              Decimal  @default(0) @db.Decimal(14, 2) // employee provident fund (deducted from gross)
  employerPf      Decimal  @default(0) @db.Decimal(14, 2) // employer provident fund (additional expense, not deducted from employee)
  esi             Decimal  @default(0) @db.Decimal(14, 2) // ESI deduction (employee portion)
  professionTax   Decimal  @default(0) @db.Decimal(14, 2) // profession tax (deducted from gross)
  tax             Decimal  @default(0) @db.Decimal(14, 2) // TDS / income tax deducted
  deductions      Decimal  @default(0) @db.Decimal(14, 2) // other deductions (loans, advances, penalties)
  grossPay        Decimal  @default(0) @db.Decimal(14, 2) // basic + overtime + allowance + bonus
  totalDeductions Decimal  @default(0) @db.Decimal(14, 2) // deductions + pf + esi + professionTax + tax
  netPay          Decimal  @default(0) @db.Decimal(14, 2) // grossPay - totalDeductions
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payrollPeriod PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([payrollPeriodId, employeeId])
  @@index([employeeId])
}

model DailyProgressReport {
  id           String   @id @default(cuid())
  companyId    String
  projectId    String
  date         DateTime @db.Date
  submittedById String?
  weather      String?  // e.g. "Sunny, 32°C", "Light rain"
  workSummary  String   // narrative of today's work
  progressPct  Decimal  @db.Decimal(5, 2) @default(0) // overall project progress % as of this DPR
  blockers     String?
  tomorrowPlan String?
  notes        String?
  photoUrls    String[]  @default([]) // site photos — URLs to uploaded images
  // Multi-tier approval workflow (SRS transcript): Sub-Admin (MANAGER) approves
  // first, then Admin (OWNER/ADMIN) gives final approval. A DPR goes:
  //   DRAFT → SUBMITTED → SUB_ADMIN_APPROVED → APPROVED
  //   (any pre-final stage can be REJECTED)
  approvalStatus   DprApprovalStatus @default(SUBMITTED)
  subAdminApprovedById String?
  subAdminApprovedAt   DateTime?
  adminApprovedById    String?
  adminApprovedAt      DateTime?
  approvalNotes        String?  // optional reason for rejection or override
  // Auto-scrap detection: work type for benchmark comparison + variance results
  workType             String?  // e.g. "Foundation", "Slab Casting" — matched against StandardConsumption
  workQty              Decimal? @db.Decimal(14, 3) // quantity of work done (e.g. 500 sqft of foundation poured)
  workUnit             String?  // unit of work (e.g. "sqft", "cubic meter", "unit")
  varianceAnalysis     Json?    // stored variance results from calculateConsumptionVariance()
  autoScrapGenerationId String? @unique // link to auto-generated ScrapGeneration if over-consumption detected
  // DPR-Finance Bridge: track when DPR costs were posted to the GL
  costPostedDate       DateTime? // null = not yet posted to finance
  costPostedAmount     Decimal?  @db.Decimal(14, 2) // total cost posted (material + labor)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  autoScrapGeneration ScrapGeneration? @relation("DprAutoScrap", fields: [autoScrapGenerationId], references: [id], onDelete: SetNull)
  submittedBy User?    @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  subAdminApprovedBy User? @relation("DprSubAdminApprover", fields: [subAdminApprovedById], references: [id], onDelete: SetNull)
  adminApprovedBy    User? @relation("DprAdminApprover", fields: [adminApprovedById], references: [id], onDelete: SetNull)
  materialLines DPRMaterialLine[]
  laborLines    DPRLaborLine[]
  // DPR-Finance Bridge: back-relations to cost postings linked from this DPR
  materialIssues MaterialIssue[] @relation("DprMaterialIssues")
  projectCosts   ProjectCost[]   @relation("DprProjectCosts")

  @@unique([projectId, date]) // one DPR per project per day
  @@index([companyId, date])
  @@index([projectId, date])
  @@index([approvalStatus])
}

enum DprApprovalStatus {
  SUBMITTED           // just submitted, awaiting Sub-Admin approval
  SUB_ADMIN_APPROVED  // Sub-Admin approved, awaiting Admin final approval
  APPROVED            // Admin final approval — locked
  REJECTED            // rejected at any stage
}

model DPRMaterialLine {
  id        String  @id @default(cuid())
  dprId     String
  materialId String
  qty       Decimal @db.Decimal(14, 3)
  unitCost  Decimal @db.Decimal(14, 2)

  dpr      DailyProgressReport @relation(fields: [dprId], references: [id], onDelete: Cascade)
  material Material            @relation(fields: [materialId], references: [id])

  @@index([dprId])
  @@index([materialId])
}

model DPRLaborLine {
  id        String   @id @default(cuid())
  dprId     String
  employeeId String?
  crewId    String?
  hoursWorked Decimal @db.Decimal(5, 2)
  taskDescription String

  dpr      DailyProgressReport @relation(fields: [dprId], references: [id], onDelete: Cascade)
  employee Employee?           @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  crew     Crew?               @relation(fields: [crewId], references: [id], onDelete: SetNull)

  @@index([dprId])
  @@index([employeeId])
  @@index([crewId])
}

enum ProcurementScope {
  COMPANY
  PROJECT
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id                    String              @id @default(cuid())
  poNumber              String              @unique
  supplierId            String
  procurementScope      ProcurementScope
  companyId             String
  projectId             String?
  destinationLocationId String
  status                PurchaseOrderStatus @default(DRAFT)
  orderDate             DateTime            @default(now())
  expectedDate          DateTime?
  subtotal              Decimal             @default(0) @db.Decimal(14, 2)
  gstTotal              Decimal             @default(0) @db.Decimal(14, 2)
  // ── Landed-cost components (carried over from the winning VendorQuote or
  // entered manually). These are header-level totals that complement the
  // per-line amounts. The grand total = subtotal + gstTotal + freightTotal +
  // loadingTotal + packingTotal + insuranceTotal + miscChargesTotal − discountTotal.
  freightTotal          Decimal             @default(0) @db.Decimal(14, 2) // transport / carriage
  loadingTotal          Decimal             @default(0) @db.Decimal(14, 2) // loading + unloading
  packingTotal          Decimal             @default(0) @db.Decimal(14, 2) // packing & forwarding
  insuranceTotal        Decimal             @default(0) @db.Decimal(14, 2) // transit insurance
  discountTotal         Decimal             @default(0) @db.Decimal(14, 2) // discount (reduces total)
  miscChargesTotal      Decimal             @default(0) @db.Decimal(14, 2) // Σ of PurchaseOrderCharge rows
  // Grand total — subtotal + GST + all charges − discount. This is what the
  // supplier is expected to invoice.
  total                 Decimal             @default(0) @db.Decimal(14, 2)
  notes                 String?
  // Approval workflow — DRAFT → APPROVED requires a user with po.approve
  createdById           String?
  approvedById          String?
  approvedAt            DateTime?
  approvalNotes         String?
  // Delivery rejection tracking — when a delivery is refused at the gate,
  // rejectedAt is set. The PO stays ORDERED (supplier can re-deliver), but
  // the rejection is visible in the UI and audit trail.
  rejectedAt            DateTime?
  rejectedById          String?
  rejectionReason       String?
  // The winning VendorQuote that this PO was generated from (traceability for
  // the Comparative Quote Engine). Null for POs created directly (not from a quote).
  selectedQuoteId       String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  supplier            Supplier             @relation(fields: [supplierId], references: [id])
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project             Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  destinationLocation StockLocation        @relation(fields: [destinationLocationId], references: [id])
  createdBy           User?                @relation("POCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy          User?                @relation("POApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy          User?                @relation("PORejecter", fields: [rejectedById], references: [id], onDelete: SetNull)
  selectedQuote       VendorQuote?         @relation("POSelectedQuote", fields: [selectedQuoteId], references: [id], onDelete: SetNull)
  lines               PurchaseOrderLine[]
  charges             PurchaseOrderCharge[]
  goodsReceipts       GoodsReceipt[]
  supplierPayments    SupplierPayment[]
  supplierInvoices    SupplierInvoice[]
  quotationRequest    QuotationRequest? @relation("QuotationConvertedPo")

  @@index([companyId])
  @@index([projectId])
  @@index([supplierId])
  @@index([status])
  @@index([approvedById])
}

model SupplierPayment {
  id            String   @id @default(cuid())
  paymentNumber String   @unique // SP-YYMMDD-NNNN
  supplierId    String
  purchaseOrderId String? // optional link to a specific PO
  invoiceId     String?  // optional link to a specific SupplierInvoice
  companyId     String
  amount        Decimal  @db.Decimal(14, 2)
  tdsAmount     Decimal  @default(0) @db.Decimal(14, 2) // TDS deducted at source
  tdsSection    String?  // e.g. "194C", "194I", "194J"
  netPaidAmount Decimal  @default(0) @db.Decimal(14, 2) // amount - tdsAmount
  paymentDate   DateTime @default(now())
  paymentMode   String   // "BANK" | "CASH" | "UPI" | "CHEQUE" | "NEFT"
  referenceNo   String?  // cheque no, UTR, transaction ID
  notes         String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  supplier       Supplier         @relation(fields: [supplierId], references: [id])
  purchaseOrder  PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  invoice        SupplierInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy      User?            @relation("SupplierPaymentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([invoiceId])
}

// ───────────────────────────────────────────────────────────
//  Supplier Invoice — three-way matching (invoice ↔ PO ↔ GRN)
//  Before paying a supplier, the invoice is matched against the
//  purchase order and goods receipt to prevent overpayment/fraud.
// ───────────────────────────────────────────────────────────
model SupplierInvoice {
  id            String   @id @default(cuid())
  invoiceNumber String   // supplier's bill number
  companyId     String
  supplierId    String
  purchaseOrderId String?
  invoiceDate   DateTime
  dueDate       DateTime?
  subtotal      Decimal  @db.Decimal(14, 2)
  gstAmount     Decimal  @default(0) @db.Decimal(14, 2)
  totalAmount   Decimal  @db.Decimal(14, 2)
  status        String   @default("PENDING") // PENDING | MATCHED | DISPUTED | APPROVED | PAID
  matchStatus   String?  // THREE_WAY_MATCH | TWO_WAY_MATCH | MANUAL | UNMATCHED
  matchNotes    String?
  receivedById  String?
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  supplier       Supplier         @relation(fields: [supplierId], references: [id])
  purchaseOrder  PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  company        Company          @relation(fields: [companyId], references: [id])
  receivedBy     User?            @relation("SupplierInvoiceReceiver", fields: [receivedById], references: [id])
  approvedBy     User?            @relation("SupplierInvoiceApprover", fields: [approvedById], references: [id])
  payments       SupplierPayment[]

  @@index([companyId])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([status])
}

model PurchaseOrderLine {
  id             String   @id @default(cuid())
  purchaseOrderId String
  materialId     String
  qtyOrdered     Decimal  @db.Decimal(14, 3)
  qtyReceived    Decimal  @default(0) @db.Decimal(14, 3)
  unitCost       Decimal  @db.Decimal(14, 2)
  gstRate        Decimal  @default(0) @db.Decimal(5, 2)
  // ── Per-unit landed-cost components (carried over from VendorQuoteLine
  // when the PO is auto-generated from a quotation). All default to 0 for
  // POs created directly. These let the PO reflect the true per-unit cost
  // breakdown that the supplier quoted.
  freightPerUnit   Decimal  @default(0) @db.Decimal(14, 2)
  loadingPerUnit   Decimal  @default(0) @db.Decimal(14, 2)
  packingPerUnit   Decimal  @default(0) @db.Decimal(14, 2)
  insurancePerUnit Decimal  @default(0) @db.Decimal(14, 2)
  discountPerUnit  Decimal  @default(0) @db.Decimal(14, 2)
  unitLandedCost   Decimal  @default(0) @db.Decimal(14, 2) // all-in per-unit cost
  lineTotal      Decimal  @default(0) @db.Decimal(14, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  material      Material      @relation(fields: [materialId], references: [id])
  goodsReceiptLines GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@index([materialId])
}

// ───────────────────────────────────────────────────────────
//  PO CHARGES — itemized miscellaneous charges on a Purchase Order.
//  Each charge has a heading (e.g. "Loading", "Unloading", "Fuel Charge",
//  "Transportation", "Packing & Forwarding") and an amount. This lets the
//  PO reflect the full landed-cost breakdown that the supplier quoted.
//  Charges are carried over from the winning VendorQuote when the PO is
//  auto-generated from a quotation, and can also be added/edited manually.
// ───────────────────────────────────────────────────────────

model PurchaseOrderCharge {
  id              String   @id @default(cuid())
  purchaseOrderId String
  heading         String   // e.g. "Loading", "Unloading", "Fuel Charge", "Transportation"
  amount          Decimal  @db.Decimal(14, 2)
  notes           String?
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

enum InspectionStatus {
  PENDING
  PASSED
  FAILED
  REJECTED
}

model GoodsReceipt {
  id             String   @id @default(cuid())
  purchaseOrderId String
  locationId     String
  receiptDate    DateTime @default(now())
  receivedById   String?
  notes          String?
  createdAt      DateTime @default(now())
  // Quality inspection
  inspectionStatus InspectionStatus @default(PENDING)
  inspectionNotes  String?
  inspectedById    String?
  inspectedAt      DateTime?

  // ── Delivery proof & logistics (GRN enhancement) ──
  // Captured at the time of receiving to create an auditable, Amazon-style
  // proof-of-delivery record. Mandatory fields are enforced at the API layer.
  // Delivery context — carried from the PO/quote for adaptive field display.
  deliveryTermsType  String?   // DELIVERED_SITE | EX_WORKS | FOR_STATION | CUSTOM
  // How the goods arrived
  deliveryMode       String?   // SUPPLIER_VEHICLE | OWN_VEHICLE | THIRD_PARTY | HAND_CARRY
  vehicleType        String?   // TRUCK | TEMPO | PICKUP | TRACTOR | HAND_CART | OTHER
  vehicleNumber      String?
  driverName         String?
  driverPhone        String?
  transporterName    String?
  // Supplier dispatch documents
  challanNumber      String?
  invoiceNumber      String?
  ewayBillNumber     String?
  lrNumber           String?   // Lorry Receipt (transport document)
  packageCount       Int?
  // Proof of delivery — mandatory
  photos             Json?     // array of { url, fileName } uploaded via /api/uploads
  receiverSignature  String?   // base64 PNG of e-signature canvas
  // Geo-tag at receipt time — verifies goods are at the expected location
  receiverLat        Float?
  receiverLng        Float?
  receiverLocation   String?   // reverse-geocoded or manual label
  geoFenceOk         Boolean?  // true if receiver GPS is within location geoRadius
  geoFenceDistance   Float?    // distance in metres from location center (null if no geo-fence)
  // Gate-in timestamp (when vehicle entered premises) vs receiptDate (formal GRN)
  gateInAt           DateTime?
  // Gate pass no. — the supplier's gate pass / delivery authorization number.
  // "kis gate pass par maal utra" — formal deliveries have this.
  // For small/informal deliveries with no gate pass, a receiving photo is uploaded instead.
  gatePassNo         String?
  // Receiving photo — when there's no formal gate pass (chota-mota kaam),
  // the company issues a simple receiving. User uploads a photo of it.
  receivingPhotoUrl  String?
  // Unloading slip — issued by storekeeper after goods are physically unloaded.
  // Sequential per location per year: US-YYYY-NNN
  unloadingSlipNo    String?
  unloadedById       String?
  unloadedBy         User?     @relation("GrnUnloadedBy", fields: [unloadedById], references: [id], onDelete: SetNull)
  unloadedAt         DateTime?
  unloadingLocation  String?   // bay/yard/shed where goods were unloaded
  unloadingRemarks   String?   // damage during unloading, stacking notes
  // Shortage / damage observations
  shortageRemarks    String?
  damageRemarks      String?
  // Supervisor co-signature (dual signature for high-value receipts)
  supervisorSignature String?  // base64 PNG
  supervisorId       String?
  supervisor         User?     @relation("GrnSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  // Weighbridge data — for bulk materials (aggregate, sand, steel)
  weighbridgeTicketNo String?
  grossWeight        Decimal?  @db.Decimal(14, 3) // vehicle + load (kg)
  tareWeight         Decimal?  @db.Decimal(14, 3) // empty vehicle (kg)
  netWeight          Decimal?  @db.Decimal(14, 3) // gross - tare = material weight
  // Rejection at gate (goods refused entry — no GRN created)
  rejectedAt         DateTime?
  rejectedById       String?
  rejectedBy         User?     @relation("GrnRejecter", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectionReason    String?
  rejectionPhotos    Json?     // array of { url, fileName } — proof of rejection

  purchaseOrder PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  location      StockLocation       @relation(fields: [locationId], references: [id])
  receivedBy    User?               @relation(fields: [receivedById], references: [id])
  lines         GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@index([locationId])
}

model GoodsReceiptLine {
  id                String  @id @default(cuid())
  goodsReceiptId    String
  purchaseOrderLineId String
  materialId        String
  qtyReceived       Decimal @db.Decimal(14, 3)
  unitCost          Decimal @db.Decimal(14, 2)
  // Batch/lot tracking — critical for cement, paint, steel, chemicals.
  // Links to MaterialLot for expiry tracking and recall management.
  lotNumber         String?
  batchCode         String?
  expiryDate        DateTime?
  manufacturingDate DateTime?
  // Quality inspection per line
  inspectionStatus  InspectionStatus @default(PENDING)
  inspectionRemarks String?

  goodsReceipt     GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
  material         Material          @relation(fields: [materialId], references: [id])

  @@index([goodsReceiptId])
  @@index([materialId])
}

enum StockMovementType {
  PURCHASE_RECEIPT
  TRANSFER_IN
  TRANSFER_OUT
  ISSUE_TO_PROJECT
  ISSUE_TO_DEPARTMENT // raw-material consumption by an operational cost center
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN
  SALE
  SCRAP_GENERATED // internally generated scrap/created material added to stock at scrap valuation
}

model StockMovement {
  id             String            @id @default(cuid())
  materialId     String
  movementType   StockMovementType
  fromLocationId String?
  toLocationId   String?
  qty            Decimal           @db.Decimal(14, 3)
  unitCost       Decimal           @db.Decimal(14, 2) // MAC at time of movement (for issues) or receipt unit cost
  balanceAfter   Decimal           @db.Decimal(14, 3) // qty remaining at the affected location after this movement
  balanceValueAfter Decimal        @default(0) @db.Decimal(14, 2) // qty × MAC after this movement (cost audit trail)
  reason         String?
  refType        String?
  refId          String?
  userId         String?
  lotId          String?           // links the movement to a specific lot (if material is lot-tracked)
  timestamp      DateTime          @default(now())
  // GPS capture for field verification
  latitude       Float?
  longitude      Float?

  material      Material       @relation(fields: [materialId], references: [id])
  fromLocation  StockLocation? @relation("MovementFrom", fields: [fromLocationId], references: [id])
  toLocation    StockLocation? @relation("MovementTo", fields: [toLocationId], references: [id])
  user          User?          @relation(fields: [userId], references: [id])
  lot           MaterialLot?   @relation(fields: [lotId], references: [id])

  @@index([materialId, timestamp])
  @@index([toLocationId])
  @@index([fromLocationId])
  @@index([refType, refId])
  @@index([lotId])
}

// Current-state cache per material per location — updated atomically with each StockMovement.
// StockMovement is the immutable ledger; StockLocationItem is the derived "what's here now + at what MAC".
model StockLocationItem {
  id             String   @id @default(cuid())
  locationId     String
  materialId     String
  qty            Decimal  @default(0) @db.Decimal(14, 3)
  movingAvgCost  Decimal  @default(0) @db.Decimal(14, 2) // Moving Average Cost (MAC) at this location
  lotId          String?  // if the material is lot-tracked, this links to a specific lot
  updatedAt      DateTime @updatedAt

  location StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  material Material      @relation(fields: [materialId], references: [id], onDelete: Restrict)
  lot      MaterialLot?  @relation(fields: [lotId], references: [id])

  @@unique([locationId, materialId])
  @@index([materialId])
  @@index([lotId])
}

model MaterialIssue {
  id             String   @id @default(cuid())
  // Slip number for the physical "Stock Issue" slip — SA-YYMMDD-NNNN.
  // Matches the client's paper system where every issue has a traceable number.
  issueNumber    String?  @unique
  // Consumption target — exactly one of projectId / departmentId is set
  // (enforced in the service layer + Zod). Project issues capitalise into
  // WIP; department issues hit Operating Expenses.
  projectId      String?
  departmentId   String?
  phaseId        String?
  builtUnitId    String?   // optional: issue directly to a specific built unit (cost goes to that unit's productionCost, not area-allocated)
  fromLocationId String
  subcontractorId String?
  issueDate      DateTime @default(now())
  issuedById     String?
  status         MaterialIssueStatus @default(COMPLETED)
  cancelledAt    DateTime?
  cancelledById  String?
  // Receiver accountability — who physically picked up the stock.
  // Matches the paper slip's "RECIEVER NAME" + "MOBILE NO." fields.
  receiverName   String?
  receiverMobile String?
  // Vehicle — how the goods were transported from store to site
  vehicleNumber  String?
  vehicleType    String?
  vehiclePhotoUrl String?
  driverName     String?
  driverPhone    String?
  notes          String?
  totalCost      Decimal  @default(0) @db.Decimal(14, 2)
  // Round-off to match physical bill totals (paper slip has "ROUNDOFF : 0.00")
  roundOff       Decimal  @default(0) @db.Decimal(14, 2)
  // Chargeable total = totalCost + roundOff (paper slip's "Amount Chargeable")
  totalAmount    Decimal  @default(0) @db.Decimal(14, 2)
  // DPR-Finance Bridge: link this issue back to the DPR that triggered it
  sourceDprId    String?  // null = manual issue (not from DPR)
  createdAt      DateTime @default(now())

  project       Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  department    Department?        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  phase         ProjectPhase?      @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  builtUnit     BuiltUnit?         @relation(fields: [builtUnitId], references: [id], onDelete: SetNull)
  fromLocation  StockLocation      @relation(fields: [fromLocationId], references: [id])
  subcontractor Subcontractor?     @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)
  issuedBy      User?              @relation(fields: [issuedById], references: [id])
  cancelledBy   User?              @relation("MaterialIssueCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  sourceDpr     DailyProgressReport? @relation("DprMaterialIssues", fields: [sourceDprId], references: [id], onDelete: SetNull)
  lines         MaterialIssueLine[]

  @@index([projectId])
  @@index([departmentId])
  @@index([fromLocationId])
  @@index([phaseId])
  @@index([builtUnitId])
  @@index([sourceDprId])
}

model MaterialIssueLine {
  id              String  @id @default(cuid())
  materialIssueId String
  materialId      String
  qty             Decimal @db.Decimal(14, 3)
  unitCost        Decimal @db.Decimal(14, 2)

  materialIssue MaterialIssue @relation(fields: [materialIssueId], references: [id], onDelete: Cascade)
  material      Material      @relation(fields: [materialId], references: [id])

  @@index([materialIssueId])
  @@index([materialId])
}

// ───────────────────────────────────────────────────────────
//  SCRAP / "CREATE" MATERIAL GENERATION — internally generated
//  material (e.g. cut-piece scrap from fabrication) added to stock
//  at a scrap valuation (typically lower than purchased material).
//  The SRS transcript calls this "Create" material — material that
//  comes into existence from a process, not from a purchase.
// ───────────────────────────────────────────────────────────

model ScrapGeneration {
  id              String   @id @default(cuid())
  companyId       String
  scrapNumber     String   @unique
  toLocationId    String   // where the scrap is stocked
  generationDate  DateTime @default(now())
  sourceMaterialId String?  // the original material from which scrap was generated (optional)
  projectId       String?   // the project/site where scrap was generated (optional)
  notes           String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  status          ScrapGenerationStatus @default(COMPLETED)
  cancelledAt     DateTime?
  cancelledById   String?

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  toLocation    StockLocation @relation(fields: [toLocationId], references: [id])
  sourceMaterial Material?    @relation("ScrapSourceMaterial", fields: [sourceMaterialId], references: [id], onDelete: SetNull)
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy     User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy   User?         @relation("ScrapCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  dprAutoScrap  DailyProgressReport? @relation("DprAutoScrap") // back-link if auto-generated from DPR variance
  lines         ScrapGenerationLine[]

  @@index([companyId])
  @@index([toLocationId])
  @@index([generationDate])
}

model ScrapGenerationLine {
  id                String  @id @default(cuid())
  scrapGenerationId String
  materialId        String
  qty               Decimal @db.Decimal(14, 3)
  unitCost          Decimal @db.Decimal(14, 2)  // scrap valuation (typically < original MAC)

  scrapGeneration ScrapGeneration @relation(fields: [scrapGenerationId], references: [id], onDelete: Cascade)
  material        Material        @relation(fields: [materialId], references: [id])

  @@index([scrapGenerationId])
  @@index([materialId])
}

enum StockTransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum MaterialIssueStatus {
  PENDING     // awaiting gate pass approval before stock movement
  COMPLETED
  CANCELLED
}

enum DirectPurchaseStatus {
  COMPLETED
  CANCELLED
}

enum ScrapGenerationStatus {
  COMPLETED
  CANCELLED
}

model StockTransfer {
  id             String              @id @default(cuid())
  fromLocationId String
  toLocationId   String
  transferDate   DateTime            @default(now())
  status         StockTransferStatus @default(DRAFT)
  notes          String?
  createdById    String?
  // Inter-company Stock Transfer Order (STO) fields. When from/to locations belong
  // to different companies (SPVs), isInterCompany=true and the destination receives
  // at a Transfer Price (TP) = source MAC + freight + handling + markup%, not at the
  // bare source MAC. This carries the inter-company markup into the destination's MAC.
  // Full inter-company AP/AR + consolidation elimination is a future GL concern; the
  // TP is captured here as the prerequisite. See transfer.ts · computeTransferPrice.
  isInterCompany     Boolean  @default(false)
  freight            Decimal  @default(0) @db.Decimal(14, 2) // header freight, allocated by line cost weight
  handlingFee        Decimal  @default(0) @db.Decimal(14, 2) // header handling, allocated by line cost weight
  markupPct          Decimal  @default(0) @db.Decimal(5, 2)   // inter-company markup % applied to each line base cost
  transferPriceTotal Decimal? @db.Decimal(14, 2)             // Σ line transfer totals — set on completion
  createdAt      DateTime            @default(now())

  // ── Dispatch + Receive proof (split DRAFT→IN_TRANSIT→COMPLETED) ──
  // Dispatch: source location marks goods as handed over to transport.
  // Receive: destination location confirms receipt with proof.
  dispatchedAt       DateTime?
  dispatchedById     String?
  // Receive proof at destination
  receivedAt         DateTime?
  receivedById       String?
  receiverSignature  String?   // base64 PNG of e-signature canvas
  receiverLat        Float?
  receiverLng        Float?
  receiverLocation   String?
  geoFenceOk         Boolean?  // true if receiver GPS is within destination location geoRadius
  geoFenceDistance   Float?    // distance in metres from destination center
  photos             Json?     // array of { url, fileName } — receive proof photos
  // Transport details for the transfer
  deliveryMode       String?   // OWN_VEHICLE | THIRD_PARTY | HAND_CARRY
  vehicleType        String?   // TRUCK | TEMPO | PICKUP | TRACTOR | HAND_CART | OTHER
  vehicleNumber      String?
  driverName         String?
  driverPhone        String?
  transporterName    String?
  // Dispatch documents
  challanNumber      String?
  packageCount       Int?
  shortageRemarks    String?
  damageRemarks      String?
  // Dispatch proof (accountability at source)
  dispatchPhotos     Json?     // array of { url, fileName } — photo of loaded vehicle
  dispatchSignature  String?   // base64 PNG — dispatcher e-signature
  // Supervisor co-signature at receive (dual signature)
  supervisorSignature String?  // base64 PNG
  supervisorId       String?
  // Weighbridge data (for bulk material transfers)
  weighbridgeTicketNo String?
  grossWeight        Decimal?  @db.Decimal(14, 3)
  tareWeight         Decimal?  @db.Decimal(14, 3)
  netWeight          Decimal?  @db.Decimal(14, 3)

  fromLocation StockLocation         @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation   StockLocation         @relation("TransferTo", fields: [toLocationId], references: [id])
  createdBy   User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  dispatchedBy User?                 @relation("TransferDispatcher", fields: [dispatchedById], references: [id], onDelete: SetNull)
  receivedBy  User?                  @relation("TransferReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  supervisor  User?                  @relation("TransferSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  lines        StockTransferLine[]

  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([createdById])
  @@index([isInterCompany])
}

model StockTransferLine {
  id              String  @id @default(cuid())
  stockTransferId String
  materialId      String
  qty             Decimal @db.Decimal(14, 3)
  // Partial receipt: qtyReceived tracks how much has actually arrived at the
  // destination. Defaults to 0. When the transfer completes, qtyReceived may
  // be < qty (shortage/damage in transit). The difference is recorded as shortage.
  qtyReceived     Decimal  @default(0) @db.Decimal(14, 3)
  // Captured at completion (inter-company only). unitCostAtSource = source MAC at
  // the moment of issue; unitTransferPrice = (base + freight + handling + markup)/qty;
  // lineTransferTotal = qty × unitTransferPrice. Null for intra-company transfers
  // (those carry the bare source MAC to the destination, no markup).
  unitCostAtSource   Decimal? @db.Decimal(14, 2)
  unitTransferPrice  Decimal? @db.Decimal(14, 2)
  lineTransferTotal  Decimal? @db.Decimal(14, 2)

  stockTransfer StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  material      Material      @relation(fields: [materialId], references: [id])

  @@index([stockTransferId])
  @@index([materialId])
}

enum StockCountStatus {
  DRAFT
  COUNTED
  RECONCILED
}

model StockCount {
  id          String           @id @default(cuid())
  locationId  String
  countDate   DateTime         @default(now())
  status      StockCountStatus @default(DRAFT)
  notes       String?
  createdAt   DateTime         @default(now())

  location StockLocation      @relation(fields: [locationId], references: [id])
  lines   StockCountLine[]

  @@index([locationId])
}

model StockCountLine {
  id           String  @id @default(cuid())
  stockCountId String
  materialId   String
  countedQty   Decimal @db.Decimal(14, 3)
  systemQty    Decimal @db.Decimal(14, 3)
  variance     Decimal @db.Decimal(14, 3)

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  material   Material   @relation(fields: [materialId], references: [id])

  @@index([stockCountId])
  @@index([materialId])
}

// ───────────────────────────────────────────────────────────
//  ASSET INVENTORY: Land (with partitioning) + Built Units
// ───────────────────────────────────────────────────────────

enum AreaUnit {
  SQFT
  SQM
  SQYD
  ACRE
  BIGHA
  KATHA
  HECTARE
}

enum LandPurchaseMode {
  WHOLE       // single parcel covering the full area
  SUBDIVIDED  // multiple sections created at purchase time
}

// Freehold = indefinite ownership (outright purchase)
// Leasehold = lease from authorities for a fixed period (e.g. 99 years)
enum LandType {
  FREEHOLD
  LEASEHOLD
}

// For leasehold land: how the lease rent is paid
enum LeaseType {
  ONE_TIME  // one-time upfront lease rent
  YEARLY    // recurring yearly lease rent
}

// ── Land Seller master ──
// Reusable seller records so the land purchase wizard can offer a dropdown
// of known sellers (with a "create" option) instead of free-text only.
// LandPurchase.sellerName / sellerContact remain as denormalized snapshots.
model LandSeller {
  id        String   @id @default(cuid())
  companyId String
  name      String
  phone     String?
  email     String?
  gstin     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  landPurchases LandPurchase[]

  @@unique([companyId, phone])
  @@index([companyId])
  @@index([companyId, deletedAt])
  @@index([name])
}

model LandPurchase {
  id           String   @id @default(cuid())
  companyId    String
  projectId    String?
  sellerId     String?  // → LandSeller (optional for backward compat; sellerName remains as snapshot)
  sellerName   String
  sellerContact String?
  purchaseDate DateTime @default(now())
  totalArea    Decimal  @db.Decimal(14, 3)
  areaUnit     AreaUnit @default(SQFT)
  totalCost    Decimal  @db.Decimal(14, 2)
  registryNo   String?
  location     String?
  documentUrl  String?
  // How the land was acquired: as a single whole plot or pre-subdivided
  // into sections at purchase time. Set by the guided wizard.
  mode         LandPurchaseMode @default(WHOLE)
  // ── Land type & lease details ──
  // FREEHOLD = outright purchase, indefinite ownership
  // LEASEHOLD = leased from authorities for a fixed term
  landType     LandType @default(FREEHOLD)
  leaseType    LeaseType?  // ONE_TIME or YEARLY (only for LEASEHOLD)
  leasePeriodYears Int?    // lease term in years (only for LEASEHOLD)
  leaseStartDate  DateTime? // lease commencement (only for LEASEHOLD)
  leaseEndDate    DateTime? // lease expiry (only for LEASEHOLD)
  // ── Cost breakup ──
  // totalCost = baseCost + leaseRentAmount + gstAmount + registrationAmount + stampDutyAmount
  // All percentages are user-entered (not fixed) and amounts auto-calculate.
  baseCost           Decimal  @default(0) @db.Decimal(14, 2) // the land price itself
  leaseRentPercent   Decimal? @db.Decimal(5, 2)  // % of baseCost (leasehold only)
  leaseRentAmount    Decimal? @db.Decimal(14, 2) // auto = baseCost × leaseRentPercent / 100
  gstPercent         Decimal? @db.Decimal(5, 2)  // % on lease rent (leasehold only)
  gstAmount          Decimal? @db.Decimal(14, 2) // auto = leaseRentAmount × gstPercent / 100
  registrationPercent Decimal? @db.Decimal(5, 2) // % of baseCost
  registrationAmount Decimal? @db.Decimal(14, 2) // auto = baseCost × registrationPercent / 100
  stampDutyPercent   Decimal? @db.Decimal(5, 2)  // % of baseCost
  stampDutyAmount    Decimal? @db.Decimal(14, 2) // auto = baseCost × stampDutyPercent / 100
  // ── Additional acquisition costs ──
  brokerageAmount    Decimal? @db.Decimal(14, 2) // broker commission (typically 1-2% of baseCost)
  legalFees          Decimal? @db.Decimal(14, 2) // lawyer / due diligence / title search fees
  otherCharges       Decimal? @db.Decimal(14, 2) // misc acquisition costs (EDC/IDC, conversion, etc.)
  createdById  String?
  createdAt    DateTime @default(now())
  deletedAt    DateTime?

  company Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  seller  LandSeller?  @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  parcels LandParcel[]
  legalDocuments LegalDocument[] @relation("LegalDocsLand")

  @@index([companyId])
  @@index([projectId])
  @@index([createdById])
  @@index([sellerId])
}

enum LandParcelStatus {
  AVAILABLE
  HOLD
  PARTITIONED
  RESERVED   // deposit received, sale pending
  SOLD
  RENTED
}

// Intent recorded at purchase time (guided wizard). SELL = plot earmarked
// for outright sale; PROJECT = plot assigned to a construction/development
// project (projectId will be set); HOLD = no specific purpose yet.
enum LandParcelPurpose {
  SELL
  PROJECT
  HOLD
}

model LandParcel {
  id              String           @id @default(cuid())
  landPurchaseId  String
  parentParcelId  String?
  number          String
  area            Decimal          @db.Decimal(14, 3)
  areaUnit        AreaUnit         @default(SQFT)
  status          LandParcelStatus @default(AVAILABLE)
  purpose         LandParcelPurpose @default(HOLD)
  acquisitionCost Decimal          @default(0) @db.Decimal(14, 2)
  askingPrice     Decimal?         @db.Decimal(14, 2)
  currentValuation Decimal         @default(0) @db.Decimal(14, 2)
  nrvWriteDown     Decimal         @default(0) @db.Decimal(14, 2) // NRV < cost → write-down amount
  // ── Infrastructure & market-value allocation ──
  // Flags non-saleable infrastructure plots (roads, parks, utility corridors).
  // Infrastructure plots have area but NO cost basis — their cost is absorbed
  // by the saleable siblings during partition.
  isInfrastructure Boolean         @default(false)
  // Optional target market value for weighted (MARKET_VALUE) cost allocation.
  marketValue      Decimal?        @db.Decimal(15, 2)
  // Optional custom weighting index used by the MARKET_VALUE allocation model.
  weightFactor     Decimal?        @db.Decimal(5, 2)
  saleId          String? @unique
  projectId       String?
  /// Polygon vertices in normalized [0,1] coordinates relative to the parcel's
  /// bounding box. Stored as [{x,y},...]. null for parcels created without the
  /// CAD canvas (form-based partition). Used by the partition canvas to render
  /// and further subdivide existing parcels.
  geometry        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  landPurchase LandPurchase  @relation(fields: [landPurchaseId], references: [id], onDelete: Cascade)
  parentParcel LandParcel?   @relation("ParcelChildren", fields: [parentParcelId], references: [id])
  children     LandParcel[]  @relation("ParcelChildren")
  partitions    LandPartition[]
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  builtUnits   BuiltUnit[]   @relation("LandParcelBuiltUnits")
  renovations   RenovationProject[]
  sale         AssetSale?    @relation("LandParcelSale", fields: [saleId], references: [id], onDelete: SetNull)
  assetSales   AssetSale[]   @relation("AssetSaleLandParcel")

  @@index([landPurchaseId])
  @@index([parentParcelId])
  @@index([status])
  @@index([saleId])
  @@index([landPurchaseId, status])
  @@unique([landPurchaseId, number])
}

model LandPartition {
  id              String   @id @default(cuid())
  parentParcelId  String
  partitionDate   DateTime @default(now())
  childCount      Int
  notes           String?
  // ── Allocation model & development costs ──
  // "PRO_RATA" = cost allocated strictly by area (excluding infrastructure).
  // "MARKET_VALUE" = cost allocated by area × weightFactor per saleable plot.
  allocationModel  String   @default("PRO_RATA")
  // Total area of non-saleable infrastructure plots created in this partition.
  infrastructureArea Decimal? @db.Decimal(12, 2)
  // Site development costs (grading, paving, utilities) added to the parent
  // cost basis before allocation across saleable children.
  developmentCost Decimal? @db.Decimal(15, 2)

  parentParcel LandParcel @relation(fields: [parentParcelId], references: [id], onDelete: Cascade)

  @@index([parentParcelId])
}

enum BuiltUnitType {
  BHK_1
  BHK_2
  BHK_3
  BHK_4
  SHOP
  OFFICE
  WAREHOUSE_UNIT
  VILLA
  OTHER
}

enum BuiltUnitStatus {
  PLANNED
  UNDER_CONSTRUCTION
  AVAILABLE
  RESERVED   // deposit received, sale pending
  HOLD
  SOLD
  RENTED
}

// How a built unit entered the real estate inventory:
// CREATED — built by us (construction costs accumulate via WIP → capitalization)
// PURCHASED — bought as-is (acquisitionCost is the cost basis, no WIP)
enum UnitOrigin {
  CREATED
  PURCHASED
}

model BuiltUnit {
  id              String           @id @default(cuid())
  projectId       String
  phaseId         String?
  unitType        BuiltUnitType
  unitNumber      String
  floor           Int?
  wing            String?
  area            Decimal          @db.Decimal(14, 3)
  areaUnit        AreaUnit         @default(SQFT)
  // ── RERA compliance fields (all nullable — backward compatible) ──
  // carpetArea: RERA-defined carpet area (usable internal floor area)
  // superBuiltUpArea: saleable area (carpet + walls + balcony + common share)
  // balconyArea: external balcony area
  // clearHeight: floor-to-ceiling height (warehouse/industrial)
  // hasLoadingDock: industrial/warehouse units
  carpetArea       Decimal?         @db.Decimal(14, 3)
  superBuiltUpArea Decimal?         @db.Decimal(14, 3)
  balconyArea      Decimal?         @db.Decimal(14, 3)
  clearHeight      Decimal?         @db.Decimal(14, 3)
  hasLoadingDock   Boolean          @default(false)
  status          BuiltUnitStatus  @default(PLANNED)
  // ── Origin tracking ──
  // CREATED: built by us — productionCost accumulates via material issues + cost allocation
  // PURCHASED: bought as-is — acquisitionCost is the purchase price, status starts AVAILABLE
  originType      UnitOrigin       @default(CREATED)
  acquisitionCost Decimal          @default(0) @db.Decimal(14, 2) // purchase price (PURCHASED units only)
  purchaseDate    DateTime?        // when a PURCHASED unit was acquired
  landParcelId    String?          // link to the plot/parcel this unit is built on (subdivided inventory)
  productionCost  Decimal          @default(0) @db.Decimal(14, 2)
  askingPrice     Decimal?         @db.Decimal(14, 2)
  currentValuation Decimal         @default(0) @db.Decimal(14, 2)
  nrvWriteDown    Decimal          @default(0) @db.Decimal(14, 2) // NRV < cost → write-down amount
  capitalizedAmount Decimal        @default(0) @db.Decimal(14, 2) // total WIP capitalized to this unit (for idempotency)
  saleId          String? @unique
  // Optimistic locking — see Material.version comment
  version         Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase   ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  landParcel LandParcel? @relation("LandParcelBuiltUnits", fields: [landParcelId], references: [id], onDelete: SetNull)
  sale     AssetSale?   @relation("BuiltUnitSale", fields: [saleId], references: [id], onDelete: SetNull)
  assetSales     AssetSale[]  @relation("AssetSaleBuiltUnit")
  renovations   RenovationProject[]
  portalListings PortalListing[]
  interestedLeads Lead[]
  materialIssues MaterialIssue[]

  @@index([projectId])
  @@index([phaseId])
  @@index([landParcelId])
  @@index([status])
  @@index([unitType])
  @@index([originType])
  @@index([saleId])
  @@unique([projectId, unitNumber])
}

// ───────────────────────────────────────────────────────────
//  PORTAL LISTINGS — sync built units to property portals like
//  99acres, MagicBricks, Housing.com. The provider is pluggable
//  (see services/portal-listing.ts) — a stub provider logs the
//  listing; a real provider would call the portal's API.
// ───────────────────────────────────────────────────────────

model PortalListing {
  id              String   @id @default(cuid())
  companyId       String
  builtUnitId     String
  portalName      String   // "99acres", "MagicBricks", "Housing.com"
  listingId       String?  // the portal's assigned listing ID (on success)
  listingUrl      String?  // public URL on the portal
  status          PortalListingStatus @default(DRAFT)
  title           String
  description     String?
  askingPrice     Decimal  @db.Decimal(14, 2)
  bedrooms        Int?
  bathrooms       Int?
  area            Decimal  @db.Decimal(14, 3)
  areaUnit        AreaUnit @default(SQFT)
  floor           Int?
  furnishing      String?  // "Furnished", "Semi-Furnished", "Unfurnished"
  photos          String[] // array of photo URLs
  listedAt        DateTime?
  delistedAt      DateTime?
  lastSyncedAt    DateTime?
  syncError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  builtUnit  BuiltUnit  @relation(fields: [builtUnitId], references: [id], onDelete: Cascade)

  @@unique([builtUnitId, portalName])  // one listing per unit per portal
  @@index([companyId, status])
  @@index([portalName, status])
}

enum PortalListingStatus {
  DRAFT       // created locally, not yet pushed to portal
  LISTED      // actively listed on the portal
  DELISTED    // removed from the portal
  SYNC_FAILED // last sync attempt failed (see syncError)
}

// ───────────────────────────────────────────────────────────
//  EQUIPMENT & TOOLS: discrete, trackable, transferable assets
//  (NOT fungible like materials — an excavator is unique, not a quantity)
// ───────────────────────────────────────────────────────────

enum EquipmentStatus {
  AVAILABLE     // in warehouse, not assigned
  ASSIGNED      // at a project site
  IN_MAINTENANCE
  RETIRED
}

model Equipment {
  id              String          @id @default(cuid())
  assetTag        String          @unique // physical tag/QR on the equipment
  name            String
  model           String?
  serialNumber    String?
  category        String?         // e.g. "Heavy Machinery", "Power Tool", "Vehicle"
  companyId       String
  status          EquipmentStatus @default(AVAILABLE)
  acquisitionCost Decimal         @default(0) @db.Decimal(14, 2)
  currentValue    Decimal         @default(0) @db.Decimal(14, 2) // after depreciation
  purchaseDate    DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assignments EquipmentAssignment[]
  maintenance EquipmentMaintenance[]

  @@index([companyId])
  @@index([status])
}

enum EquipmentAssignmentStatus {
  ACTIVE
  RETURNED
}

model EquipmentAssignment {
  id          String                  @id @default(cuid())
  equipmentId String
  locationId  String                  // where it's currently stationed
  projectId   String?
  assignedAt  DateTime                @default(now())
  returnedAt  DateTime?
  status      EquipmentAssignmentStatus @default(ACTIVE)
  notes       String?

  equipment Equipment     @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  location  StockLocation @relation(fields: [locationId], references: [id])
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([equipmentId])
  @@index([locationId])
  @@index([projectId])
}

enum MaintenanceType {
  SCHEDULED
  REPAIR
  INSPECTION
}

model EquipmentMaintenance {
  id          String         @id @default(cuid())
  equipmentId String
  type        MaintenanceType
  startDate   DateTime       @default(now())
  endDate     DateTime?
  cost        Decimal        @default(0) @db.Decimal(14, 2)
  vendor      String?
  notes       String?
  createdAt   DateTime       @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
}

// ───────────────────────────────────────────────────────────
//  MATERIAL REQUISITION: request → approve → convert to PO
//  (planning layer before procurement)
// ───────────────────────────────────────────────────────────

enum RequisitionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  CONVERTED  // turned into a PurchaseOrder
  REJECTED
}

model MaterialRequisition {
  id          String           @id @default(cuid())
  reqNumber   String           @unique
  projectId   String?          // optional — for department-scoped requisitions (rice mill)
  departmentId String?         // set when the requisition is for a department (cost center)
  phaseId     String?
  requestedById String?
  status      RequisitionStatus @default(DRAFT)
  requestDate DateTime         @default(now())
  neededByDate DateTime?
  notes       String?
  convertedPoId String?        // set when converted to a PO
  // Logistics Decision Engine output — computed on submit, used to recommend
  // procurementScope (COMPANY vs PROJECT) at PO conversion. See procurement-routing.ts.
  lciDecision  Json?           // { perLine, recommendedScope, threshold, weights, computedAt, ... }
  // Approval workflow — SUBMITTED → APPROVED requires requisition.approve
  approvedById String?
  approvedAt   DateTime?
  approvalNotes String?
  rejectedById  String?
  rejectedAt    DateTime?
  rejectReason  String?
  // ── Comparative Quote Engine ──
  // The SRS mandates that purchasers upload ≥3 vendor quotes before a requisition
  // can be converted to a PO. minQuotesRequired (default 3) is the gate; quotesWaived
  // lets an approver (po.approve) bypass the gate for low-value/emergency buys.
  minQuotesRequired Int      @default(3)
  quotesWaived       Boolean  @default(false)
  quotesWaivedById   String?
  quotesWaivedReason String?
  quotesWaivedAt     DateTime?
  quotesLockedAt     DateTime? // set when a winning quote is selected
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  project     Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  department  Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  phase       ProjectPhase?    @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  requestedBy User?            @relation("ReqRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy  User?            @relation("ReqApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy  User?            @relation("ReqRejecter", fields: [rejectedById], references: [id], onDelete: SetNull)
  quotesWaivedBy User?         @relation("ReqQuoteWaiver", fields: [quotesWaivedById], references: [id], onDelete: SetNull)
  lines       MaterialRequisitionLine[]
  vendorQuotes VendorQuote[]

  @@index([projectId])
  @@index([departmentId])
  @@index([status])
  @@index([approvedById])
}

model MaterialRequisitionLine {
  id              String  @id @default(cuid())
  requisitionId   String
  materialId      String
  qtyRequested    Decimal @db.Decimal(14, 3)
  notes           String?
  // Demand-slip enrichment — snapshots taken at creation time so the
  // approver sees what the requester saw, even if stock changes later.
  // Matches the paper "Demand Slip" which shows closing stock + supplier + last rate.
  preferredSupplierId String?  // which supplier the requester wants to buy from
  currentStock    Decimal? @db.Decimal(14, 3)  // stock-on-hand snapshot at demand time
  lastRate        Decimal? @db.Decimal(14, 2)  // last purchase rate snapshot
  lastRateDate    DateTime?                    // date of the last purchase

  requisition MaterialRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  material    Material            @relation(fields: [materialId], references: [id])
  preferredSupplier Supplier?     @relation(fields: [preferredSupplierId], references: [id], onDelete: SetNull)

  @@index([requisitionId])
  @@index([materialId])
}

// ───────────────────────────────────────────────────────────
//  COMPARATIVE QUOTE ENGINE — purchasers must collect ≥3 vendor
//  quotes (PDF/image uploads) per requisition. The system flags the
//  cheapest (by landed, delivered-to-site total). An approver selects
//  the winning quote; the requisition→PO conversion auto-fills line
//  costs from it. Quotes are locked once a winner is selected.
//  (SRS §3 "Comparative Analysis", workflow §6.)
// ───────────────────────────────────────────────────────────

enum QuoteStatus {
  PENDING    // uploaded, awaiting selection
  SELECTED   // chosen as the winning quote by an approver
  REJECTED   // explicitly not chosen (informational)
}

// Delivery basis — determines who bears the transport cost.
// This is critical for fair comparison: an ex-works quote at ₹90/unit
// + ₹15/unit buyer transport = ₹105/unit true landed, which is MORE
// than a delivered quote at ₹100/unit. The system must account for
// this when flagging the cheapest quote.
enum DeliveryTerms {
  DELIVERED_SITE  // supplier delivers to site (freight included in quote)
  EX_WORKS        // buyer picks up from supplier (buyer bears full transport)
  FOR_STATION     // supplier delivers to nearest depot, buyer arranges onward
  CUSTOM          // other — see deliveryTerms for details
}

model VendorQuote {
  id            String      @id @default(cuid())
  requisitionId String?
  supplierId    String
  // The uploaded quote document (PDF/image/Excel) — URL returned by /api/uploads.
  // Optional: not all quotes arrive as files (verbal, email text, WhatsApp text).
  // When null, quoteSource must be set and sourceNote should explain the origin.
  fileUrl       String?
  fileName      String?
  mimeType      String?
  // How this quote was received — DOCUMENT (file upload), EMAIL, VERBAL, etc.
  quoteSource   QuoteSource @default(DOCUMENT)
  // Free-text note explaining the source for non-document quotes.
  // e.g. "Verbal quote from Ramesh (Ambuja) on 15-Aug-2026 over phone"
  sourceNote    String?
  // Landed total = delivered-to-site price (per the transcript: "delivery at
  // site"). This is the figure used for cheapest-quote comparison. The
  // per-line breakdown (VendorQuoteLine) sums up to this for transparency.
  landedTotal   Decimal     @db.Decimal(14, 2)
  // Computed breakdown — sum of the per-line fields. The service computes
  // these from the lines so the header always matches the detail.
  subtotal      Decimal     @default(0) @db.Decimal(14, 2) // Σ lineSubtotal (qty × unitPrice, ex-GST)
  gstTotal      Decimal     @default(0) @db.Decimal(14, 2) // Σ gstAmount
  freightTotal  Decimal     @default(0) @db.Decimal(14, 2) // Σ (freightPerUnit × qty)
  handlingTotal Decimal     @default(0) @db.Decimal(14, 2) // Σ (handlingPerUnit × qty)
  discountTotal Decimal     @default(0) @db.Decimal(14, 2) // Σ (discountPerUnit × qty)
  packingTotal  Decimal     @default(0) @db.Decimal(14, 2) // Σ (packingPerUnit × qty)
  loadingTotal  Decimal     @default(0) @db.Decimal(14, 2) // Σ (loadingPerUnit × qty)
  insuranceTotal Decimal    @default(0) @db.Decimal(14, 2) // Σ (insurancePerUnit × qty)
  // Σ (buyerTransportPerUnit × qty) — buyer's own transport cost for ex-works/FOR quotes
  buyerTransportTotal Decimal @default(0) @db.Decimal(14, 2)
  currency      String      @default("INR")
  validUntil    DateTime?
  // ── Commercial terms (per the real-world Comparative Statement format) ──
  // These are captured per-quote and shown side-by-side in the comparison.
  // They often override pure price: "30 days credit at a higher rate beats
  // advance payment at a lower one" (SiteSetu procurement guide).
  paymentTerms    String?  // e.g. "30 days credit", "50% advance, balance on delivery"
  // Structured delivery basis — determines who bears the transport cost.
  // Used by the comparative analysis to normalize quotes on different bases.
  deliveryTermsType DeliveryTerms @default(DELIVERED_SITE)
  // Free-text delivery terms detail (legacy field, kept for back-compat).
  // e.g. "FOR site", "ex-works Ambuja factory, Nimbahera", "freight extra at actuals"
  deliveryTerms   String?
  leadTimeDays    Int?     // delivery lead time in days from PO date
  warranty        String?  // e.g. "12 months", "as per manufacturer"
  // Computed by recomputeCheapest(): true when this quote has the lowest
  // landedTotal among all PENDING/SELECTED quotes for the requisition.
  isCheapest    Boolean     @default(false)
  status        QuoteStatus @default(PENDING)
  // Selection audit trail — who picked this quote, when, and why (the
  // approver may override the cheapest recommendation with a reason).
  selectedById  String?
  selectedAt    DateTime?
  selectionReason String?
  submittedById String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Standalone quotation request — when this quote is attached to a
  // QuotationRequest instead of a MaterialRequisition. Nullable for
  // back-compat with the existing requisition-attached quotes.
  quotationRequestId String?

  requisition  MaterialRequisition? @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  submittedBy  User?               @relation("QuoteSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  selectedBy   User?               @relation("QuoteSelector", fields: [selectedById], references: [id], onDelete: SetNull)
  quotationRequest QuotationRequest? @relation("QuotationRequestQuotes", fields: [quotationRequestId], references: [id], onDelete: Cascade)
  selectedForRequest QuotationRequest? @relation("QuotationRequestSelectedQuote")
  lines        VendorQuoteLine[]
  purchaseOrders PurchaseOrder[] @relation("POSelectedQuote")

  @@index([requisitionId])
  @@index([quotationRequestId])
  @@index([supplierId])
  @@index([status])
}

model VendorQuoteLine {
  id          String   @id @default(cuid())
  vendorQuoteId String
  materialId  String
  qty         Decimal  @db.Decimal(14, 3)
  unitPrice   Decimal  @db.Decimal(14, 2) // basic per-unit price (ex-GST, ex-freight)
  // GST snapshot — inherited from Material at quote creation time so the
  // quote keeps its original tax basis even if the material master changes.
  hsnCode     String?
  gstRate     Decimal  @default(0) @db.Decimal(5, 2)
  gstAmount   Decimal  @default(0) @db.Decimal(14, 2) // qty × unitPrice × gstRate / 100
  // Per-unit landed-cost components — full real-world landed cost:
  //   taxableValue = unitPrice − discount + packingForwarding
  //   landedCost   = taxableValue + GST + freight + loadingUnloading + transitInsurance
  discountPerUnit    Decimal @default(0) @db.Decimal(14, 2) // discount per unit (reduces taxable value)
  packingPerUnit     Decimal @default(0) @db.Decimal(14, 2) // packing & forwarding per unit
  freightPerUnit     Decimal @default(0) @db.Decimal(14, 2) // transport cost per unit (supplier-quoted)
  loadingPerUnit     Decimal @default(0) @db.Decimal(14, 2) // loading/unloading per unit (separate from freight)
  insurancePerUnit   Decimal @default(0) @db.Decimal(14, 2) // transit insurance per unit
  handlingPerUnit    Decimal @default(0) @db.Decimal(14, 2) // misc handling per unit (legacy compat)
  // Buyer-borne transport cost per unit — entered when deliveryTermsType = EX_WORKS
  // or FOR_STATION. This is the buyer's OWN estimated transport cost (arranging their
  // own truck, etc.), separate from any supplier-quoted freightPerUnit. Included in
  // unitLandedCost so the comparative analysis normalizes quotes on different delivery bases.
  buyerTransportPerUnit Decimal @default(0) @db.Decimal(14, 2)
  // The headline number — per-piece all-in landed cost:
  //   unitLandedCost = (unitPrice − discount + packing) × (1 + gstRate/100) + freight + loading + insurance + handling
  unitLandedCost Decimal @default(0) @db.Decimal(14, 2)
  taxableValue   Decimal @default(0) @db.Decimal(14, 2) // (unitPrice − discount + packing) × qty
  lineSubtotal   Decimal @default(0) @db.Decimal(14, 2) // qty × unitPrice (ex-everything)
  lineTotal      Decimal @db.Decimal(14, 2) // qty × unitLandedCost (full landed)

  vendorQuote VendorQuote @relation(fields: [vendorQuoteId], references: [id], onDelete: Cascade)
  material    Material    @relation(fields: [materialId], references: [id])

  @@index([vendorQuoteId])
  @@index([materialId])
}

// ───────────────────────────────────────────────────────────
//  HSN / SAC MASTER — government-provided HSN codes with their
//  GST rates. Seeded from CBIC data. The system auto-picks the
//  GST rate when a material's HSN code is entered, so users never
//  have to look up the rate manually.
// ───────────────────────────────────────────────────────────

model HsnGstRate {
  id          String   @id @default(cuid())
  hsnCode     String   @unique
  description String
  gstRate     Decimal  @db.Decimal(5, 2)
  sacCode     String?  // Service Accounting Code (for services)
  category    String?  // "Goods" | "Services"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([hsnCode])
  @@index([category])
}

// ───────────────────────────────────────────────────────────
//  STANDALONE QUOTATION REQUEST — an employee asks for prices on
//  a bundle of materials, then uploads/fills quotes from multiple
//  suppliers against it. The comparative analysis (per-piece landed
//  cost across suppliers) lives on the request itself. Approval is
//  done by the submitter's direct reporting manager (one hierarchy
//  level up via UserCompany.reportsToUserCompanyId), not by anyone
//  with a permission flag.
// ───────────────────────────────────────────────────────────

enum QuotationRequestStatus {
  OPEN            // collecting quotes
  QUOTES_COLLECTED // min quotes met, ready for approval
  APPROVED        // manager selected the winner
  CLOSED          // converted to PO / no longer needed
  CANCELLED
}

// How a vendor quote was received — not all quotes arrive as uploaded files.
// Suppliers quote via WhatsApp, email text, verbal over phone, printed letters,
// Excel rate lists, etc. The structured price data (per-line) is what matters;
// the file is evidence, not the data itself.
enum QuoteSource {
  DOCUMENT    // PDF or photo upload (the default — backwards compatible)
  EMAIL       // rates received in email body (no file)
  VERBAL      // quoted over phone (no file — sourceNote mandatory)
  WHATSAPP    // screenshot or text from WhatsApp (may or may not have file)
  LETTER      // printed/handwritten letter (photo upload)
  EXCEL       // Excel/CSV rate list upload
}

model QuotationRequest {
  id              String   @id @default(cuid())
  requestNumber   String   @unique // QR-YYMMDD-NNNN
  companyId       String
  projectId       String?  // optional — site this is being bought for
  title           String
  notes           String?
  status          QuotationRequestStatus @default(OPEN)
  minQuotesRequired Int    @default(3)
  // ── Real-world procurement context ──
  // Required-by date: when the site needs this material. Drives urgency
  // and delivery planning. Without this, procurement is disconnected from
  // the project schedule.
  requiredByDate  DateTime?
  // Work activity / BOQ link: what site activity is this material for?
  // e.g. "third-floor slab casting", "blockwork", "internal plaster".
  // Connects procurement to project execution and BOQ reconciliation.
  workActivity    String?
  // ── Destination location (user-chosen, not auto-guessed) ──
  // The site engineer picks WHERE the material should be delivered. This
  // can be any location in the company GROUP (parent's central warehouse,
  // current company's project site, child company's warehouse, etc.).
  // The auto-created PO's companyId = this location's companyId, so the
  // PO and stock live in the company that owns the warehouse.
  destinationLocationId String?

  // Who submitted it (the employee asking for prices)
  submittedById          String
  submittedByUserCompanyId String // the UserCompany membership row of the submitter
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Approval — ONLY the direct manager (one level up the reporting chain)
  approvedById             String?
  approvedByUserCompanyId  String?
  approvedAt               DateTime?
  approvalReason           String? // required if overriding the cheapest

  // The winner (selected by the approver)
  selectedQuoteId String? @unique
  // Auto-created PO after hierarchical approval — null until approved.
  convertedPoId   String?  @unique

  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  convertedPo    PurchaseOrder? @relation("QuotationConvertedPo", fields: [convertedPoId], references: [id], onDelete: SetNull)
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  destinationLocation StockLocation? @relation("QuotationRequestDestination", fields: [destinationLocationId], references: [id], onDelete: SetNull)
  submittedBy    User      @relation("QuotationRequestSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)
  approvedBy     User?     @relation("QuotationRequestApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  lines          QuotationRequestLine[]
  quotes         VendorQuote[]           @relation("QuotationRequestQuotes")
  selectedQuote  VendorQuote?            @relation("QuotationRequestSelectedQuote", fields: [selectedQuoteId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([projectId])
  @@index([submittedById])
  @@index([status])
}

model QuotationRequestLine {
  id                  String   @id @default(cuid())
  quotationRequestId  String
  materialId          String
  qtyRequired         Decimal  @db.Decimal(14, 3)
  // HSN + GST auto-filled from Material at creation time (snapshot)
  hsnCode             String?
  gstRate             Decimal  @default(0) @db.Decimal(5, 2)

  quotationRequest    QuotationRequest @relation(fields: [quotationRequestId], references: [id], onDelete: Cascade)
  material            Material         @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([quotationRequestId])
  @@index([materialId])
}

// ───────────────────────────────────────────────────────────
//  RETURNS TO SUPPLIER: defective/excess materials sent back
// ───────────────────────────────────────────────────────────

enum SupplierReturnStatus {
  DRAFT
  SUBMITTED
  COMPLETED  // goods left, credit note received
  CANCELLED
}

model SupplierReturn {
  id           String              @id @default(cuid())
  returnNumber String              @unique
  supplierId   String
  companyId    String
  purchaseOrderId String?          // original PO (if return against a PO)
  locationId   String              // where goods are leaving from
  status       SupplierReturnStatus @default(DRAFT)
  returnDate   DateTime            @default(now())
  creditNoteNo String?
  // Vehicle — how the goods are being sent back to the supplier
  vehicleNumber  String?
  vehicleType    String?
  vehiclePhotoUrl String?
  driverName     String?
  driverPhone    String?
  notes        String?
  createdById  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  location      StockLocation @relation(fields: [locationId], references: [id])
  createdBy     User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines         SupplierReturnLine[]

  @@index([supplierId])
  @@index([companyId])
  @@index([status])
  @@index([createdById])
}

model SupplierReturnLine {
  id               String  @id @default(cuid())
  supplierReturnId String
  materialId       String
  qty              Decimal @db.Decimal(14, 3)
  unitCost         Decimal @db.Decimal(14, 2) // cost at which it was received (for credit calc)
  reason           String? // "Defective", "Excess", "Wrong item"

  supplierReturn SupplierReturn @relation(fields: [supplierReturnId], references: [id], onDelete: Cascade)
  material       Material       @relation(fields: [materialId], references: [id])

  @@index([supplierReturnId])
  @@index([materialId])
}

// ───────────────────────────────────────────────────────────
//  DIRECT PURCHASES: simplified purchase log for local/ad-hoc
//  buys that don't warrant a formal Purchase Order. Matches the
//  client's paper "Purchase Register" (P-XXXXX) — supplier name,
//  bill date, bill amount, optional line items. If lines specify
//  materials + qty + rate, stock is received into the location.
// ───────────────────────────────────────────────────────────

model DirectPurchase {
  id           String   @id @default(cuid())
  billNumber   String   @unique  // P-000461
  supplierId   String?
  supplierName String              // ad-hoc name (when supplier not in master)
  companyId    String
  locationId   String              // where goods were received
  billDate     DateTime
  subtotal     Decimal  @default(0) @db.Decimal(14, 2)
  gstTotal     Decimal  @default(0) @db.Decimal(14, 2)
  roundOff     Decimal  @default(0) @db.Decimal(14, 2)
  billAmount   Decimal  @default(0) @db.Decimal(14, 2) // subtotal + gstTotal + roundOff
  // Vehicle — how the goods were brought from the local market
  vehicleNumber  String?
  vehicleType    String?
  vehiclePhotoUrl String?
  driverName     String?
  driverPhone    String?
  notes        String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  status         DirectPurchaseStatus @default(COMPLETED)
  cancelledAt    DateTime?
  cancelledById  String?

  supplier     Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  location     StockLocation  @relation(fields: [locationId], references: [id])
  createdBy    User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy  User?          @relation("DirectPurchaseCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  lines        DirectPurchaseLine[]

  @@index([companyId])
  @@index([supplierId])
  @@index([billDate])
}

model DirectPurchaseLine {
  id               String  @id @default(cuid())
  directPurchaseId String
  materialId       String
  qty              Decimal @db.Decimal(14, 3)
  unitCost         Decimal @db.Decimal(14, 2)
  gstRate          Decimal @default(0) @db.Decimal(5, 2)
  lineTotal        Decimal @default(0) @db.Decimal(14, 2) // qty × unitCost + gstAmount

  directPurchase DirectPurchase @relation(fields: [directPurchaseId], references: [id], onDelete: Cascade)
  material       Material       @relation(fields: [materialId], references: [id])

  @@index([directPurchaseId])
  @@index([materialId])
}

// ───────────────────────────────────────────────────────────
//  SALES: customers, asset sales, payments
// ───────────────────────────────────────────────────────────

enum LeadSource {
  PORTAL
  WALK_IN
  REFERRAL
  BROKER
  DIGITAL_AD
  OTHER
}

enum LeadStage {
  NEW
  CONTACTED
  SITE_VISIT
  NEGOTIATION
  BOOKED
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  HOT
}

enum LeadActivityType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  SITE_VISIT
  NOTE
  STAGE_CHANGE
}

model Lead {
  id                  String       @id @default(cuid())
  companyId           String
  projectId           String?
  interestedUnitId    String?
  assignedToId        String?
  convertedCustomerId String?
  name                String
  phone               String
  email               String?
  source              LeadSource
  stage               LeadStage    @default(NEW)
  priority            LeadPriority @default(MEDIUM)
  score               Int          @default(0)
  budgetMin           Decimal?     @db.Decimal(14, 2)
  budgetMax           Decimal?     @db.Decimal(14, 2)
  interestedUnitType  String?
  notes               String?
  nextFollowUpAt      DateTime?
  lastContactAt       DateTime?
  lostReason          String?
  convertedAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?

  company           Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project           Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  interestedUnit    BuiltUnit? @relation(fields: [interestedUnitId], references: [id], onDelete: SetNull)
  assignedTo        User?      @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  convertedCustomer Customer?  @relation(fields: [convertedCustomerId], references: [id], onDelete: SetNull)
  activities        LeadActivity[]

  @@index([companyId, stage])
  @@index([assignedToId, stage])
  @@index([projectId])
  @@index([interestedUnitId])
  @@index([phone])
  @@index([nextFollowUpAt])
  @@index([deletedAt])
}

model LeadActivity {
  id             String           @id @default(cuid())
  leadId         String
  type           LeadActivityType
  note           String?
  outcome        String?
  occurredAt     DateTime         @default(now())
  nextFollowUpAt DateTime?
  createdById    String?
  createdAt      DateTime         @default(now())

  lead      Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User? @relation("LeadActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([leadId, occurredAt])
  @@index([createdById])
}

model Customer {
  id        String   @id @default(cuid())
  companyId String
  name      String
  phone     String?
  email     String?
  gstin     String?
  address   String?
  // Optimistic locking — see Material.version comment
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assetSales     AssetSale[]
  materialSales  MaterialSale[]
  tenancies      Tenancy[]
  convertedLeads Lead[]

  @@unique([companyId, phone])
  @@index([companyId])
  @@index([companyId, deletedAt])
  @@index([name])
}

enum AssetType {
  LAND
  BUILT_UNIT
  PROJECT
}

// ── Sale expense heads (registry, stamp duty, transfer, lease rent, GST, other) ──
// Same heads as land purchase, but on the SELL side. Each row has a 3-way
// "borne by" toggle: CLIENT (buyer pays), SELLER (seller absorbs), NA (not applicable).
enum SaleExpenseHead {
  REGISTRY
  STAMP_DUTY
  TRANSFER
  LEASE_RENT
  GST
  OTHER
}

enum ExpenseBorneBy {
  CLIENT
  SELLER
  NA
}

// ── Deal source — who brought the deal ──
enum DealSource {
  SELF
  BROKER
}

enum SaleStatus {
  PENDING     // material sale awaiting gate pass approval before stock movement
  ACTIVE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

model AssetSale {
  id            String        @id @default(cuid())
  saleNumber    String        @unique
  assetType     AssetType
  landParcelId  String?
  builtUnitId   String?
  customerId    String
  projectId     String?
  companyId     String
  salePrice     Decimal       @db.Decimal(14, 2)
  gstRate       Decimal       @default(0) @db.Decimal(5, 2) // GST % applied on sale (e.g. 1, 5, 18)
  gstAmount     Decimal       @default(0) @db.Decimal(14, 2) // computed GST = salePrice × gstRate / 100
  costBasis     Decimal       @default(0) @db.Decimal(14, 2) // acquisitionCost (land) or productionCost (unit) at time of sale
  profit        Decimal       @default(0) @db.Decimal(14, 2) // salePrice - costBasis
  saleDate      DateTime      @default(now())
  status        SaleStatus    @default(ACTIVE)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMode   String?
  notes         String?
  // ── Deposit liability accounting ──
  // Real estate sales are staged: PENDING → DEPOSIT_RECEIVED → COMPLETED (or CANCELLED).
  // A customer deposit is recorded as a liability (Customer Deposit account) —
  // revenue + COGS are NOT recognised until the sale completes (final payment + title transfer).
  saleStage       String      @default("PENDING") // PENDING | DEPOSIT_RECEIVED | COMPLETED | CANCELLED
  depositAmount   Decimal?    @db.Decimal(14, 2)   // initial customer deposit
  depositDate     DateTime?                          // when deposit was received
  finalSaleDate   DateTime?                          // when final payment + title transfer happened
  // ── Sale deed / registry tracking ──
  // A sale starts as an ATS (Agreement to Sell) — booking amount paid, registry deferred.
  // When the sale deed is registered, saleDeedNo is captured and saleStage → COMPLETED.
  saleDeedNo        String?                           // sale deed / registry number (set when registry is done)
  expectedRegistryDate DateTime?                     // when the full registry is expected (if ATS / not yet registered)
  // ── Sale compliance documents ──
  allotmentLetterNo  String?    // allotment letter number (issued at booking)
  allotmentDate      DateTime?  // date allotment letter was issued
  bbaNo              String?    // Builder-Buyer Agreement number (RERA mandates within 45 days of booking)
  bbaDate            DateTime?  // date BBA was executed
  // ── TDS tracking (sales > ₹50L, buyer deducts 1% TDS) ──
  tdsAmount          Decimal?   @db.Decimal(14, 2)  // TDS amount deducted by buyer
  tdsCertificateNo   String?    // TDS certificate number (Form 16B)
  // ── Home loan tracking ──
  homeLoanBank       String?    // bank/financial institution name
  homeLoanAmount     Decimal?   @db.Decimal(14, 2)  // sanctioned loan amount
  homeLoanSanctionNo String?    // loan sanction letter number
  homeLoanSanctionDate DateTime? // date loan was sanctioned
  // ── Deal terms ──
  dealMaturityMonths  Int?      // how many months until the deal matures
  dealMaturityDate    DateTime? // computed: saleDate + dealMaturityMonths
  paymentCycle        String?   // free-text: "25% every month", "Quarterly", etc.
  // ── Broker / deal source ──
  dealSource          DealSource @default(SELF)  // SELF or BROKER
  brokerId            String?                     // → Broker master (optional)
  brokerName          String?                     // snapshot (free-text if no broker master)
  brokerPhone         String?
  commissionAmount    Decimal?  @db.Decimal(14, 2) // broker commission
  commissionIsPartOfDeal Boolean @default(false)    // deducted from proceeds or paid separately
  commissionPaid      Boolean   @default(false)
  commissionPaidDate  DateTime?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer  Customer            @relation(fields: [customerId], references: [id])
  project   Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  company   Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  landParcel LandParcel?        @relation("AssetSaleLandParcel", fields: [landParcelId], references: [id], onDelete: SetNull)
  builtUnit BuiltUnit?          @relation("AssetSaleBuiltUnit", fields: [builtUnitId], references: [id], onDelete: SetNull)
  parcelSale LandParcel?        @relation("LandParcelSale")
  unitSale   BuiltUnit?         @relation("BuiltUnitSale")
  broker    Broker?             @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  createdBy User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  payments  AssetSalePayment[]
  paymentSchedule PaymentSchedule?
  expenses  SaleExpense[]
  terms     SaleTerm[]

  @@index([projectId])
  @@index([companyId])
  @@index([customerId])
  @@index([paymentStatus])
  @@index([createdById])
  @@index([brokerId])
  @@index([landParcelId])
}

model AssetSalePayment {
  id          String   @id @default(cuid())
  assetSaleId String
  amount      Decimal  @db.Decimal(14, 2)
  paymentDate DateTime @default(now())
  mode        String
  reference   String?
  status      String   @default("RECEIVED")

  assetSale AssetSale @relation(fields: [assetSaleId], references: [id], onDelete: Cascade)

  @@index([assetSaleId])
}

// ───────────────────────────────────────────────────────────
//  SALE EXPENSES — expense heads on the sell side (registry,
//  stamp duty, transfer, lease rent, GST, other). Each has a
//  3-way "borne by" toggle: CLIENT, SELLER, or NA.
//  Mirrors the land purchase cost breakup but for sales.
// ───────────────────────────────────────────────────────────

model SaleExpense {
  id          String          @id @default(cuid())
  assetSaleId String
  head        SaleExpenseHead
  label       String?         // custom label (for OTHER head)
  amount      Decimal         @db.Decimal(14, 2)
  borneBy     ExpenseBorneBy  @default(NA)
  isIncluded  Boolean         @default(false)  // included in deal price or extra on top
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())

  assetSale AssetSale @relation(fields: [assetSaleId], references: [id], onDelete: Cascade)

  @@index([assetSaleId])
  @@index([head])
}

// ───────────────────────────────────────────────────────────
//  SALE TERMS — free-text terms & conditions with optional
//  extra charge. E.g. "Fire NOC to be obtained by seller" (no
//  charge), or "Fire NOC ₹5L extra" (extraAmount = 500000,
//  isIncluded = false → added on top of deal price).
// ───────────────────────────────────────────────────────────

model SaleTerm {
  id          String   @id @default(cuid())
  assetSaleId String
  description String                    // the condition text
  extraAmount Decimal? @db.Decimal(14, 2) // optional charge for this condition
  isIncluded  Boolean  @default(true)   // included in deal price or extra on top
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  assetSale AssetSale @relation(fields: [assetSaleId], references: [id], onDelete: Cascade)

  @@index([assetSaleId])
}

// ───────────────────────────────────────────────────────────
//  BROKER — master entity for real estate brokers/agents.
//  Tracks default commission % and contact info. Used on
//  AssetSale.dealSource = BROKER to record who brought the deal.
// ───────────────────────────────────────────────────────────

model Broker {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  phone       String?
  agency      String?
  defaultCommissionPercent Decimal? @db.Decimal(5, 2)
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy  User?    @relation("BrokerCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assetSales AssetSale[]

  @@index([companyId])
  @@index([companyId, deletedAt])
  @@index([name])
}

// ───────────────────────────────────────────────────────────
//  FINANCE: project costs, expenses, audit
// ───────────────────────────────────────────────────────────

enum ProjectCostType {
  LABOUR
  OVERHEAD
  EQUIPMENT
  CONTRACTOR
  PERMIT
  TRANSFER_DUTY   // Transfer duty / unearned increase on authority (DDA/HUDCO) leasehold land
  OTHER
}

model ProjectCost {
  id        String          @id @default(cuid())
  projectId String
  costType  ProjectCostType
  amount    Decimal         @db.Decimal(14, 2)
  date      DateTime        @default(now())
  vendor    String?
  subcontractorId String?
  notes     String?
  receiptUrl String?
  createdById String?
  // DPR-Finance Bridge: link this cost back to the DPR that triggered it
  sourceDprId String?  // null = manual cost entry (not from DPR)
  // Legal-Doc Bridge: when this cost was auto-created from a TRANSFER_DUTY
  // legal document (transfer duty on authority land), link back to it so
  // the permission tracking and the financial impact stay connected.
  sourceLegalDocId String?  // null = manual cost entry (not from a legal doc)
  createdAt DateTime        @default(now())

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subcontractor Subcontractor? @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sourceDpr     DailyProgressReport? @relation("DprProjectCosts", fields: [sourceDprId], references: [id], onDelete: SetNull)
  sourceLegalDoc LegalDocument? @relation("LegalDocProjectCosts", fields: [sourceLegalDocId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([costType])
  @@index([createdById])
  @@index([sourceDprId])
  @@index([sourceLegalDocId])
}

model Expense {
  id        String   @id @default(cuid())
  companyId String
  projectId String?
  category  String
  amount    Decimal  @db.Decimal(14, 2)
  date      DateTime @default(now())
  notes     String?
  createdById String?
  createdAt DateTime @default(now())

  company Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([projectId])
  @@index([createdById])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  companyId  String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  timestamp  DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([companyId])
}

// ───────────────────────────────────────────────────────────
//  GENERAL LEDGER — double-entry bookkeeping + GST posting.
//
//  Every financial mutation (PO receipt, material issue, asset sale,
//  payment, project cost, expense, supplier return) posts a balanced
//  JournalEntry with two or more JournalLines. The chart of accounts
//  (Account) is seeded with a default construction-industry set.
//
//  This is the accounting layer behind the costing: the stock ledger
//  tracks quantities + MAC; the GL tracks the money. Together they let
//  an accountant close the books and produce a trial balance.
// ───────────────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  CONTRA_EXPENSE
}

model GlAccount {
  code        String       @id
  name        String
  type        AccountType
  isSystem    Boolean       @default(true) // system accounts can't be deleted
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  journalLines JournalLine[]

  @@index([type])
}

enum JournalEntryStatus {
  POSTED
  REVERSED
}

model JournalEntry {
  id          String             @id @default(cuid())
  entryNumber String             @unique
  entryDate    DateTime          @default(now())
  sourceType   String             // PO_RECEIPT | MATERIAL_ISSUE | ASSET_SALE | PAYMENT_RECEIVED | PROJECT_COST | EXPENSE | SUPPLIER_RETURN | LAND_PURCHASE | OPENING
  sourceId     String?
  memo        String?
  companyId   String
  postedById  String?
  status      JournalEntryStatus @default(POSTED)
  totalDebit  Decimal            @default(0) @db.Decimal(14, 2)
  totalCredit Decimal            @default(0) @db.Decimal(14, 2)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  lines JournalLine[]
  tallySyncLog TallySyncLog?

  @@index([companyId])
  @@index([sourceType, sourceId])
  @@index([entryDate])
}

model JournalLine {
  id             String   @id @default(cuid())
  journalEntryId String
  accountCode    String
  debit          Decimal  @default(0) @db.Decimal(14, 2)
  credit         Decimal  @default(0) @db.Decimal(14, 2)
  // Optional analytic dimensions — which material / project / party this line concerns
  entityType     String?
  entityId       String?
  memo           String?

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      GlAccount     @relation(fields: [accountCode], references: [code])

  @@index([journalEntryId])
  @@index([accountCode])
  @@index([entityType, entityId])
}

// ───────────────────────────────────────────────────────────
//  TALLY SYNC — track which journal entries have been exported
//  to Tally ERP as XML vouchers. The Tally provider is pluggable
//  (see services/tally.ts) — a stub provider logs the XML; the
//  real provider POSTs to Tally's HTTP API (port 9000).
// ───────────────────────────────────────────────────────────

model TallySyncLog {
  id                 String   @id @default(cuid())
  companyId          String
  journalEntryId     String?  // optional — imported vouchers may not have a local match
  tallyVoucherType   String   // "Journal", "Payment", "Receipt", "Sales", "Purchase", "Contra"
  tallyVoucherNumber String?  // Tally's assigned voucher number (on success)
  referenceNumber    String?  // voucher reference number from Tally (for reverse-sync matching)
  tallyAmount        Decimal?  @db.Decimal(14, 2) // amount from Tally (for variance checks)
  syncStatus         TallySyncStatus @default(PENDING)
  syncedAt           DateTime?
  errorMessage       String?
  xmlPayload         String   // the generated/imported Tally XML
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@unique([journalEntryId])  // one sync log per journal entry (null allowed for imports)
  @@index([companyId, syncStatus])
  @@index([syncStatus])
  @@index([referenceNumber])
}

enum TallySyncStatus {
  PENDING   // not yet synced
  SYNCED    // successfully synced to Tally
  FAILED    // sync attempted but failed (see errorMessage)
  IMPORTED  // voucher imported FROM Tally (reverse sync)
  VARIANCE  // imported voucher has amount mismatch vs local entry (flag for review)
}

// ───────────────────────────────────────────────────────────
//  INTEGRATION CONFIG — per-company credentials and settings
//  for external integrations (Tally, WhatsApp, Email, Portals).
//  Secrets are stored encrypted-at-rest via the `encrypted` flag
//  and application-level AES-256-GCM encryption (see crypto utils).
//  Only OWNER/ADMIN roles can view/edit these settings.
// ───────────────────────────────────────────────────────────

model IntegrationConfig {
  id          String   @id @default(cuid())
  companyId   String
  // Integration key: "TALLY" | "WHATSAPP" | "EMAIL_SMTP" | "PORTAL_99ACRES" | "PORTAL_MAGICBRICKS" | "PORTAL_HOUSING"
  key         String
  // Whether this integration is enabled (master switch)
  enabled     Boolean  @default(false)
  // JSON blob of config values. Secret fields (passwords, API keys, tokens)
  // are individually encrypted and marked with `__enc__: true` in the JSON.
  config      Json
  // When this config was last verified (test connection run)
  lastVerifiedAt DateTime?
  lastVerifyError String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@index([companyId])
}

// ───────────────────────────────────────────────────────────
//  NOTIFICATIONS — WhatsApp / email / in-app alert system with
//  pluggable providers. Templates are per-company per-event-type.
//  Triggers: low stock, task assignment, quote approval, DPR
//  approval, payment received, etc.
// ───────────────────────────────────────────────────────────

model NotificationTemplate {
  id          String   @id @default(cuid())
  companyId   String
  eventType   String   // LOW_STOCK | TASK_ASSIGNMENT | QUOTE_APPROVAL | DPR_APPROVAL | PAYMENT_RECEIVED | etc.
  channel     String   // WHATSAPP | EMAIL | IN_APP
  template    String   // message template with {{variables}}
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  notificationLogs NotificationLog[]

  @@unique([companyId, eventType, channel])
  @@index([companyId, eventType])
}

model NotificationLog {
  id            String   @id @default(cuid())
  companyId     String
  userId        String?  // target user for in-app notifications
  templateId    String?
  eventType     String
  channel       String   // WHATSAPP | EMAIL | IN_APP
  recipient     String   // phone number or email or user ID
  recipientName String?
  subject       String?
  message       String
  status        NotificationStatus @default(PENDING)
  sentAt        DateTime?
  errorMessage  String?
  error         String?  // legacy field alias for errorMessage
  metadata      Json?    // additional context (materialId, taskId, etc.)
  createdAt     DateTime @default(now())

  company   Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template  NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([companyId, eventType])
  @@index([userId, status])
  @@index([status])
  @@index([createdAt])
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ── Event-Driven Notification System ──
// Per-user preferences for which events they want to be notified about,
// and via which channel. Overrides the company-level template defaults.
model NotificationPreference {
  id          String   @id @default(cuid())
  companyId   String
  userId      String
  eventType   String   // LOW_STOCK | TASK_ASSIGNMENT | QUOTE_APPROVAL | DPR_APPROVAL | PAYMENT_RECEIVED | SCRAP_GENERATED | etc.
  channel     String   // WHATSAPP | EMAIL | IN_APP
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType, channel])
  @@index([companyId, eventType])
  @@index([userId])
}

// In-app notification — shown in the notification bell dropdown
model InAppNotification {
  id          String   @id @default(cuid())
  companyId   String
  userId      String   // recipient user
  eventType   String
  title       String
  message     String
  link        String?  // optional URL to navigate to when clicked
  isRead      Boolean  @default(false)
  readAt      DateTime?
  metadata    Json?
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([companyId, createdAt])
}

// ───────────────────────────────────────────────────────────
//  TASKS — assigned by admin/manager to signed-in users.
//  The admin creates a task, adds instructions/guidance, and the
//  assignee sees it on their dashboard with everything they need
//  to do.
// ───────────────────────────────────────────────────────────

model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?
  instructions String?   // step-by-step guidance from the admin
  status       String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | CANCELLED
  priority     String    @default("medium")  // low | medium | high | urgent
  dueDate      DateTime?
  assignedToId String
  assignedById String?
  estimateMins Int?      // planned effort in minutes (optional)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedTo User             @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)
  assignedBy User?            @relation("TaskAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  subtasks      SubTask[]
  comments      TaskComment[]
  activities    TaskActivity[]
  timeLogs      TaskTimeLog[]
  // Dependencies: this task is blocked by `blocking` tasks, and blocks `blockedBy` tasks.
  blocking      TaskDependency[] @relation("BlockedTask")
  blockedBy     TaskDependency[] @relation("BlockingTask")

  @@index([assignedToId])
  @@index([assignedById])
  @@index([status])
}

// Checkable steps within a task. Completion drives the task's progress %
// (completed subtasks / total subtasks). Ordered by `order`.
model SubTask {
  id          String   @id @default(cuid())
  taskId      String
  title       String
  completed   Boolean  @default(false)
  order       Int      @default(0)
  completedAt DateTime?
  completedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completedBy User?    @relation(fields: [completedById], references: [id], onDelete: SetNull)

  @@index([taskId])
}

// Threaded discussion on a task. `parentId` enables replies (one level deep).
model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  body      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent TaskComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies TaskComment[] @relation("CommentReplies")

  @@index([taskId])
  @@index([userId])
  @@index([parentId])
}

// Immutable, human-readable activity feed for a task. Written inside the same
// transaction as the mutation that triggered it, so the feed never diverges
// from reality. Distinct from AuditLog (which is the system-wide audit trail);
// this is the per-task timeline shown in the detail drawer.
model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  userId    String?
  kind      String   // CREATED | STATUS_CHANGED | ASSIGNED | PRIORITY_CHANGED | DUE_DATE_CHANGED | SUBTASK_ADDED | SUBTASK_TOGGLED | SUBTASK_DELETED | COMMENTED | DEPENDENCY_ADDED | DEPENDENCY_REMOVED | TIMER_STARTED | TIMER_STOPED | COMPLETED | REOPENED
  message   String   // pre-rendered human-readable summary
  meta      Json?
  createdAt DateTime @default(now())

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([createdAt])
}

// A → B means "A blocks B" (B cannot start until A is completed).
// `blockerId` = A, `blockedById` = B. Enforced in the service layer.
model TaskDependency {
  id          String @id @default(cuid())
  blockerId   String
  blockedById String
  createdAt   DateTime @default(now())

  blocker  Task @relation("BlockingTask", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedBy Task @relation("BlockedTask", fields: [blockedById], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedById])
  @@index([blockerId])
  @@index([blockedById])
}

// Time tracking entries. An open timer = endedAt null. Stopping sets endedAt
// and durationMins. Multiple entries per task are allowed.
model TaskTimeLog {
  id           String    @id @default(cuid())
  taskId       String
  userId       String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  durationMins Int?
  note         String?
  createdAt    DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@index([endedAt])
}

// ───────────────────────────────────────────────────────────
//  WORKFLOWS — automated chains of events built on the canvas.
//  The admin composes a sequence of action steps (create record,
//  send notification, wait, assign task, etc.), connects them
//  into a flow, and optionally schedules recurring execution.
// ───────────────────────────────────────────────────────────

model Workflow {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String   @default("Workflow")
  status      String   @default("DRAFT") // DRAFT | ACTIVE | PAUSED | ARCHIVED
  graphJson   Json     // WorkflowGraph: { steps, edges, schedule }
  companyId   String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  runs      WorkflowRun[]
  schedules ScheduledWorkflow[]
  creator   User?       @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([deletedAt])
  @@index([companyId])
  @@index([status])
}

model WorkflowRun {
  id          String    @id @default(cuid())
  workflowId  String
  status      String    @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED | CANCELLED
  startedAt   DateTime?
  completedAt DateTime?
  currentStep Int       @default(0)
  result      Json?
  error       String?
  triggeredBy String?   // "manual" | "schedule"
  createdAt   DateTime  @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([status])
}

model ScheduledWorkflow {
  id         String    @id @default(cuid())
  workflowId String
  cron       String?   // cron expression (e.g. "0 9 * * 1" = every Monday 9am)
  intervalM  Int?      // interval in minutes (alternative to cron)
  nextRunAt  DateTime
  enabled    Boolean   @default(true)
  lastRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([nextRunAt])
  @@index([enabled])
}

// ───────────────────────────────────────────────────────────
//  LEAVE MANAGEMENT — leave requests with approval workflow
//  (architecture: HR → Leave sub-module)
// ───────────────────────────────────────────────────────────

enum LeaveType {
  CASUAL
  SICK
  EARNED
  UNPAID
  MATERNITY
  PATERNITY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id          String      @id @default(cuid())
  companyId   String
  employeeId  String
  type        LeaveType   @default(CASUAL)
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  days        Decimal     @db.Decimal(5, 2) // computed working days (inclusive)
  reason      String?
  status      LeaveStatus @default(PENDING)
  approvedById String?
  approvedAt  DateTime?
  rejectedReason String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approvedBy User?     @relation("LeaveApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([employeeId])
  @@index([status])
  @@index([startDate])
}

// ───────────────────────────────────────────────────────────
//  RENT / LEASE — tenancy agreements for units & land parcels
//  (architecture: Real Estate → Rent sub-module)
// ───────────────────────────────────────────────────────────

enum TenancyStatus {
  ACTIVE
  EXPIRED
  TERMINATED
  PENDING
}

model Tenancy {
  id            String         @id @default(cuid())
  companyId     String
  assetType     AssetType      // LAND or BUILT_UNIT
  landParcelId  String?
  builtUnitId   String?
  customerId    String?
  projectId     String?
  tenantName    String
  tenantPhone   String?
  tenantEmail   String?
  startDate     DateTime       @db.Date
  endDate       DateTime       @db.Date
  monthlyRent   Decimal        @db.Decimal(14, 2)
  securityDeposit Decimal      @default(0) @db.Decimal(14, 2)
  rentAgreementNo String?
  // SAC code for GST on rental income. Renting out equipment, machinery, or
  // property is a SERVICE supply under GST (not goods → no HSN, uses SAC).
  // Default: 997313 (leasing/rental of construction machinery & equipment, 18%).
  // For property rent: 997212 (non-residential, 18%) or 997211 (residential, exempt).
  sacCode       String?  // e.g. "997313", "997212", "997211"
  status        TenancyStatus  @default(PENDING)
  notes         String?
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy  User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  payments   RentalPayment[]

  @@index([companyId])
  @@index([customerId])
  @@index([status])
  @@index([builtUnitId])
  @@index([landParcelId])
}

model RentalPayment {
  id          String   @id @default(cuid())
  tenancyId   String
  amount      Decimal  @db.Decimal(14, 2)
  paymentDate DateTime @default(now())
  dueDate     DateTime @db.Date
  mode        String   // CASH, BANK, UPI, CHEQUE
  reference   String?
  status      String   @default("RECEIVED") // RECEIVED, PENDING, OVERDUE
  createdAt   DateTime @default(now())

  tenancy Tenancy @relation(fields: [tenancyId], references: [id], onDelete: Cascade)

  @@index([tenancyId])
  @@index([status])
}

// ───────────────────────────────────────────────────────────
//  DAILY REPORT — site operations log (separate from DPR)
//  (architecture: HR → Daily Reports sub-module)
//  Fields: Attendance, Work Done, Material Used, Equipment, Delay, Remarks
// ───────────────────────────────────────────────────────────

model DailyReport {
  id           String   @id @default(cuid())
  companyId    String
  projectId    String?
  date         DateTime @db.Date
  attendanceSummary String?  // e.g. "42 present, 3 absent, 1 leave"
  workDone     String   // narrative of work completed today
  materialUsed String?  // free-text or summary of materials consumed
  equipment    String?  // equipment deployed + hours
  delay        String?  // delays encountered + reasons
  remarks      String?
  submittedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  submittedBy User?   @relation(fields: [submittedById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([projectId])
  @@index([date])
}

// ───────────────────────────────────────────────────────────────
//  Material Inventory Sales — sell raw materials / stock items
//  to customers (not just land/built-unit assets).
//  Each MaterialSale has one or more MaterialSaleLine items,
//  each referencing a material + location from which stock is
//  relieved via a SALE stock movement.
// ───────────────────────────────────────────────────────────────

model MaterialSale {
  id            String        @id @default(cuid())
  saleNumber    String        @unique
  customerId    String
  companyId     String
  projectId     String?
  saleDate      DateTime      @default(now())
  subtotal      Decimal       @default(0) @db.Decimal(14, 2) // Σ line.qty × line.unitPrice (pre-GST)
  gstTotal      Decimal       @default(0) @db.Decimal(14, 2) // Σ line.gstAmount
  roundOff      Decimal       @default(0) @db.Decimal(14, 2) // rounding adjustment (common in Indian invoices)
  totalAmount   Decimal       @default(0) @db.Decimal(14, 2) // subtotal + gstTotal + roundOff
  totalCost     Decimal       @default(0) @db.Decimal(14, 2) // Σ line.qty × line.unitCost (MAC at sale time)
  scrapSubtotal Decimal       @default(0) @db.Decimal(14, 2) // portion of subtotal from scrap-material lines (cost recovery)
  grossProfit   Decimal       @default(0) @db.Decimal(14, 2) // subtotal - totalCost
  partyName     String?       // override party name on invoice (for walk-in / cash customers not in CRM)
  status        SaleStatus    @default(ACTIVE)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMode   String?
  // Vehicle — how the goods were dispatched to the customer
  vehicleNumber  String?
  vehicleType    String?
  vehiclePhotoUrl String?
  driverName     String?
  driverPhone    String?
  notes         String?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer   Customer           @relation(fields: [customerId], references: [id])
  company    Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project    Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy  User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines      MaterialSaleLine[]
  payments   MaterialSalePayment[]

  @@index([companyId])
  @@index([customerId])
  @@index([projectId])
  @@index([status])
}

model MaterialSalePayment {
  id          String   @id @default(cuid())
  saleId      String
  amount      Decimal  @db.Decimal(14, 2)
  paymentDate DateTime @default(now())
  paymentMode String   // "BANK" | "CASH" | "UPI" | "CHEQUE"
  referenceNo String?
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sale       MaterialSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  createdBy  User?        @relation("SalePaymentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([saleId])
}

model MaterialSaleLine {
  id             String   @id @default(cuid())
  materialSaleId String
  materialId     String
  locationId     String
  qty            Decimal  @db.Decimal(14, 3)
  unitPrice      Decimal  @db.Decimal(14, 2) // selling price per unit
  unitCost       Decimal  @db.Decimal(14, 2) // MAC at time of sale (cost basis)
  gstRate        Decimal  @default(0) @db.Decimal(5, 2)
  gstAmount      Decimal  @default(0) @db.Decimal(14, 2) // qty × unitPrice × gstRate / 100
  lineTotal      Decimal  @db.Decimal(14, 2) // qty × unitPrice + gstAmount

  materialSale MaterialSale @relation(fields: [materialSaleId], references: [id], onDelete: Cascade)
  material     Material     @relation(fields: [materialId], references: [id])
  location     StockLocation @relation(fields: [locationId], references: [id])

  @@index([materialSaleId])
  @@index([materialId])
  @@index([locationId])
}

// ───────────────────────────────────────────────────────────────
//  Renovation / Value-Add Projects — track enhancement work on
//  existing built units or land parcels. Costs are capitalised
//  into the asset's cost basis on completion, and the valuation
//  is automatically updated (original cost + renovation cost).
//  ROI = (newValuation - originalValuation - renovationCost) / renovationCost
// ───────────────────────────────────────────────────────────────

enum RenovationType {
  RENOVATION     // structural / cosmetic upgrade of an existing unit
  ADDITION       // adding floor/room/extension to an existing unit
  VALUE_ADD      // general value-add (landscaping, amenities, fixtures)
  REPAIR         // non-capitalised repair (expensed, not capitalised)
}

enum RenovationStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model RenovationProject {
  id              String           @id @default(cuid())
  renovationNumber String          @unique
  type            RenovationType
  status          RenovationStatus @default(PLANNED)
  builtUnitId     String?
  landParcelId    String?
  projectId       String
  companyId       String
  title           String
  description     String?
  budget          Decimal          @default(0) @db.Decimal(14, 2) // planned budget
  actualCost      Decimal          @default(0) @db.Decimal(14, 2) // Σ renovation costs (computed)
  // Snapshot of asset valuation before renovation (for ROI calc)
  originalValuation Decimal        @default(0) @db.Decimal(14, 2)
  // New valuation set on completion (manual input or auto = original + actualCost)
  newValuation    Decimal?         @db.Decimal(14, 2)
  startDate       DateTime?
  completedAt     DateTime?
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  builtUnit   BuiltUnit?  @relation(fields: [builtUnitId], references: [id], onDelete: Cascade)
  landParcel  LandParcel? @relation(fields: [landParcelId], references: [id], onDelete: Cascade)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  costs       RenovationCost[]

  @@index([builtUnitId])
  @@index([landParcelId])
  @@index([projectId])
  @@index([companyId])
  @@index([status])
}

model RenovationCost {
  id                String          @id @default(cuid())
  renovationProjectId String
  costType          ProjectCostType // reuse: LABOUR, OVERHEAD, EQUIPMENT, CONTRACTOR, PERMIT, OTHER
  amount            Decimal         @db.Decimal(14, 2)
  date              DateTime        @default(now())
  vendor            String?
  notes             String?
  receiptUrl        String?
  createdById       String?
  createdAt         DateTime        @default(now())

  renovationProject RenovationProject @relation(fields: [renovationProjectId], references: [id], onDelete: Cascade)
  createdBy         User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([renovationProjectId])
  @@index([costType])
}

// ───────────────────────────────────────────────────────────
//  BOQ (BILL OF QUANTITIES) — the project's cost budget.
//  Hierarchical: Section → SubSection → Line Item.
//  Each leaf item has a material (optional), unit, estimated qty,
//  rate, and amount. This is the "planned cost" baseline.
//
//  WBS (WORK BREAKDOWN STRUCTURE) — the project's schedule.
//  Hierarchical: Project → Phase → Activity → Sub-Activity.
//  Each WBS node links to a BOQ item (optional) and has schedule
//  dates + dependencies. This is the scheduling backbone.
//
//  MEASUREMENT BOOK (MB) — the site engineer's verified record of
//  actual quantities executed. Each MB entry links to a BOQ item
//  and records the measured qty, date, and who measured it.
//  This is the "earned value" basis — EV = Σ MB qty × BOQ rate.
//
//  Together: BOQ = budget (PV), MB = executed (EV),
//  actuals (MaterialIssue + ProjectCost + RA bills) = AC.
//  EVM metrics (CPI, SPI, EAC) are computed from these three.
// ───────────────────────────────────────────────────────────

enum BoqItemType {
  SECTION     // top-level section (e.g. "Civil Works", "Electrical")
  SUBSECTION  // nested subsection (e.g. "Foundation", "Wiring")
  LINE_ITEM   // leaf item with qty + rate (the actual billable line)
}

model BoqItem {
  id          String       @id @default(cuid())
  projectId   String
  phaseId     String?
  parentId    String?      // self-relation: parent BoqItem (null = top-level section)
  type        BoqItemType  @default(SECTION)
  serialNo    String       // e.g. "1", "1.1", "1.1.1" — display order
  description String
  // Leaf-item fields (only set when type = LINE_ITEM)
  materialId  String?      // optional link to Material catalog
  unit        String?      // e.g. "CUM", "SQM", "NOS", "KG"
  estimatedQty  Decimal?   @db.Decimal(14, 3)  // planned quantity
  rate        Decimal?     @db.Decimal(14, 2)  // estimated rate (₹ per unit)
  // Computed: amount = estimatedQty × rate (cached for quick totals)
  estimatedAmount Decimal? @db.Decimal(14, 2)
  notes       String?
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase       ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  parent      BoqItem?     @relation("BoqHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    BoqItem[]    @relation("BoqHierarchy")
  material    Material?    @relation(fields: [materialId], references: [id], onDelete: SetNull)
  wbsNodes    WbsNode[]
  mbEntries   MeasurementBookEntry[]
  workOrderLines SubcontractorWorkOrderLine[]
  raBillLines RaBillLine[]
  rateAnalysis  RateAnalysis?
  changeOrderLines ChangeOrderLine[]
  ncrs             NonConformanceReport[] @relation("NcrBoqItem")

  @@index([projectId])
  @@index([parentId])
  @@index([phaseId])
  @@index([materialId])
}

// ───────────────────────────────────────────────────────────
//  RATE ANALYSIS — the cost breakdown of a BOQ line item's rate.
//  A BOQ line item has a single "rate" (₹ per unit). Rate Analysis
//  justifies HOW that rate was derived by breaking it down into:
//  - MATERIAL components (cement, sand, steel, etc. with qty per unit of work)
//  - LABOUR components (mason, helper, etc. with hours/days per unit)
//  - EQUIPMENT components (mixer, crane, etc. with hours per unit)
//  - OVERHEAD (% of material + labour subtotal)
//  - PROFIT (% of everything above)
//  - OTHER (transport, taxes, contingencies — flat amount or %)
//
//  The computed total from all lines should equal (or closely match)
//  the BoqItem.rate. The service can optionally auto-update the
//  BoqItem.rate from the rate analysis total.
// ───────────────────────────────────────────────────────────

enum RateAnalysisComponentType {
  MATERIAL     // material component (optionally linked to Material catalog)
  LABOUR       // labour / manpower component
  EQUIPMENT    // machinery / equipment component
  OVERHEAD     // overhead (% of material + labour + equipment subtotal)
  PROFIT       // contractor profit margin (% of everything above)
  OTHER        // transport, taxes, contingencies, etc.
}

enum RateAnalysisLineBasis {
  QUANTITY   // amount = quantity × rate (for MATERIAL, LABOUR, EQUIPMENT, OTHER)
  PERCENTAGE // amount = percentage × base (for OVERHEAD, PROFIT, OTHER)
}

model RateAnalysis {
  id          String   @id @default(cuid())
  boqItemId   String   @unique  // one rate analysis per BOQ line item
  // The unit of work this rate analysis is for (should match BoqItem.unit)
  // e.g. "CUM" means the rate analysis gives the cost per 1 CUM of this work
  perUnit     String              // e.g. "CUM", "SQM", "NOS"
  // Computed total rate (sum of all line amounts) — cached for quick display
  totalRate   Decimal  @default(0) @db.Decimal(14, 2)
  // Subtotals by component type (cached)
  materialSubtotal  Decimal @default(0) @db.Decimal(14, 2)
  labourSubtotal    Decimal @default(0) @db.Decimal(14, 2)
  equipmentSubtotal Decimal @default(0) @db.Decimal(14, 2)
  overheadSubtotal  Decimal @default(0) @db.Decimal(14, 2)
  profitSubtotal    Decimal @default(0) @db.Decimal(14, 2)
  otherSubtotal     Decimal @default(0) @db.Decimal(14, 2)
  // Wastage factor (%) applied to material components — e.g. 5% means
  // material quantities are inflated by 5% to account for wastage
  wastagePct  Decimal  @default(0) @db.Decimal(5, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  boqItem     BoqItem  @relation(fields: [boqItemId], references: [id], onDelete: Cascade)
  lines       RateAnalysisLine[]

  @@index([boqItemId])
}

model RateAnalysisLine {
  id              String                   @id @default(cuid())
  rateAnalysisId  String
  componentType   RateAnalysisComponentType
  basis           RateAnalysisLineBasis    @default(QUANTITY)
  // For MATERIAL: optional link to Material catalog
  materialId      String?
  // Description of the component (e.g. "Cement (OPC 53)", "Mason", "Concrete Mixer")
  description     String
  // For QUANTITY basis:
  //   quantity = amount per unit of BOQ work (e.g. 4.5 bags cement per CUM)
  //   unit = unit of the component (e.g. "bags", "hours", "days")
  //   rate = ₹ per unit of component (e.g. ₹350/bag)
  //   amount = quantity × rate
  // For PERCENTAGE basis:
  //   percentage = % applied to the base subtotal
  //   base = what the percentage is calculated on (set by service logic)
  //   amount = percentage × base / 100
  quantity        Decimal?  @db.Decimal(14, 5)
  unit            String?
  rate            Decimal?  @db.Decimal(14, 2)
  percentage      Decimal?  @db.Decimal(5, 2)
  amount          Decimal   @default(0) @db.Decimal(14, 2)  // computed
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  rateAnalysis    RateAnalysis @relation(fields: [rateAnalysisId], references: [id], onDelete: Cascade)
  material        Material?    @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([rateAnalysisId])
  @@index([materialId])
}

enum WbsNodeType {
  PROJECT_NODE   // root node for the project
  PHASE_NODE     // phase-level (Tower A, Phase 1)
  ACTIVITY       // a schedulable activity (e.g. "Excavation", "Concrete Pour")
  SUB_ACTIVITY   // nested sub-activity
  MILESTONE      // a key milestone (zero-duration, marks a point)
}

model WbsNode {
  id          String       @id @default(cuid())
  projectId   String
  phaseId     String?
  parentId    String?      // self-relation: parent WbsNode (null = project root)
  boqItemId   String?      // optional link to a BOQ line item (for cost-bearing activities)
  type        WbsNodeType  @default(ACTIVITY)
  code        String       // e.g. "A1.2.3" — WBS code for reference
  name        String
  description String?
  // Schedule
  plannedStart DateTime?
  plannedEnd   DateTime?
  actualStart  DateTime?
  actualEnd    DateTime?
  // Progress (0-100% — can be auto-computed from MB entries vs BOQ qty)
  progressPct  Decimal     @default(0) @db.Decimal(5, 2)
  // Critical path
  isCritical   Boolean     @default(false)
  // Float (slack) in days — computed from dependencies
  totalFloat   Int?        // days of slack
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase       ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  parent      WbsNode?     @relation("WbsHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    WbsNode[]    @relation("WbsHierarchy")
  boqItem     BoqItem?     @relation(fields: [boqItemId], references: [id], onDelete: SetNull)
  dependencies WbsDependency[] @relation("WbsDependent")
  blocks      WbsDependency[] @relation("WbsBlocking")
  mbEntries   MeasurementBookEntry[]
  paymentScheduleItems PaymentScheduleItem[]
  ncrs        NonConformanceReport[]
  safetyIncidents SafetyIncident[]
  safetyHazards   SafetyHazard[]

  @@index([projectId])
  @@index([parentId])
  @@index([phaseId])
  @@index([boqItemId])
}

enum DependencyType {
  FS  // Finish-to-Start (A must finish before B starts) — most common
  SS  // Start-to-Start
  FF  // Finish-to-Finish
  SF  // Start-to-Finish (rare)
}

model WbsDependency {
  id           String         @id @default(cuid())
  predecessorId String        // the node that must finish/start first
  successorId   String        // the node that depends on the predecessor
  type         DependencyType @default(FS)
  lagDays      Int            @default(0) // positive = delay, negative = lead
  createdAt    DateTime       @default(now())

  predecessor WbsNode @relation("WbsBlocking", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   WbsNode @relation("WbsDependent", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId, type])
  @@index([successorId])
}

enum MbEntryStatus {
  DRAFT          // entered by site engineer, pending verification
  VERIFIED       // verified by sub-engineer/QA
  APPROVED       // approved by engineer-in-charge (billable)
  REJECTED       // rejected — needs re-measurement
}

model MeasurementBookEntry {
  id           String        @id @default(cuid())
  projectId    String
  phaseId      String?
  boqItemId    String        // which BOQ line item this measurement is for
  wbsNodeId    String?       // which WBS activity this was done under
  mbNumber     String        // sequential MB entry number (MB-YYMMDD-NNNN)
  // The actual measured quantity for this entry (cumulative entries add up)
  measuredQty  Decimal       @db.Decimal(14, 3)
  // Cumulative qty up to and including this entry (for running total)
  cumulativeQty Decimal      @db.Decimal(14, 3)
  // Description of work done
  description  String
  // Location reference (e.g. "Unit 101, Floor 2, Wing A")
  locationRef  String?
  // Measurement date (when the work was actually done/measured)
  measureDate  DateTime      @default(now())
  // Approval workflow
  status       MbEntryStatus @default(DRAFT)
  measuredById String?
  verifiedById String?
  approvedById String?
  verifiedAt   DateTime?
  approvedAt   DateTime?
  rejectReason String?
  // Link to RA bill (set when this entry is included in a bill)
  raBillLineId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase        ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  boqItem      BoqItem       @relation(fields: [boqItemId], references: [id], onDelete: Restrict)
  wbsNode      WbsNode?      @relation(fields: [wbsNodeId], references: [id], onDelete: SetNull)
  measuredBy   User?         @relation("MbMeasuredBy", fields: [measuredById], references: [id], onDelete: SetNull)
  verifiedBy   User?         @relation("MbVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  approvedBy   User?         @relation("MbApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  raBillLine   RaBillLine?   @relation(fields: [raBillLineId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([boqItemId])
  @@index([wbsNodeId])
  @@index([status])
  @@index([phaseId])
}

// ───────────────────────────────────────────────────────────
//  SUBCONTRACTOR WORK ORDERS + RA BILLS — the contractor billing
//  and payment cycle. A Work Order is issued against specific BOQ
//  items (scope of work) with agreed rates. RA (Running Account)
//  bills are generated from approved MB entries, with deductions
//  for retention, TDS, and advance recovery. A Payment Certificate
//  is the final payable amount after all deductions.
//
//  TDS under Section 194C: 1% for individual/HUF subcontractor,
//  2% for others. Retention (typically 5-10%) is held until
//  project completion or defect liability period ends.
// ───────────────────────────────────────────────────────────

enum WorkOrderStatus {
  DRAFT
  ISSUED       // issued to subcontractor, work can start
  ACTIVE       // work in progress (RA bills being submitted)
  COMPLETED    // work finished, retention pending
  CLOSED       // retention released, fully settled
  CANCELLED
}

enum SubcontractorCategory {
  INDIVIDUAL    // individual/HUF — TDS @ 1%
  COMPANY       // partnership/company — TDS @ 2%
  OTHER         // TDS @ 2%
}

model SubcontractorWorkOrder {
  id               String           @id @default(cuid())
  workOrderNumber  String           @unique  // WO-YYMMDD-NNNN
  projectId        String
  phaseId          String?
  subcontractorId  String
  companyId        String
  status           WorkOrderStatus  @default(DRAFT)
  // Scope: which BOQ items are covered (via SubcontractorWorkOrderLine)
  workTitle        String
  description      String?
  // Financial terms
  retentionPct     Decimal          @default(5) @db.Decimal(5, 2)  // % retained per bill
  tdsPct           Decimal          @default(2) @db.Decimal(5, 2)  // TDS % (1% or 2% per 194C)
  tdsCategory      SubcontractorCategory @default(COMPANY)
  // Advance
  advanceAmount    Decimal          @default(0) @db.Decimal(14, 2)
  advanceRecoveryPct Decimal        @default(10) @db.Decimal(5, 2) // % recovered per bill
  // Dates
  issueDate        DateTime         @default(now())
  startDate        DateTime?
  endDate          DateTime?
  // Totals (cached from RA bills)
  totalWorkDone    Decimal          @default(0) @db.Decimal(14, 2)
  totalDeductions  Decimal          @default(0) @db.Decimal(14, 2)
  totalPaid        Decimal          @default(0) @db.Decimal(14, 2)
  retentionBalance Decimal          @default(0) @db.Decimal(14, 2)  // cumulative retention held
  // Defect liability period (months after completion before retention release)
  defectLiabilityMonths Int         @default(12)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase            ProjectPhase?    @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  subcontractor    Subcontractor    @relation(fields: [subcontractorId], references: [id], onDelete: Restrict)
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines            SubcontractorWorkOrderLine[]
  raBills          RaBill[]

  @@index([projectId])
  @@index([subcontractorId])
  @@index([companyId])
  @@index([status])
}

model SubcontractorWorkOrderLine {
  id              String   @id @default(cuid())
  workOrderId     String
  boqItemId       String   // the BOQ line item being subcontracted
  agreedRate      Decimal  @db.Decimal(14, 2)  // rate per unit (may differ from BOQ estimated rate)
  // Cumulative tracking (cached from approved MB entries linked to this BOQ item)
  cumulativeQty   Decimal  @default(0) @db.Decimal(14, 3)
  cumulativeAmount Decimal @default(0) @db.Decimal(14, 2)

  workOrder       SubcontractorWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  boqItem         BoqItem                @relation(fields: [boqItemId], references: [id], onDelete: Restrict)
  raBillLines     RaBillLine[]

  @@index([workOrderId])
  @@index([boqItemId])
}

enum RaBillStatus {
  DRAFT          // created by subcontractor/site, pending review
  SUBMITTED      // submitted for approval
  APPROVED       // approved by engineer-in-charge
  PAID           // payment certificate generated + payment recorded
  REJECTED       // rejected — needs revision
}

model RaBill {
  id              String        @id @default(cuid())
  raBillNumber    String        @unique  // RA-YYMMDD-NNNN
  workOrderId     String
  projectId       String
  companyId       String
  billDate        DateTime      @default(now())
  periodFrom      DateTime      // billing period start
  periodTo        DateTime      // billing period end
  status          RaBillStatus  @default(DRAFT)
  // Financial summary (computed from lines)
  grossAmount     Decimal       @default(0) @db.Decimal(14, 2)  // Σ line amounts (work done this period)
  cumulativeGross Decimal       @default(0) @db.Decimal(14, 2)  // total work done up to this bill
  // Deductions
  retentionAmount Decimal       @default(0) @db.Decimal(14, 2)  // retained this bill
  tdsAmount       Decimal       @default(0) @db.Decimal(14, 2)  // TDS deducted
  advanceRecovery Decimal       @default(0) @db.Decimal(14, 2)  // advance recovered this bill
  otherDeductions Decimal       @default(0) @db.Decimal(14, 2)  // penalties, etc.
  // Net payable
  netPayable      Decimal       @default(0) @db.Decimal(14, 2)  // grossAmount - all deductions
  // Approval
  approvedById    String?
  approvedAt      DateTime?
  rejectReason    String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  workOrder       SubcontractorWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  project         Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company         Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines           RaBillLine[]
  approvedBy      User?                  @relation("RaBillApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([workOrderId])
  @@index([projectId])
  @@index([status])
}

model RaBillLine {
  id              String   @id @default(cuid())
  raBillId        String
  boqItemId       String   // which BOQ item this line is for
  workOrderLineId String   // which work order line (for agreed rate)
  // Quantities
  prevQty         Decimal  @default(0) @db.Decimal(14, 3)  // cumulative up to previous bill
  thisQty         Decimal  @default(0) @db.Decimal(14, 3)  // this period's quantity
  totalQty        Decimal  @default(0) @db.Decimal(14, 3)  // prevQty + thisQty
  // Amounts
  rate            Decimal  @db.Decimal(14, 2)  // agreed rate from work order line
  prevAmount      Decimal  @default(0) @db.Decimal(14, 2)
  thisAmount      Decimal  @default(0) @db.Decimal(14, 2)
  totalAmount     Decimal  @default(0) @db.Decimal(14, 2)

  raBill          RaBill   @relation(fields: [raBillId], references: [id], onDelete: Cascade)
  boqItem         BoqItem  @relation(fields: [boqItemId], references: [id], onDelete: Restrict)
  workOrderLine   SubcontractorWorkOrderLine @relation(fields: [workOrderLineId], references: [id], onDelete: Cascade)
  mbEntries       MeasurementBookEntry[]

  @@index([raBillId])
  @@index([boqItemId])
}

// ───────────────────────────────────────────────────────────
//  CHANGE ORDER — formal modifications to the project scope,
//  BOQ, schedule, or budget after the original BOQ was approved.
//
//  A Change Order captures:
//  - WHAT changed (description, reason, type)
//  - WHY it changed (client request, site condition, design error, etc.)
//  - Impact on COST (added/removed line items with qty/rate deltas)
//  - Impact on SCHEDULE (days added/removed, affected WBS nodes)
//  - Approval workflow (DRAFT → SUBMITTED → APPROVED/REJECTED → IMPLEMENTED)
//
//  When approved + implemented, the change order can:
//  - Add new BOQ items or modify existing ones (qty/rate changes)
//  - Update Project.totalBudget
//  - Adjust WBS node planned dates
//  - Create ProjectCost entries for the cost delta
// ───────────────────────────────────────────────────────────

enum ChangeOrderType {
  ADDITION      // new work added to scope
  DELETION      // work removed from scope
  MODIFICATION  // existing work modified (qty/rate/spec change)
  ACCELERATION  // schedule acceleration (crash costs)
  DECELERATION  // schedule extension
  VARIATION     // site condition / design variation
}

enum ChangeOrderReason {
  CLIENT_REQUEST       // client asked for a change
  SITE_CONDITION       // unforeseen site conditions
  DESIGN_CHANGE        // architect/engineer design revision
  ERROR_OMISSION       // correction of error or omission in original BOQ
  REGULATORY           // statutory / RERA / compliance change
  VALUE_ENGINEERING    // cost optimization
  OTHER
}

enum ChangeOrderStatus {
  DRAFT         // being prepared by PM/QS
  SUBMITTED     // submitted for approval
  APPROVED      // approved by owner/admin
  REJECTED      // rejected — needs revision
  IMPLEMENTED   // changes applied to BOQ/budget/schedule
  CANCELLED     // withdrawn before approval
}

model ChangeOrder {
  id              String             @id @default(cuid())
  companyId       String
  projectId       String
  phaseId         String?
  changeOrderNo   String             @unique  // CO-YYMMDD-NNNN
  title           String
  description     String
  type            ChangeOrderType    @default(MODIFICATION)
  reason          ChangeOrderReason  @default(OTHER)
  status          ChangeOrderStatus  @default(DRAFT)
  // Cost impact (computed from lines)
  originalAmount  Decimal            @default(0) @db.Decimal(14, 2)  // original BOQ value affected
  revisedAmount   Decimal            @default(0) @db.Decimal(14, 2)  // revised value after change
  costDelta       Decimal            @default(0) @db.Decimal(14, 2)  // revisedAmount - originalAmount
  // Schedule impact
  scheduleDeltaDays Int             @default(0)  // +ve = delay, -ve = acceleration
  // Client approval (separate from internal approval)
  clientApprovalRequired Boolean    @default(true)
  clientApprovedAt   DateTime?
  clientApprovedBy   String?        // client name (free text — external party)
  // Internal approval workflow
  submittedById   String?
  submittedAt     DateTime?
  approvedById    String?
  approvedAt      DateTime?
  rejectReason    String?
  implementedById String?
  implementedAt   DateTime?
  // Metadata
  initiatedBy     String?           // who requested the change (free text or user)
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase           ProjectPhase?      @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  submittedBy     User?              @relation("ChangeOrderSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  approvedBy      User?              @relation("ChangeOrderApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  implementedBy   User?              @relation("ChangeOrderImplementer", fields: [implementedById], references: [id], onDelete: SetNull)
  lines           ChangeOrderLine[]

  @@index([projectId])
  @@index([companyId])
  @@index([status])
  @@index([phaseId])
}

model ChangeOrderLine {
  id              String   @id @default(cuid())
  changeOrderId   String
  boqItemId       String?  // linked BOQ item (null for new items not yet in BOQ)
  // Description of the change for this line
  description     String
  // For ADDITION: originalQty = 0, revisedQty = new qty
  // For DELETION: originalQty = existing qty, revisedQty = 0
  // For MODIFICATION: originalQty = old qty, revisedQty = new qty
  originalQty     Decimal  @default(0) @db.Decimal(14, 3)
  revisedQty      Decimal  @default(0) @db.Decimal(14, 3)
  unit            String
  rate            Decimal  @db.Decimal(14, 2)
  originalAmount  Decimal  @default(0) @db.Decimal(14, 2)  // originalQty × rate
  revisedAmount   Decimal  @default(0) @db.Decimal(14, 2)  // revisedQty × rate
  amountDelta     Decimal  @default(0) @db.Decimal(14, 2)  // revisedAmount - originalAmount
  notes           String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  changeOrder     ChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
  boqItem         BoqItem?    @relation(fields: [boqItemId], references: [id], onDelete: SetNull)

  @@index([changeOrderId])
  @@index([boqItemId])
}

// ───────────────────────────────────────────────────────────
//  QUALITY CONTROL — Non-Conformance Reports (NCR) and
//  Corrective And Preventive Actions (CAPA).
//
//  NCR: raised when work/material doesn't conform to spec or
//  quality standards. Captures what's wrong, where, severity,
//  and the responsible party. Goes through OPEN → UNDER_REVIEW
//  → CAPA_REQUIRED / ACCEPTED / REJECTED → CLOSED.
//
//  CAPA: the corrective + preventive action plan for an NCR.
//  Root cause analysis → corrective action (fix the problem) →
//  preventive action (stop it happening again) → verification
//  → closure. One NCR can have one CAPA.
// ───────────────────────────────────────────────────────────

enum NcrSeverity {
  CRITICAL    // safety-critical / structural — stop work
  MAJOR       // significant non-conformance — rework required
  MINOR       // small deviation — can be accepted with concession
  OBSERVATION // note for improvement — no immediate action
}

enum NcrStatus {
  OPEN            // newly raised, awaiting review
  UNDER_REVIEW    // being investigated by QA/QC
  CAPA_REQUIRED   // review done, corrective action needed
  ACCEPTED        // non-conformance accepted with concession (minor)
  REJECTED        // work rejected — must be reworked
  CLOSED          // resolved + verified
  CANCELLED       // withdrawn
}

enum NcrCategory {
  MATERIAL    // material doesn't meet spec (e.g. wrong cement grade)
  WORKMANSHIP // poor quality of execution (e.g. uneven plaster)
  DESIGN      // design issue causing non-conformance
  DOCUMENT    // missing or incorrect documentation/test reports
  PROCESS     // process not followed (e.g. curing not done)
  SAFETY      // safety-related quality issue
  OTHER
}

enum CapaStatus {
  DRAFT          // being prepared
  IN_PROGRESS    // corrective action underway
  VERIFICATION   // action done, awaiting verification
  VERIFIED       // verified effective
  CLOSED         // fully closed
  REJECTED       // verification failed — needs rework
}

model NonConformanceReport {
  id              String        @id @default(cuid())
  companyId       String
  projectId       String
  ncrNumber       String        @unique  // NCR-YYMMDD-NNNN
  title           String
  description     String        // what is non-conforming
  category        NcrCategory   @default(WORKMANSHIP)
  severity        NcrSeverity   @default(MINOR)
  status          NcrStatus     @default(OPEN)
  // Where the issue was found
  location        String?       // e.g. "Tower A, 3rd floor, flat 302"
  wbsNodeId       String?       // linked WBS activity (optional)
  boqItemId       String?       // linked BOQ item (optional)
  // Who raised it and when
  raisedById      String?
  raisedAt        DateTime      @default(now())
  // Responsible party (who caused the non-conformance)
  responsibleParty String?      // e.g. "Subcontractor: ABC Constructions", "In-house team"
  subcontractorId String?       // if a subcontractor is responsible
  // Review
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNotes     String?
  // Closure
  closedById      String?
  closedAt        DateTime?
  closureNotes    String?
  // Attachments (photo evidence, test reports, etc.)
  attachments     String[]      @default([])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode         WbsNode?      @relation(fields: [wbsNodeId], references: [id], onDelete: SetNull)
  boqItem         BoqItem?      @relation("NcrBoqItem", fields: [boqItemId], references: [id], onDelete: SetNull)
  subcontractor   Subcontractor? @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)
  raisedBy        User?         @relation("NcrRaisedBy", fields: [raisedById], references: [id], onDelete: SetNull)
  reviewedBy      User?         @relation("NcrReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  closedBy        User?         @relation("NcrClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  capa            Capa?

  @@index([projectId])
  @@index([companyId])
  @@index([status])
  @@index([severity])
}

model Capa {
  id              String        @id @default(cuid())
  ncrId           String        @unique  // one CAPA per NCR
  companyId       String
  projectId       String
  capaNumber      String        @unique  // CAPA-YYMMDD-NNNN
  status          CapaStatus    @default(DRAFT)
  // Root cause analysis
  rootCause       String        // why did the non-conformance happen?
  // Corrective action — fix the immediate problem
  correctiveAction    String    // what will be done to fix it
  correctiveDueDate   DateTime?
  correctiveDoneAt    DateTime?
  correctiveDoneById  String?
  // Preventive action — stop it happening again
  preventiveAction    String    // what will be done to prevent recurrence
  preventiveDueDate   DateTime?
  preventiveDoneAt    DateTime?
  preventiveDoneById  String?
  // Verification — did the actions work?
  verificationMethod   String?  // how effectiveness was checked
  verifiedById         String?
  verifiedAt           DateTime?
  verificationNotes    String?
  // Closure
  closedById     String?
  closedAt       DateTime?
  closureNotes   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  ncr            NonConformanceReport @relation(fields: [ncrId], references: [id], onDelete: Cascade)
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  correctiveDoneBy User?             @relation("CapaCorrectiveDoneBy", fields: [correctiveDoneById], references: [id], onDelete: SetNull)
  preventiveDoneBy User?             @relation("CapaPreventiveDoneBy", fields: [preventiveDoneById], references: [id], onDelete: SetNull)
  verifiedBy       User?             @relation("CapaVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  closedBy         User?             @relation("CapaClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  @@index([ncrId])
  @@index([projectId])
  @@index([status])
}

// ───────────────────────────────────────────────────────────
//  SAFETY MANAGEMENT — incidents, hazards, and safety
//  inspections for construction sites.
//
//  SafetyIncident: accidents, near-misses, injuries, property
//  damage. Tracks severity, type, people involved, root cause,
//  and corrective actions. Goes through REPORTED →
//  UNDER_INVESTIGATION → INVESTIGATED → CLOSED.
//
//  SafetyHazard: identified hazards on site with risk
//  assessment (likelihood × severity = risk level). Tracks
//  mitigation status: IDENTIFIED → MITIGATING → RESOLVED.
//
//  SafetyInspection: scheduled or ad-hoc safety walkthroughs.
//  Records findings, compliance checks, and follow-up items.
// ───────────────────────────────────────────────────────────

enum IncidentType {
  ACCIDENT          // actual harm/damage occurred
  NEAR_MISS         // could have caused harm but didn't
  INJURY            // person injured
  FATALITY          // death
  PROPERTY_DAMAGE   // damage to property/equipment
  ENVIRONMENTAL     // environmental damage (spill, dust, noise)
  FIRE              // fire incident
  STRUCTURAL        // structural failure/collapse
  OTHER
}

enum IncidentSeverity {
  FIRST_AID     // minor — first aid only, no lost time
  LOST_TIME     // missed work days
  SERIOUS       // hospitalization / permanent disability
  FATAL         // death
  PROPERTY_ONLY // no human harm, property damage only
}

enum IncidentStatus {
  REPORTED              // newly reported
  UNDER_INVESTIGATION   // being investigated
  INVESTIGATED          // investigation complete, report ready
  CLOSED                // fully resolved + corrective actions done
  CANCELLED             // withdrawn / duplicate
}

enum HazardStatus {
  IDENTIFIED    // hazard found, not yet addressed
  MITIGATING    // mitigation in progress
  RESOLVED      // hazard eliminated/controlled
}

enum HazardRiskLevel {
  LOW       // acceptable risk
  MEDIUM    // needs controls
  HIGH      // urgent action required
  CRITICAL  // stop work immediately
}

enum InspectionResult {
  PASSED       // no major issues found
  PASSED_WITH_NOTES  // minor issues, no stop-work
  FAILED       // major issues found, corrective action needed
  STOP_WORK    // critical safety issues — work stopped
}

enum SafetyInspectionStatus {
  SCHEDULED    // planned but not yet done
  IN_PROGRESS  // being conducted
  COMPLETED    // finished
  CANCELLED    // cancelled
}

model SafetyIncident {
  id              String            @id @default(cuid())
  companyId       String
  projectId       String
  incidentNumber  String            @unique  // INC-YYMMDD-NNNN
  title           String
  description     String            // what happened
  type            IncidentType      @default(ACCIDENT)
  severity        IncidentSeverity  @default(FIRST_AID)
  status          IncidentStatus    @default(REPORTED)
  // When & where
  incidentDate    DateTime          // when the incident occurred
  incidentTime    String?           // HH:MM (optional, for precise time)
  location        String?           // where on site
  wbsNodeId       String?           // linked WBS activity (optional)
  // People involved
  peopleInvolved  String?           // names/description of people involved
  injuredCount    Int               @default(0)
  fatalities      Int               @default(0)
  // Property damage
  propertyDamageEstimate Decimal?   @db.Decimal(14, 2)  // estimated cost of damage
  // Reporting
  reportedById    String?
  reportedAt      DateTime          @default(now())
  // Investigation
  investigatedById String?
  investigatedAt   DateTime?
  rootCause        String?           // root cause analysis findings
  correctiveActions String?         // what will be done to prevent recurrence
  // Closure
  closedById      String?
  closedAt        DateTime?
  closureNotes    String?
  // Attachments (photos, reports, witness statements)
  attachments     String[]          @default([])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode         WbsNode?          @relation(fields: [wbsNodeId], references: [id], onDelete: SetNull)
  reportedBy      User?             @relation("IncidentReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  investigatedBy  User?             @relation("IncidentInvestigatedBy", fields: [investigatedById], references: [id], onDelete: SetNull)
  closedBy        User?             @relation("IncidentClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([companyId])
  @@index([status])
  @@index([severity])
  @@index([type])
}

model SafetyHazard {
  id              String            @id @default(cuid())
  companyId       String
  projectId       String
  hazardNumber    String            @unique  // HZD-YYMMDD-NNNN
  title           String
  description     String            // what is the hazard
  status          HazardStatus      @default(IDENTIFIED)
  // Risk assessment
  likelihood      Int               @default(2)  // 1-5 (1=rare, 5=almost certain)
  severity        Int               @default(2)  // 1-5 (1=minor, 5=catastrophic)
  riskLevel       HazardRiskLevel   @default(MEDIUM)  // computed from likelihood × severity
  // Location
  location        String?
  wbsNodeId       String?
  // Identification
  identifiedById  String?
  identifiedAt    DateTime          @default(now())
  // Mitigation
  mitigationPlan  String?           // how the hazard will be controlled
  mitigatedById   String?
  mitigatedAt     DateTime?
  // Resolution
  resolvedById    String?
  resolvedAt      DateTime?
  resolutionNotes String?
  // Target date for mitigation
  targetResolutionDate DateTime?
  attachments     String[]          @default([])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode         WbsNode?          @relation(fields: [wbsNodeId], references: [id], onDelete: SetNull)
  identifiedBy    User?             @relation("HazardIdentifiedBy", fields: [identifiedById], references: [id], onDelete: SetNull)
  mitigatedBy     User?             @relation("HazardMitigatedBy", fields: [mitigatedById], references: [id], onDelete: SetNull)
  resolvedBy      User?             @relation("HazardResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([companyId])
  @@index([status])
  @@index([riskLevel])
}

model SafetyInspection {
  id              String              @id @default(cuid())
  companyId       String
  projectId       String
  inspectionNumber String             @unique  // INS-YYMMDD-NNNN
  title           String
  status          SafetyInspectionStatus    @default(SCHEDULED)
  result          InspectionResult?
  // Schedule
  scheduledDate   DateTime            // when the inspection is planned
  conductedDate   DateTime?           // when it was actually done
  // Inspector
  inspectorId     String?
  inspectorName   String?             // external inspector name (if not a user)
  // Findings
  findings        String?             // what was found during the inspection
  complianceNotes String?             // compliance checklist results
  followUpActions String?             // actions needed based on findings
  // People
  conductedById   String?
  // Attachments (photos, checklists)
  attachments     String[]            @default([])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inspector       User?               @relation("InspectionConductedBy", fields: [conductedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([companyId])
  @@index([status])
  @@index([scheduledDate])
}

// ───────────────────────────────────────────────────────────
//  PAYMENT SCHEDULE — for real estate sales. Generated when a
//  unit is booked. Three types:
//  - CLP (Construction-Linked Plan): payments tied to WBS
//    milestone completion (e.g. 10% on foundation, 20% on
//    structure, etc.)
//  - TLP (Time-Linked Plan): fixed installments over time
//  - DPP (Down Payment Plan): large upfront + small installments
// ───────────────────────────────────────────────────────────

enum PaymentScheduleType {
  CLP    // Construction-Linked Plan
  TLP    // Time-Linked Plan
  DPP    // Down Payment Plan
}

enum PaymentScheduleItemStatus {
  PENDING       // not yet due
  DUE           // milestone reached / date passed, awaiting payment
  PARTIAL       // partially paid
  PAID          // fully paid
  WAIVED        // waived (e.g. promotional offer)
}

model PaymentSchedule {
  id            String              @id @default(cuid())
  assetSaleId   String              @unique  // one schedule per sale
  type          PaymentScheduleType @default(CLP)
  totalAmount   Decimal             @db.Decimal(14, 2)
  gstAmount     Decimal             @default(0) @db.Decimal(14, 2)
  grandTotal    Decimal             @db.Decimal(14, 2)  // totalAmount + gstAmount
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  assetSale     AssetSale           @relation(fields: [assetSaleId], references: [id], onDelete: Cascade)
  items         PaymentScheduleItem[]

  @@index([assetSaleId])
}

model PaymentScheduleItem {
  id            String                  @id @default(cuid())
  paymentScheduleId String
  wbsNodeId     String?                 // for CLP: which milestone triggers this payment
  installmentNo Int                     // 1, 2, 3...
  description   String                  // e.g. "On Booking", "On Foundation Completion"
  percentage    Decimal                 @db.Decimal(5, 2)  // % of total
  amount        Decimal                 @db.Decimal(14, 2)  // base amount
  gstPercentage Decimal  @default(0)    @db.Decimal(5, 2)
  gstAmount     Decimal  @default(0)    @db.Decimal(14, 2)
  totalAmount   Decimal                 @db.Decimal(14, 2)  // amount + gstAmount
  // For TLP/DPP: due date. For CLP: triggered by WBS milestone completion
  dueDate       DateTime?
  status        PaymentScheduleItemStatus @default(PENDING)
  paidAmount    Decimal  @default(0)    @db.Decimal(14, 2)
  paidAt        DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  paymentSchedule PaymentSchedule        @relation(fields: [paymentScheduleId], references: [id], onDelete: Cascade)
  wbsNode         WbsNode?               @relation(fields: [wbsNodeId], references: [id], onDelete: SetNull)

  @@index([paymentScheduleId])
  @@index([wbsNodeId])
  @@index([status])
}

// ───────────────────────────────────────────────────────────
//  RATE CONTRACT / FRAMEWORK AGREEMENT — pre-negotiated rates
//  with a supplier for a specific material, valid for a period.
//  POs created against a rate contract auto-fill the agreed rate.
// ───────────────────────────────────────────────────────────

enum RateContractStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model RateContract {
  id             String              @id @default(cuid())
  contractNumber String              @unique  // RC-YYMMDD-NNNN
  supplierId     String
  companyId      String
  materialId     String
  agreedRate     Decimal             @db.Decimal(14, 2)  // ₹ per unit
  validFrom      DateTime
  validTo        DateTime
  minQty         Decimal?            @db.Decimal(14, 3)  // minimum order qty per release
  maxQty         Decimal?            @db.Decimal(14, 3)  // maximum total qty under this contract
  totalReleasedQty Decimal           @default(0) @db.Decimal(14, 3)  // cumulative qty released via POs
  status         RateContractStatus  @default(ACTIVE)
  notes          String?
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  supplier       Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  material       Material            @relation(fields: [materialId], references: [id], onDelete: Restrict)
  createdBy      User?               @relation("RateContractCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([supplierId])
  @@index([companyId])
  @@index([materialId])
  @@index([status])
}

// ───────────────────────────────────────────────────────────
//  GATE PASS — outbound gate pass with approval workflow.
//  Whenever items physically leave a gate (warehouse or project
//  site), a gate pass is generated with item details, vehicle,
//  driver, destination. An authorized person must approve before
//  items can physically exit. Security confirms the exit.
// ───────────────────────────────────────────────────────────

enum GatePassStatus {
  DRAFT          // created, not yet submitted for approval
  PENDING        // submitted, awaiting approver
  APPROVED       // approved — items can now physically exit
  REJECTED       // rejected by approver
  EXITED         // items have physically left the gate (closed by security)
  CANCELLED      // cancelled before exit
}

enum GatePassCategory {
  MATERIAL_ISSUE     // linked to MaterialIssue
  STOCK_TRANSFER     // linked to StockTransfer
  MATERIAL_SALE      // linked to MaterialSale
  SUPPLIER_RETURN    // linked to SupplierReturn
  MANUAL             // standalone (non-linked, e.g. borrowed tools)
}

model GatePass {
  id              String           @id @default(cuid())
  gatePassNumber  String           @unique   // GP-YYMMDD-NNNN
  companyId       String
  projectId       String?
  locationId      String           // gate/location from which items exit

  // Workflow
  status          GatePassStatus   @default(DRAFT)
  category        GatePassCategory

  // Link to source transaction (nullable for MANUAL category)
  refType         String?          // "MaterialIssue" | "StockTransfer" | "MaterialSale" | "SupplierReturn"
  refId           String?

  // Approval workflow
  submittedById   String?
  submittedAt     DateTime?
  approvedById    String?
  approvedAt      DateTime?
  approvalNotes   String?
  rejectedById    String?
  rejectedAt      DateTime?
  rejectionReason String?

  // Exit details (filled by security at gate)
  exitedAt        DateTime?
  exitedById      String?
  exitNotes       String?
  exitPhotos      Json?            // array of { url, fileName? }

  // Vehicle / transport
  vehicleNumber   String?
  vehicleType     String?
  driverName      String?
  driverPhone     String?
  transporterName String?

  // Context
  destination     String?          // where items are going
  purpose         String?
  notes           String?

  // Creator
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  location        StockLocation    @relation(fields: [locationId], references: [id])
  submittedBy     User?            @relation("GatePassSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  approvedBy      User?            @relation("GatePassApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy      User?            @relation("GatePassRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  exitedBy        User?            @relation("GatePassExitedBy", fields: [exitedById], references: [id], onDelete: SetNull)
  createdBy       User?            @relation("GatePassCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines           GatePassLine[]

  @@index([companyId])
  @@index([projectId])
  @@index([locationId])
  @@index([status])
  @@index([category])
  @@index([refType, refId])
}

model GatePassLine {
  id              String   @id @default(cuid())
  gatePassId      String
  materialId      String?
  materialCode    String?  // snapshot for print
  materialName    String?  // snapshot for print
  unit            String?  // snapshot for print
  qty             Decimal  @db.Decimal(14, 3)
  description     String?  // for non-material items (tools, equipment)

  gatePass        GatePass @relation(fields: [gatePassId], references: [id], onDelete: Cascade)
  material        Material? @relation(fields: [materialId], references: [id])

  @@index([gatePassId])
  @@index([materialId])
}

// ───────────────────────────────────────────────────────────
//  LEGAL DOCUMENTS — permissions, licenses, NOCs, certificates,
//  agreements to sell. Attached to a land purchase OR a project
//  (or both when the document covers the land+project combo).
//
//  Indian construction requires a sequential chain of government
//  approvals, organized into three stages:
//
//  FEASIBILITY (land-level):
//    ownership → non-encumbrance → land sanction (CLU) → mutation
//    → agreement to sell (if registry deferred) → transfer duty
//
//  SANCTION (project-level, sequential):
//    layout approval → building permission (map approval)
//    → environmental clearance → pollution NOC (consent to establish)
//    → fire NOC → tree/airport/drainage/electricity NOCs
//    → commencement certificate
//
//  POST-COMPLETION:
//    plinth certificate → completion certificate
//    → occupancy/functional certificate
//
//  Each document has a validity period and an issuing authority.
//  Documents are uploaded as proof (PDF/images).
//
//  Agreement to Sell (ATS) is a legal substitute for registry —
//  used when the seller cannot registry immediately (e.g. land
//  is under government acquisition, conversion pending). The ATS
//  records the registration amount paid + future registry date.
//
//  The guided flow uses sortOrder + prerequisiteType to enforce
//  the sequence. The "obtained" boolean drives the yes/no branching:
//  if a prerequisite is not obtained, downstream chapters are hidden.
// ───────────────────────────────────────────────────────────

enum LegalDocType {
  // ── Feasibility stage (land-level) ──
  OWNERSHIP_CERTIFICATE    // Title deed / ownership proof from revenue dept
  NON_ENCUMBRANCE          // Non-encumbrance certificate from revenue dept
  LAND_SANCTION            // Land use conversion / CLU / sanction order
  MUTATION_ENTRY           // Mutation/integration of land records
  AGREEMENT_TO_SELL        // ATS — registry substitute (registration amount paid, registry deferred)
  TRANSFER_DUTY            // Transfer duty / unearned increase on authority land (DDA, HUDCO)
  // ── Sanction stage (project-level, sequential) ──
  BUDGET_APPROVAL          // Project budget approval — internal, must be prepared before applying for building permission
  LAYOUT_APPROVAL          // Layout plan / subdivision plan approval
  BUILDING_PERMISSION      // Map approval / building plan sanction (sanctioned plan)
  ENVIRONMENTAL_CLEARANCE  // Environmental clearance (large projects, EIA)
  POLLUTION_NOC_ESTABLISH  // Pollution board Consent to Establish (before construction)
  POLLUTION_NOC_OPERATE    // Pollution board Consent to Operate (after construction)
  FIRE_NOC                 // Fire department NOC
  TREE_CUTTING_NOC         // Tree cutting / forest department NOC
  AIRPORT_NOC              // Airport authority NOC (height restrictions near airports)
  DRAINAGE_NOC             // Drainage & sewerage NOC from municipal corp
  ELECTRICITY_NOC          // Electricity board NOC / connection sanction
  WATER_NOC                // Water supply NOC / connection sanction
  COMMENCEMENT_CERTIFICATE // Commencement certificate (allows construction to start)
  RERA_REGISTRATION        // RERA project registration — mandatory before marketing/selling units
  // ── Post-completion stage ──
  PLINTH_CERTIFICATE       // Plinth certificate (after foundation inspection)
  COMPLETION_CERTIFICATE   // Completion certificate (construction complete, conforms to plan)
  OCCUPANCY_CERTIFICATE    // Occupancy certificate (building fit for occupation)
  FUNCTIONAL_CERTIFICATE   // Functional certificate (utilities connected, operational)
  // ── Custom ──
  OTHER                    // Custom license/permission/NOC
}

enum LegalDocStatus {
  NOT_REQUIRED  // This permission is not applicable to this project/land
  PENDING       // Applied, awaiting approval
  APPROVED      // Approved/issued by authority
  REJECTED      // Rejected by authority
  EXPIRED       // Validity period has passed
  RENEWAL_DUE   // Approaching expiry (within 30 days)
}

// Which entity the document applies to — drives where it shows in the UI
enum LegalDocAppliesTo {
  LAND     // Shows on land detail page
  PROJECT  // Shows on project detail page
  BOTH     // Shows on both (e.g. environmental clearance for land+project combo)
}

model LegalDocument {
  id            String             @id @default(cuid())
  companyId     String
  landPurchaseId String?           // linked to a land purchase (optional)
  projectId     String?            // linked to a project (optional)
  type          LegalDocType
  title         String             // user-friendly label, e.g. "Map Approval — Tower A"
  authority     String?            // issuing authority, e.g. "DDA", "Fire Dept", "UPPCB"
  status        LegalDocStatus     @default(NOT_REQUIRED)
  appliesTo     LegalDocAppliesTo  @default(BOTH)
  docNumber     String?            // reference number on the certificate/NOC
  // ── Guided flow ordering ──
  // sortOrder defines the display sequence in the guided checklist.
  // prerequisiteType (optional) links this doc to a predecessor — if the
  // prerequisite is not APPROVED, this doc's chapter is collapsed/hidden.
  sortOrder     Int                @default(0)
  prerequisiteType LegalDocType?   // which doc type must be APPROVED before this one
  // ── Yes/No branching ──
  // "obtained" = the user has this permission (yes). If false, the
  // sub-form (authority, dates, upload) is hidden and downstream docs
  // that depend on this one are also hidden.
  obtained      Boolean            @default(false)
  // ── Validity ──
  applicationDate DateTime?        // when the application was submitted (before issueDate)
  issueDate     DateTime?          // when the authority issued it
  validFrom     DateTime?          // validity start (often = issueDate)
  validTill     DateTime?          // expiry date (null = permanent/no expiry)
  // ── Financials ──
  // For AGREEMENT_TO_SELL: the registration amount paid to seller.
  // For TRANSFER_DUTY: the transfer duty / unearned increase paid to authority.
  // For permits/NOCs: the fee paid to the authority.
  amount        Decimal?           @db.Decimal(14, 2)
  // ── For AGREEMENT_TO_SELL specifically ──
  // The expected future registry date (when the ATS converts to full registry).
  expectedRegistryDate DateTime?
  // ── Proof document ──
  documentUrl   String?            // uploaded file (PDF/image) — the actual certificate/NOC
  documentName  String?            // original filename for display
  // ── Notes ──
  notes         String?            // free-form notes, conditions, remarks
  // ── Audit ──
  createdById   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  landPurchase LandPurchase?  @relation("LegalDocsLand", fields: [landPurchaseId], references: [id], onDelete: Cascade)
  project      Project?       @relation("LegalDocsProject", fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User?          @relation("LegalDocCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  sourceProjectCosts ProjectCost[] @relation("LegalDocProjectCosts")

  @@index([companyId])
  @@index([landPurchaseId])
  @@index([projectId])
  @@index([type])
  @@index([status])
  @@index([appliesTo])
  @@index([sortOrder])
}


