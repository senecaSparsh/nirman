// Nirman Inventory OS — Prisma schema
// Construction + Real Estate inventory management.
// Two inventory universes: Materials (inputs) + Assets (outputs: land + built units).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────────────────
//  CORE: Company, Users, Auth, Projects
// ───────────────────────────────────────────────────────────

model Company {
  id        String   @id @default(cuid())
  name      String
  gstin     String?
  pan       String?
  address   String?
  currency  String   @default("INR")
  // Free-text business line, e.g. "Rice Milling & Export", "Real Estate" —
  // purely descriptive, shown in the company switcher to disambiguate.
  businessType String?
  // Self-relation so a user's companies can be organized into a group
  // hierarchy (e.g. "ABP Group" as parent, "Testify Overseas" +
  // "ABP Realty" as children) — matches the Admin -> Sub-admin whiteboard
  // structure at the company/entity level rather than the user-role level.
  parentCompanyId String?
  parent          Company?  @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id])
  children        Company[] @relation("CompanyHierarchy")
  // Logistics Complexity Index (LCI) — procurement routing config. See procurement-routing.ts.
  lciThresholdDefault Decimal? @db.Decimal(5, 2) // default LCI threshold for projects without an explicit override
  lciWeights          Json?    // { w1, w2, w3, w4 } normalized weighting coefficients
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  projects      Project[]
  stockLocations StockLocation[]
  purchaseOrders PurchaseOrder[]
  landPurchases  LandPurchase[]
  assetSales     AssetSale[]
  expenses       Expense[]
  equipment      Equipment[]
  supplierReturns SupplierReturn[]
  employees      Employee[]
  departments    Department[]
  userMemberships UserCompany[]
  users          User[]

  @@index([parentCompanyId])
}

// ───────────────────────────────────────────────────────────
//  MULTI-COMPANY MEMBERSHIP — a user can belong to one or more
//  companies, with a role scoped per membership. The User.role
//  column remains the default role (used when only one company
//  exists or as a fallback); UserCompany.role takes precedence
//  when the user is operating within that company's scope.
// ───────────────────────────────────────────────────────────
model UserCompany {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      String   @default("MANAGER") // OWNER | ADMIN | MANAGER | SUPERVISOR | SALES | ACCOUNTANT
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

// Fine-grained permission overrides per role (additive to the
// default role matrix in roles.ts). A row grants a permission
// to a role even if the matrix doesn't include it. Used for
// customizing roles without code changes.
model RolePermission {
  id          String @id @default(cuid())
  role        String // OWNER | ADMIN | MANAGER | SUPERVISOR | SALES | ACCOUNTANT
  permission  String // e.g. "po.approve", "inventory.view"
  createdAt   DateTime @default(now())

  @@unique([role, permission])
  @@index([role])
}

// ───────────────────────────────────────────────────────────
//  Employees / workers — assignable to playground task nodes.
//  Separate from the auth User model: tracks site labour and
//  subcontracted crews with their trade and daily rate.
// ───────────────────────────────────────────────────────────
model Employee {
  id        String   @id @default(cuid())
  name      String
  trade     String?  // e.g. "Masonry", "Electrical", "Plumbing", "Supervisor"
  phone     String?
  email     String?
  dailyRate Decimal  @db.Decimal(14,2) @default(0)
  active    Boolean  @default(true)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([deletedAt])
}

// User is shared with Better-Auth (prisma adapter). Required auth fields:
// id, email, name, emailVerified, image, createdAt, updatedAt.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("MANAGER") // OWNER | ADMIN | MANAGER | SUPERVISOR | SALES | ACCOUNTANT
  active        Boolean   @default(true)
  // Default company scope (nullable so a user can exist before being
  // assigned to a company; resolved into a UserCompany membership on
  // first login or via the settings UI). UserCompany.role takes
  // precedence over this default when operating within a company.
  companyId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company           Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  memberships       UserCompany[]
  sessions          Session[]
  accounts          Account[]
  stockMovements    StockMovement[]
  goodsReceipts     GoodsReceipt[]
  materialIssues    MaterialIssue[]
  auditLogs         AuditLog[]
  assignedTasks     Task[] @relation("TaskAssignee")
  assignedByTasks   Task[] @relation("TaskAssigner")
  completedSubTasks SubTask[]
  taskComments      TaskComment[]
  taskActivities    TaskActivity[]
  taskTimeLogs      TaskTimeLog[]
  createdWorkflows  Workflow[]
  // Approval / creator attribution for transactional records
  approvedPurchaseOrders PurchaseOrder[] @relation("POApprover")
  createdPurchaseOrders  PurchaseOrder[] @relation("POCreator")
  requestedRequisitions  MaterialRequisition[] @relation("ReqRequester")
  approvedRequisitions   MaterialRequisition[] @relation("ReqApprover")
  rejectedRequisitions   MaterialRequisition[] @relation("ReqRejecter")
  createdExpenses        Expense[]
  createdProjectCosts    ProjectCost[]
  createdAssetSales      AssetSale[]
  createdStockTransfers  StockTransfer[]
  createdSupplierReturns SupplierReturn[]
  createdLandPurchases   LandPurchase[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String    @id @default(cuid())
  accountId         String
  providerId        String
  userId            String
  accessToken       String?
  refreshToken      String?
  idToken           String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope             String?
  password          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  WAREHOUSE
  MALL
  LAND
  OTHER
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ON_HOLD
}

model Project {
  id          String        @id @default(cuid())
  companyId   String
  name        String
  type        ProjectType   @default(RESIDENTIAL)
  status      ProjectStatus @default(PLANNED)
  address     String?
  startDate   DateTime?
  endDate     DateTime?
  totalBudget Decimal?      @db.Decimal(14, 2)
  description String?
  // Cached computed fields — updated by valuationService
  costPerSqft      Decimal?  @db.Decimal(14, 2) // total project cost / total sellable area
  totalProjectCost Decimal?  @db.Decimal(14, 2) // materials + labour/overhead + allocated land
  totalSellableArea Decimal? @db.Decimal(14, 3) // sum of sellable unit areas
  lciThreshold       Decimal? @db.Decimal(5, 2)  // per-project LCI threshold override (null → company default)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  stockLocations StockLocation[]
  purchaseOrders PurchaseOrder[]
  materialIssues MaterialIssue[]
  materialRequisitions MaterialRequisition[]
  landPurchases  LandPurchase[]
  landParcels    LandParcel[]
  builtUnits     BuiltUnit[]
  assetSales     AssetSale[]
  projectCosts   ProjectCost[]
  expenses       Expense[]
  phases         ProjectPhase[]
  equipmentAssignments EquipmentAssignment[]

  @@index([companyId])
  @@index([status])
}

enum PhaseStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ON_HOLD
}

model ProjectPhase {
  id          String       @id @default(cuid())
  projectId   String
  name        String       // e.g. "Tower A", "Phase 1"
  status      PhaseStatus  @default(PLANNED)
  startDate   DateTime?
  endDate     DateTime?
  budget      Decimal?     @db.Decimal(14, 2)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stockLocations StockLocation[]
  builtUnits     BuiltUnit[]
  materialIssues MaterialIssue[]
  materialRequisitions MaterialRequisition[]

  @@index([projectId])
}

// ───────────────────────────────────────────────────────────
//  MATERIAL INVENTORY: locations, catalog, procurement, ledger
// ───────────────────────────────────────────────────────────

enum StockLocationType {
  COMPANY_WAREHOUSE
  PROJECT_SITE
  DEPARTMENT // operational cost-center stock room (e.g. Workshop, Boiler house)
}

model StockLocation {
  id        String            @id @default(cuid())
  type      StockLocationType
  companyId String
  projectId String?
  phaseId   String?
  departmentId String?        @unique // set when type = DEPARTMENT (1:1 — a department has at most one stock room)
  name      String
  address   String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?

  company        Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project        Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase          ProjectPhase?     @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  department     Department?       @relation("DepartmentLocation", fields: [departmentId], references: [id], onDelete: SetNull)
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  stockMovementsFrom StockMovement[] @relation("MovementFrom")
  stockMovementsTo   StockMovement[] @relation("MovementTo")
  materialIssues MaterialIssue[]
  stockTransfersFrom StockTransfer[] @relation("TransferFrom")
  stockTransfersTo   StockTransfer[] @relation("TransferTo")
  stockCounts    StockCount[]
  stockItems     StockLocationItem[]
  equipmentAssignments EquipmentAssignment[]
  supplierReturns SupplierReturn[]

  @@index([companyId])
  @@index([projectId])
  @@index([phaseId])
  @@index([departmentId])
}

enum MaterialClass {
  RAW_MATERIAL     // cement, steel, brick, timber
  CONSUMABLE       // fasteners, sealants, paint, safety gear
  MRO              // lubricants, repair parts, maintenance supplies
  TEMPORARY        // scaffolding, fencing, formwork, tarps
}

model MaterialCategory {
  id        String        @id @default(cuid())
  name      String        @unique
  unit      String        @default("NOS")
  class     MaterialClass @default(RAW_MATERIAL)
  createdAt DateTime      @default(now())
  deletedAt DateTime?

  materials Material[]
}

model Material {
  id               String   @id @default(cuid())
  code             String   @unique
  barcode          String?  @unique
  qrCode           String?  @unique
  name             String
  categoryId       String
  unit             String   @default("NOS")
  hsnCode          String?
  gstRate          Decimal  @default(0) @db.Decimal(5, 2)
  standardCost     Decimal  @default(0) @db.Decimal(14, 2)
  currentCost      Decimal  @default(0) @db.Decimal(14, 2) // global fallback; per-location MAC lives in StockLocationItem
  minStock         Decimal? @db.Decimal(14, 3)
  reorderPoint     Decimal? @db.Decimal(14, 3) // trigger to reorder
  economicOrderQty Decimal? @db.Decimal(14, 3) // EOQ — optimal order quantity
  // LCI inputs — see procurement-routing.ts. Used by the Logistics Decision Engine
  // to auto-route requisitions between Central (COMPANY) and Direct (PROJECT) procurement.
  volumetricDensity  Decimal? @db.Decimal(10, 3) // V/W ratio — higher = bulkier / harder to transport
  bulkDiscountPct    Decimal? @db.Decimal(5, 2)  // enterprise volume discount % via centralised bulk buying
  isCorporateCommodity Boolean @default(false)   // force central procurement routing
  description      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  category          MaterialCategory   @relation(fields: [categoryId], references: [id])
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceiptLines  GoodsReceiptLine[]
  stockMovements    StockMovement[]
  materialIssueLines MaterialIssueLine[]
  stockTransferLines StockTransferLine[]
  stockCountLines   StockCountLine[]
  stockItems        StockLocationItem[]
  requisitionLines  MaterialRequisitionLine[]
  supplierReturnLines SupplierReturnLine[]

  @@index([categoryId])
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  gstin       String?
  phone       String?
  email       String?
  address     String?
  balanceOwed Decimal  @default(0) @db.Decimal(14, 2)
  leadTimeDays Int?    // average vendor lead time in days — LCI input (S_lead)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  purchaseOrders PurchaseOrder[]
  supplierReturns SupplierReturn[]
}

model Subcontractor {
  id          String   @id @default(cuid())
  name        String
  gstin       String?
  phone       String?
  email       String?
  address     String?
  trade       String?  // e.g. "Plumbing", "Electrical", "Masonry"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  materialIssues MaterialIssue[]
  projectCosts   ProjectCost[]
}

// ───────────────────────────────────────────────────────────
//  DEPARTMENT / COST CENTER — operational consumption target
//  for raw materials (manufacturing/processing lines, workshop,
//  lab, admin). Distinct from a Project: a department is an
//  ongoing cost center, not a capitalised build. Materials
//  issued to a department hit Operating Expenses (not WIP).
//  Modeled on the Testify Overseas paper trail (Boiler, Dryer,
//  MP-1/2/3, R.O. Plant, Workshop, etc.).
// ───────────────────────────────────────────────────────────
model Department {
  id          String   @id @default(cuid())
  companyId   String
  code        String   // short stable code, e.g. "BOILER", "MP-2"
  name        String   // display name, e.g. "Boiler House"
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stockLocation StockLocation? @relation("DepartmentLocation") // optional own stock room
  materialIssues MaterialIssue[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([deletedAt])
}

enum ProcurementScope {
  COMPANY
  PROJECT
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id                    String              @id @default(cuid())
  poNumber              String              @unique
  supplierId            String
  procurementScope      ProcurementScope
  companyId             String
  projectId             String?
  destinationLocationId String
  status                PurchaseOrderStatus @default(DRAFT)
  orderDate             DateTime            @default(now())
  expectedDate          DateTime?
  subtotal              Decimal             @default(0) @db.Decimal(14, 2)
  gstTotal              Decimal             @default(0) @db.Decimal(14, 2)
  total                 Decimal             @default(0) @db.Decimal(14, 2)
  notes                 String?
  // Approval workflow — DRAFT → APPROVED requires a user with po.approve
  createdById           String?
  approvedById          String?
  approvedAt            DateTime?
  approvalNotes         String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  supplier            Supplier             @relation(fields: [supplierId], references: [id])
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project             Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  destinationLocation StockLocation        @relation(fields: [destinationLocationId], references: [id])
  createdBy           User?                @relation("POCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy          User?                @relation("POApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  lines               PurchaseOrderLine[]
  goodsReceipts       GoodsReceipt[]

  @@index([companyId])
  @@index([projectId])
  @@index([supplierId])
  @@index([status])
  @@index([approvedById])
}

model PurchaseOrderLine {
  id             String   @id @default(cuid())
  purchaseOrderId String
  materialId     String
  qtyOrdered     Decimal  @db.Decimal(14, 3)
  qtyReceived    Decimal  @default(0) @db.Decimal(14, 3)
  unitCost       Decimal  @db.Decimal(14, 2)
  gstRate        Decimal  @default(0) @db.Decimal(5, 2)
  lineTotal      Decimal  @default(0) @db.Decimal(14, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  material      Material      @relation(fields: [materialId], references: [id])
  goodsReceiptLines GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@index([materialId])
}

enum InspectionStatus {
  PENDING
  PASSED
  FAILED
  REJECTED
}

model GoodsReceipt {
  id             String   @id @default(cuid())
  purchaseOrderId String
  locationId     String
  receiptDate    DateTime @default(now())
  receivedById   String?
  notes          String?
  createdAt      DateTime @default(now())
  // Quality inspection
  inspectionStatus InspectionStatus @default(PENDING)
  inspectionNotes  String?
  inspectedById    String?
  inspectedAt      DateTime?

  purchaseOrder PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  location      StockLocation       @relation(fields: [locationId], references: [id])
  receivedBy    User?               @relation(fields: [receivedById], references: [id])
  lines         GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@index([locationId])
}

model GoodsReceiptLine {
  id                String  @id @default(cuid())
  goodsReceiptId    String
  purchaseOrderLineId String
  materialId        String
  qtyReceived       Decimal @db.Decimal(14, 3)
  unitCost          Decimal @db.Decimal(14, 2)

  goodsReceipt     GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
  material         Material          @relation(fields: [materialId], references: [id])

  @@index([goodsReceiptId])
  @@index([materialId])
}

enum StockMovementType {
  PURCHASE_RECEIPT
  TRANSFER_IN
  TRANSFER_OUT
  ISSUE_TO_PROJECT
  ISSUE_TO_DEPARTMENT // raw-material consumption by an operational cost center
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN
  SALE
}

model StockMovement {
  id             String            @id @default(cuid())
  materialId     String
  movementType   StockMovementType
  fromLocationId String?
  toLocationId   String?
  qty            Decimal           @db.Decimal(14, 3)
  unitCost       Decimal           @db.Decimal(14, 2) // MAC at time of movement (for issues) or receipt unit cost
  balanceAfter   Decimal           @db.Decimal(14, 3) // qty remaining at the affected location after this movement
  balanceValueAfter Decimal        @default(0) @db.Decimal(14, 2) // qty × MAC after this movement (cost audit trail)
  reason         String?
  refType        String?
  refId          String?
  userId         String?
  timestamp      DateTime          @default(now())
  // GPS capture for field verification
  latitude       Float?
  longitude      Float?

  material      Material       @relation(fields: [materialId], references: [id])
  fromLocation  StockLocation? @relation("MovementFrom", fields: [fromLocationId], references: [id])
  toLocation    StockLocation? @relation("MovementTo", fields: [toLocationId], references: [id])
  user          User?          @relation(fields: [userId], references: [id])

  @@index([materialId, timestamp])
  @@index([toLocationId])
  @@index([fromLocationId])
  @@index([refType, refId])
}

// Current-state cache per material per location — updated atomically with each StockMovement.
// StockMovement is the immutable ledger; StockLocationItem is the derived "what's here now + at what MAC".
model StockLocationItem {
  id             String   @id @default(cuid())
  locationId     String
  materialId     String
  qty            Decimal  @default(0) @db.Decimal(14, 3)
  movingAvgCost  Decimal  @default(0) @db.Decimal(14, 2) // Moving Average Cost (MAC) at this location
  updatedAt      DateTime @updatedAt

  location StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  material Material      @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([locationId, materialId])
  @@index([materialId])
}

model MaterialIssue {
  id             String   @id @default(cuid())
  // Consumption target — exactly one of projectId / departmentId is set
  // (enforced in the service layer + Zod). Project issues capitalise into
  // WIP; department issues hit Operating Expenses.
  projectId      String?
  departmentId   String?
  phaseId        String?
  fromLocationId String
  subcontractorId String?
  issueDate      DateTime @default(now())
  issuedById     String?
  notes          String?
  totalCost      Decimal  @default(0) @db.Decimal(14, 2)
  createdAt      DateTime @default(now())

  project       Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  department    Department?        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  phase         ProjectPhase?      @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  fromLocation  StockLocation      @relation(fields: [fromLocationId], references: [id])
  subcontractor Subcontractor?     @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)
  issuedBy      User?              @relation(fields: [issuedById], references: [id])
  lines         MaterialIssueLine[]

  @@index([projectId])
  @@index([departmentId])
  @@index([fromLocationId])
  @@index([phaseId])
}

model MaterialIssueLine {
  id              String  @id @default(cuid())
  materialIssueId String
  materialId      String
  qty             Decimal @db.Decimal(14, 3)
  unitCost        Decimal @db.Decimal(14, 2)

  materialIssue MaterialIssue @relation(fields: [materialIssueId], references: [id], onDelete: Cascade)
  material      Material      @relation(fields: [materialId], references: [id])

  @@index([materialIssueId])
  @@index([materialId])
}

enum StockTransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model StockTransfer {
  id             String              @id @default(cuid())
  fromLocationId String
  toLocationId   String
  transferDate   DateTime            @default(now())
  status         StockTransferStatus @default(DRAFT)
  notes          String?
  createdById    String?
  // Inter-company Stock Transfer Order (STO) fields. When from/to locations belong
  // to different companies (SPVs), isInterCompany=true and the destination receives
  // at a Transfer Price (TP) = source MAC + freight + handling + markup%, not at the
  // bare source MAC. This carries the inter-company markup into the destination's MAC.
  // Full inter-company AP/AR + consolidation elimination is a future GL concern; the
  // TP is captured here as the prerequisite. See transfer.ts · computeTransferPrice.
  isInterCompany     Boolean  @default(false)
  freight            Decimal  @default(0) @db.Decimal(14, 2) // header freight, allocated by line cost weight
  handlingFee        Decimal  @default(0) @db.Decimal(14, 2) // header handling, allocated by line cost weight
  markupPct          Decimal  @default(0) @db.Decimal(5, 2)   // inter-company markup % applied to each line base cost
  transferPriceTotal Decimal? @db.Decimal(14, 2)             // Σ line transfer totals — set on completion
  createdAt      DateTime            @default(now())

  fromLocation StockLocation         @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation   StockLocation         @relation("TransferTo", fields: [toLocationId], references: [id])
  createdBy   User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines        StockTransferLine[]

  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([createdById])
  @@index([isInterCompany])
}

model StockTransferLine {
  id              String  @id @default(cuid())
  stockTransferId String
  materialId      String
  qty             Decimal @db.Decimal(14, 3)
  // Captured at completion (inter-company only). unitCostAtSource = source MAC at
  // the moment of issue; unitTransferPrice = (base + freight + handling + markup)/qty;
  // lineTransferTotal = qty × unitTransferPrice. Null for intra-company transfers
  // (those carry the bare source MAC to the destination, no markup).
  unitCostAtSource   Decimal? @db.Decimal(14, 2)
  unitTransferPrice  Decimal? @db.Decimal(14, 2)
  lineTransferTotal  Decimal? @db.Decimal(14, 2)

  stockTransfer StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  material      Material      @relation(fields: [materialId], references: [id])

  @@index([stockTransferId])
  @@index([materialId])
}

enum StockCountStatus {
  DRAFT
  COUNTED
  RECONCILED
}

model StockCount {
  id          String           @id @default(cuid())
  locationId  String
  countDate   DateTime         @default(now())
  status      StockCountStatus @default(DRAFT)
  notes       String?
  createdAt   DateTime         @default(now())

  location StockLocation      @relation(fields: [locationId], references: [id])
  lines   StockCountLine[]

  @@index([locationId])
}

model StockCountLine {
  id           String  @id @default(cuid())
  stockCountId String
  materialId   String
  countedQty   Decimal @db.Decimal(14, 3)
  systemQty    Decimal @db.Decimal(14, 3)
  variance     Decimal @db.Decimal(14, 3)

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  material   Material   @relation(fields: [materialId], references: [id])

  @@index([stockCountId])
  @@index([materialId])
}

// ───────────────────────────────────────────────────────────
//  ASSET INVENTORY: Land (with partitioning) + Built Units
// ───────────────────────────────────────────────────────────

enum AreaUnit {
  SQFT
  SQM
  ACRE
  BIGHA
  HECTARE
}

model LandPurchase {
  id           String   @id @default(cuid())
  companyId    String
  projectId    String?
  sellerName   String
  sellerContact String?
  purchaseDate DateTime @default(now())
  totalArea    Decimal  @db.Decimal(14, 3)
  areaUnit     AreaUnit @default(SQFT)
  totalCost    Decimal  @db.Decimal(14, 2)
  registryNo   String?
  location     String?
  documentUrl  String?
  createdById  String?
  createdAt    DateTime @default(now())
  deletedAt    DateTime?

  company Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  parcels LandParcel[]

  @@index([companyId])
  @@index([projectId])
  @@index([createdById])
}

enum LandParcelStatus {
  AVAILABLE
  HOLD
  PARTITIONED
  SOLD
}

model LandParcel {
  id              String           @id @default(cuid())
  landPurchaseId  String
  parentParcelId  String?
  number          String
  area            Decimal          @db.Decimal(14, 3)
  areaUnit        AreaUnit         @default(SQFT)
  status          LandParcelStatus @default(AVAILABLE)
  acquisitionCost Decimal          @default(0) @db.Decimal(14, 2)
  askingPrice     Decimal?         @db.Decimal(14, 2)
  currentValuation Decimal         @default(0) @db.Decimal(14, 2)
  nrvWriteDown     Decimal         @default(0) @db.Decimal(14, 2) // NRV < cost → write-down amount
  saleId          String?
  projectId       String?
  /// Polygon vertices in normalized [0,1] coordinates relative to the parcel's
  /// bounding box. Stored as [{x,y},...]. null for parcels created without the
  /// CAD canvas (form-based partition). Used by the partition canvas to render
  /// and further subdivide existing parcels.
  geometry        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  landPurchase LandPurchase  @relation(fields: [landPurchaseId], references: [id], onDelete: Cascade)
  parentParcel LandParcel?   @relation("ParcelChildren", fields: [parentParcelId], references: [id])
  children     LandParcel[]  @relation("ParcelChildren")
  partitions    LandPartition[]
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([landPurchaseId])
  @@index([parentParcelId])
  @@index([status])
  @@unique([landPurchaseId, number])
}

model LandPartition {
  id              String   @id @default(cuid())
  parentParcelId  String
  partitionDate   DateTime @default(now())
  childCount      Int
  notes           String?

  parentParcel LandParcel @relation(fields: [parentParcelId], references: [id], onDelete: Cascade)

  @@index([parentParcelId])
}

enum BuiltUnitType {
  BHK_1
  BHK_2
  BHK_3
  BHK_4
  SHOP
  OFFICE
  WAREHOUSE_UNIT
  OTHER
}

enum BuiltUnitStatus {
  PLANNED
  UNDER_CONSTRUCTION
  AVAILABLE
  HOLD
  SOLD
}

model BuiltUnit {
  id              String           @id @default(cuid())
  projectId       String
  phaseId         String?
  unitType        BuiltUnitType
  unitNumber      String
  floor           Int?
  wing            String?
  area            Decimal          @db.Decimal(14, 3)
  areaUnit        AreaUnit         @default(SQFT)
  status          BuiltUnitStatus  @default(PLANNED)
  productionCost  Decimal          @default(0) @db.Decimal(14, 2)
  askingPrice     Decimal?         @db.Decimal(14, 2)
  currentValuation Decimal         @default(0) @db.Decimal(14, 2)
  nrvWriteDown    Decimal          @default(0) @db.Decimal(14, 2) // NRV < cost → write-down amount
  saleId          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase   ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([phaseId])
  @@index([status])
  @@index([unitType])
  @@unique([projectId, unitNumber])
}

// ───────────────────────────────────────────────────────────
//  EQUIPMENT & TOOLS: discrete, trackable, transferable assets
//  (NOT fungible like materials — an excavator is unique, not a quantity)
// ───────────────────────────────────────────────────────────

enum EquipmentStatus {
  AVAILABLE     // in warehouse, not assigned
  ASSIGNED      // at a project site
  IN_MAINTENANCE
  RETIRED
}

model Equipment {
  id              String          @id @default(cuid())
  assetTag        String          @unique // physical tag/QR on the equipment
  name            String
  model           String?
  serialNumber    String?
  category        String?         // e.g. "Heavy Machinery", "Power Tool", "Vehicle"
  companyId       String
  status          EquipmentStatus @default(AVAILABLE)
  acquisitionCost Decimal         @default(0) @db.Decimal(14, 2)
  currentValue    Decimal         @default(0) @db.Decimal(14, 2) // after depreciation
  purchaseDate    DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assignments EquipmentAssignment[]
  maintenance EquipmentMaintenance[]

  @@index([companyId])
  @@index([status])
}

enum EquipmentAssignmentStatus {
  ACTIVE
  RETURNED
}

model EquipmentAssignment {
  id          String                  @id @default(cuid())
  equipmentId String
  locationId  String                  // where it's currently stationed
  projectId   String?
  assignedAt  DateTime                @default(now())
  returnedAt  DateTime?
  status      EquipmentAssignmentStatus @default(ACTIVE)
  notes       String?

  equipment Equipment     @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  location  StockLocation @relation(fields: [locationId], references: [id])
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([equipmentId])
  @@index([locationId])
  @@index([projectId])
}

enum MaintenanceType {
  SCHEDULED
  REPAIR
  INSPECTION
}

model EquipmentMaintenance {
  id          String         @id @default(cuid())
  equipmentId String
  type        MaintenanceType
  startDate   DateTime       @default(now())
  endDate     DateTime?
  cost        Decimal        @default(0) @db.Decimal(14, 2)
  vendor      String?
  notes       String?
  createdAt   DateTime       @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
}

// ───────────────────────────────────────────────────────────
//  MATERIAL REQUISITION: request → approve → convert to PO
//  (planning layer before procurement)
// ───────────────────────────────────────────────────────────

enum RequisitionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  CONVERTED  // turned into a PurchaseOrder
  REJECTED
}

model MaterialRequisition {
  id          String           @id @default(cuid())
  reqNumber   String           @unique
  projectId   String
  phaseId     String?
  requestedById String?
  status      RequisitionStatus @default(DRAFT)
  requestDate DateTime         @default(now())
  neededByDate DateTime?
  notes       String?
  convertedPoId String?        // set when converted to a PO
  // Logistics Decision Engine output — computed on submit, used to recommend
  // procurementScope (COMPANY vs PROJECT) at PO conversion. See procurement-routing.ts.
  lciDecision  Json?           // { perLine, recommendedScope, threshold, weights, computedAt, ... }
  // Approval workflow — SUBMITTED → APPROVED requires requisition.approve
  approvedById String?
  approvedAt   DateTime?
  approvalNotes String?
  rejectedById  String?
  rejectedAt    DateTime?
  rejectReason  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase       ProjectPhase?    @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  requestedBy User?            @relation("ReqRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy  User?            @relation("ReqApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy  User?            @relation("ReqRejecter", fields: [rejectedById], references: [id], onDelete: SetNull)
  lines       MaterialRequisitionLine[]

  @@index([projectId])
  @@index([status])
  @@index([approvedById])
}

model MaterialRequisitionLine {
  id              String  @id @default(cuid())
  requisitionId   String
  materialId      String
  qtyRequested    Decimal @db.Decimal(14, 3)
  notes           String?

  requisition MaterialRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  material    Material            @relation(fields: [materialId], references: [id])

  @@index([requisitionId])
  @@index([materialId])
}

// ───────────────────────────────────────────────────────────
//  RETURNS TO SUPPLIER: defective/excess materials sent back
// ───────────────────────────────────────────────────────────

enum SupplierReturnStatus {
  DRAFT
  SUBMITTED
  COMPLETED  // goods left, credit note received
  CANCELLED
}

model SupplierReturn {
  id           String              @id @default(cuid())
  returnNumber String              @unique
  supplierId   String
  companyId    String
  purchaseOrderId String?          // original PO (if return against a PO)
  locationId   String              // where goods are leaving from
  status       SupplierReturnStatus @default(DRAFT)
  returnDate   DateTime            @default(now())
  creditNoteNo String?
  notes        String?
  createdById  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  location      StockLocation @relation(fields: [locationId], references: [id])
  createdBy     User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines         SupplierReturnLine[]

  @@index([supplierId])
  @@index([companyId])
  @@index([status])
  @@index([createdById])
}

model SupplierReturnLine {
  id               String  @id @default(cuid())
  supplierReturnId String
  materialId       String
  qty              Decimal @db.Decimal(14, 3)
  unitCost         Decimal @db.Decimal(14, 2) // cost at which it was received (for credit calc)
  reason           String? // "Defective", "Excess", "Wrong item"

  supplierReturn SupplierReturn @relation(fields: [supplierReturnId], references: [id], onDelete: Cascade)
  material       Material       @relation(fields: [materialId], references: [id])

  @@index([supplierReturnId])
  @@index([materialId])
}

// ───────────────────────────────────────────────────────────
//  SALES: customers, asset sales, payments
// ───────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?  @unique
  email     String?
  gstin     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  assetSales AssetSale[]
}

enum AssetType {
  LAND
  BUILT_UNIT
}

enum SaleStatus {
  ACTIVE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

model AssetSale {
  id            String        @id @default(cuid())
  saleNumber    String        @unique
  assetType     AssetType
  landParcelId  String?
  builtUnitId   String?
  customerId    String
  projectId     String
  companyId     String
  salePrice     Decimal       @db.Decimal(14, 2)
  costBasis     Decimal       @default(0) @db.Decimal(14, 2) // acquisitionCost (land) or productionCost (unit) at time of sale
  profit        Decimal       @default(0) @db.Decimal(14, 2) // salePrice - costBasis
  saleDate      DateTime      @default(now())
  status        SaleStatus    @default(ACTIVE)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMode   String?
  notes         String?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer  Customer            @relation(fields: [customerId], references: [id])
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  company   Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  payments  AssetSalePayment[]

  @@index([projectId])
  @@index([companyId])
  @@index([customerId])
  @@index([paymentStatus])
  @@index([createdById])
}

model AssetSalePayment {
  id          String   @id @default(cuid())
  assetSaleId String
  amount      Decimal  @db.Decimal(14, 2)
  paymentDate DateTime @default(now())
  mode        String
  reference   String?
  status      String   @default("RECEIVED")

  assetSale AssetSale @relation(fields: [assetSaleId], references: [id], onDelete: Cascade)

  @@index([assetSaleId])
}

// ───────────────────────────────────────────────────────────
//  FINANCE: project costs, expenses, audit
// ───────────────────────────────────────────────────────────

enum ProjectCostType {
  LABOUR
  OVERHEAD
  EQUIPMENT
  CONTRACTOR
  PERMIT
  OTHER
}

model ProjectCost {
  id        String          @id @default(cuid())
  projectId String
  costType  ProjectCostType
  amount    Decimal         @db.Decimal(14, 2)
  date      DateTime        @default(now())
  vendor    String?
  subcontractorId String?
  notes     String?
  receiptUrl String?
  createdById String?
  createdAt DateTime        @default(now())

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subcontractor Subcontractor? @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([costType])
  @@index([createdById])
}

model Expense {
  id        String   @id @default(cuid())
  companyId String
  projectId String?
  category  String
  amount    Decimal  @db.Decimal(14, 2)
  date      DateTime @default(now())
  notes     String?
  createdById String?
  createdAt DateTime @default(now())

  company Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([projectId])
  @@index([createdById])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  timestamp  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
}

// ───────────────────────────────────────────────────────────
//  GENERAL LEDGER — double-entry bookkeeping + GST posting.
//
//  Every financial mutation (PO receipt, material issue, asset sale,
//  payment, project cost, expense, supplier return) posts a balanced
//  JournalEntry with two or more JournalLines. The chart of accounts
//  (Account) is seeded with a default construction-industry set.
//
//  This is the accounting layer behind the costing: the stock ledger
//  tracks quantities + MAC; the GL tracks the money. Together they let
//  an accountant close the books and produce a trial balance.
// ───────────────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model GlAccount {
  code        String       @id
  name        String
  type        AccountType
  isSystem    Boolean       @default(true) // system accounts can't be deleted
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  journalLines JournalLine[]

  @@index([type])
}

enum JournalEntryStatus {
  POSTED
  REVERSED
}

model JournalEntry {
  id          String             @id @default(cuid())
  entryNumber String             @unique
  entryDate    DateTime          @default(now())
  sourceType   String             // PO_RECEIPT | MATERIAL_ISSUE | ASSET_SALE | PAYMENT_RECEIVED | PROJECT_COST | EXPENSE | SUPPLIER_RETURN | LAND_PURCHASE | OPENING
  sourceId     String?
  memo        String?
  companyId   String
  postedById  String?
  status      JournalEntryStatus @default(POSTED)
  totalDebit  Decimal            @default(0) @db.Decimal(14, 2)
  totalCredit Decimal            @default(0) @db.Decimal(14, 2)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  lines JournalLine[]

  @@index([companyId])
  @@index([sourceType, sourceId])
  @@index([entryDate])
}

model JournalLine {
  id             String   @id @default(cuid())
  journalEntryId String
  accountCode    String
  debit          Decimal  @default(0) @db.Decimal(14, 2)
  credit         Decimal  @default(0) @db.Decimal(14, 2)
  // Optional analytic dimensions — which material / project / party this line concerns
  entityType     String?
  entityId       String?
  memo           String?

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      GlAccount     @relation(fields: [accountCode], references: [code])

  @@index([journalEntryId])
  @@index([accountCode])
  @@index([entityType, entityId])
}

// ───────────────────────────────────────────────────────────
//  CUSTOM WORKSPACES: visual playground graphs that the user
//  composes by dragging modules onto a canvas and connecting
//  them. Each saved workspace becomes a nav tab that renders a
//  live drill-down hierarchy following the saved graph.
// ───────────────────────────────────────────────────────────

model CustomWorkspace {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String   @default("LayoutDashboard") // lucide icon name
  rootModel   String   // ModelKey of the root node
  graphJson   Json     // WorkspaceGraph: { nodes, edges, rootId }
  companyId   String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  tasks Task[]

  @@index([deletedAt])
  @@index([companyId])
}

// ───────────────────────────────────────────────────────────
//  TASKS — assigned by admin/manager to signed-in users.
//  The admin creates a task (optionally from a playground node),
//  adds instructions/guidance, and the assignee sees it on their
//  dashboard with everything they need to do.
// ───────────────────────────────────────────────────────────

model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?
  instructions String?   // step-by-step guidance from the admin
  status       String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | CANCELLED
  priority     String    @default("medium")  // low | medium | high | urgent
  dueDate      DateTime?
  assignedToId String
  assignedById String?
  workspaceId  String?
  nodeLabel    String?   // label of the canvas node this task came from (if any)
  estimateMins Int?      // planned effort in minutes (optional)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedTo User             @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)
  assignedBy User?            @relation("TaskAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  workspace  CustomWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  subtasks      SubTask[]
  comments      TaskComment[]
  activities    TaskActivity[]
  timeLogs      TaskTimeLog[]
  // Dependencies: this task is blocked by `blocking` tasks, and blocks `blockedBy` tasks.
  blocking      TaskDependency[] @relation("BlockedTask")
  blockedBy     TaskDependency[] @relation("BlockingTask")

  @@index([assignedToId])
  @@index([assignedById])
  @@index([status])
  @@index([workspaceId])
}

// Checkable steps within a task. Completion drives the task's progress %
// (completed subtasks / total subtasks). Ordered by `order`.
model SubTask {
  id          String   @id @default(cuid())
  taskId      String
  title       String
  completed   Boolean  @default(false)
  order       Int      @default(0)
  completedAt DateTime?
  completedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completedBy User?    @relation(fields: [completedById], references: [id], onDelete: SetNull)

  @@index([taskId])
}

// Threaded discussion on a task. `parentId` enables replies (one level deep).
model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  body      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent TaskComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies TaskComment[] @relation("CommentReplies")

  @@index([taskId])
  @@index([userId])
  @@index([parentId])
}

// Immutable, human-readable activity feed for a task. Written inside the same
// transaction as the mutation that triggered it, so the feed never diverges
// from reality. Distinct from AuditLog (which is the system-wide audit trail);
// this is the per-task timeline shown in the detail drawer.
model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  userId    String?
  kind      String   // CREATED | STATUS_CHANGED | ASSIGNED | PRIORITY_CHANGED | DUE_DATE_CHANGED | SUBTASK_ADDED | SUBTASK_TOGGLED | SUBTASK_DELETED | COMMENTED | DEPENDENCY_ADDED | DEPENDENCY_REMOVED | TIMER_STARTED | TIMER_STOPED | COMPLETED | REOPENED
  message   String   // pre-rendered human-readable summary
  meta      Json?
  createdAt DateTime @default(now())

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([createdAt])
}

// A → B means "A blocks B" (B cannot start until A is completed).
// `blockerId` = A, `blockedById` = B. Enforced in the service layer.
model TaskDependency {
  id          String @id @default(cuid())
  blockerId   String
  blockedById String
  createdAt   DateTime @default(now())

  blocker  Task @relation("BlockingTask", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedBy Task @relation("BlockedTask", fields: [blockedById], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedById])
  @@index([blockerId])
  @@index([blockedById])
}

// Time tracking entries. An open timer = endedAt null. Stopping sets endedAt
// and durationMins. Multiple entries per task are allowed.
model TaskTimeLog {
  id           String    @id @default(cuid())
  taskId       String
  userId       String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  durationMins Int?
  note         String?
  createdAt    DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@index([endedAt])
}

// ───────────────────────────────────────────────────────────
//  WORKFLOWS — automated chains of events built on the canvas.
//  The admin composes a sequence of action steps (create record,
//  send notification, wait, assign task, etc.), connects them
//  into a flow, and optionally schedules recurring execution.
// ───────────────────────────────────────────────────────────

model Workflow {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String   @default("Workflow")
  status      String   @default("DRAFT") // DRAFT | ACTIVE | PAUSED | ARCHIVED
  graphJson   Json     // WorkflowGraph: { steps, edges, schedule }
  companyId   String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  runs      WorkflowRun[]
  schedules ScheduledWorkflow[]
  creator   User?       @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([deletedAt])
  @@index([companyId])
  @@index([status])
}

model WorkflowRun {
  id          String    @id @default(cuid())
  workflowId  String
  status      String    @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED | CANCELLED
  startedAt   DateTime?
  completedAt DateTime?
  currentStep Int       @default(0)
  result      Json?
  error       String?
  triggeredBy String?   // "manual" | "schedule"
  createdAt   DateTime  @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([status])
}

model ScheduledWorkflow {
  id         String    @id @default(cuid())
  workflowId String
  cron       String?   // cron expression (e.g. "0 9 * * 1" = every Monday 9am)
  intervalM  Int?      // interval in minutes (alternative to cron)
  nextRunAt  DateTime
  enabled    Boolean   @default(true)
  lastRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([nextRunAt])
  @@index([enabled])
}
